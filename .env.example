NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://mediflow-pi.vercel.app

# IA — análisis de radiografías con Claude Vision
ANTHROPIC_API_KEY=

# Dictado por voz (Whisper) — transcripción audio→texto en consulta y AI assistant
OPENAI_API_KEY=

# Stripe — pagos y suscripciones
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago — anticipo por WhatsApp (conecta la cuenta de CADA clínica por
# OAuth). Credenciales de la aplicación de DaleControl en
# mercadopago.com.mx/developers → Tus integraciones. La Redirect URL que se
# registra allí es <NEXT_PUBLIC_APP_URL>/api/mercadopago/oauth/callback.
# Sin CLIENT_ID + CLIENT_SECRET + DATA_ENCRYPTION_KEY la función está apagada.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Opcional: firma x-signature del webhook (/api/webhooks/mercadopago).
MERCADOPAGO_WEBHOOK_SECRET=
# Solo pruebas: "1" pide tokens de prueba al conectar. En producción, vacío.
MERCADOPAGO_OAUTH_TEST_TOKEN=

# Daily.co — teleconsulta
DAILY_API_KEY=

# Facturapi — CFDI 4.0
# User Key de la cuenta madre (sk_user_...): crea/configura las organizaciones y
# obtiene las API keys de cada clínica. Es la única credencial de Facturapi.
FACTURAPI_USER_KEY=
# Ambiente de timbrado: "live" = CFDI ante el SAT con validez fiscal.
# Vacío o "test" = pruebas (Facturapi usa sus certificados, no llega al SAT).
FACTURAPI_ENV=test
# Cifrado en reposo de secretos por clínica (incluye la Live Secret Key de
# Facturapi). Hex de 32 bytes (64 caracteres). Sin esto se guardan en claro.
DATA_ENCRYPTION_KEY=

# WhatsApp Business Cloud API
WHATSAPP_APP_SECRET=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_STATE_SECRET=

# Cron jobs (Vercel Cron Authorization header)
CRON_SECRET=

# Admin panel (single super-admin auth)
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
ADMIN_SECRET_TOKEN=

# Cookie signing (firma HMAC del activeClinicId)
COOKIE_SECRET=

# Email (Resend)
RESEND_API_KEY=

# Dev-only
ALLOW_SEED_IN_PROD=

# AI Wallet — recargas por transferencia SPEI (datos de tu cuenta receptora)
SPEI_BENEFICIARY_NAME=
SPEI_BANK=
SPEI_CLABE=
SPEI_REFERENCE=
SPEI_INSTRUCTIONS=

# Analytics del owner: geolocalización precisa por IP (ipinfo.io). Opcional —
# sin token cae a la geo de Vercel (imprecisa para varios ISP MX). Free 50k/mes.
IPINFO_TOKEN=

# Recetas · controlados COFEPRIS
# Exigir el folio del recetario oficial en los grupos I y II (estupefacientes y
# psicotrópicos). Sin variable, o con cualquier valor, SE EXIGE — el default cae
# del lado seguro. Para apagarlo: off | 0 | false | no. Manda en las dos capas,
# servidor y pantalla (el modal pregunta por GET /api/prescriptions/reglas).
# En Vercel, cambiarla exige un redeploy para que la función la tome.
RECETAS_FOLIO_OBLIGATORIO=
