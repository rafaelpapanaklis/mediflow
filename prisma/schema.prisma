  installments Int              @default(12)
  frequency    String           @default("MONTHLY") // WEEKLY | BIWEEKLY | MONTHLY — TEXT en prod (sql/migration_features6.sql; el type PaymentFrequency nunca existió)
  startDate    DateTime         @default(now())
  notes        String?
  status       String           @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED | OVERDUE — TEXT en prod (el type PlanStatus nunca existió)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  clinic   Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient  Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  payments PlanPayment[]

  @@map("payment_plans")
}

model PlanPayment {
  id          String    @id @default(cuid())
  planId      String
  installment Int
