}

// ── Consent Forms ─────────────────────────────────────────────────────
/// Carta de consentimiento informado con firma electrónica.
///
/// El `content` es un SNAPSHOT INMUTABLE: es exactamente el texto que el
/// paciente leyó y firmó. Nunca se reescribe después de la firma (NOM-004
/// numeral 5.11 — conservación mínima 5 años), y `contentHash` (sha256) permite
/// demostrar en el PDF que nadie lo alteró.
///
/// Un consentimiento FIRMADO no se borra ni se edita: sólo se REVOCA
/// (revokedAt/revokedById/revokedReason). El soft delete (`deletedAt`) queda
/// reservado a los pendientes que nunca se firmaron.
model ConsentForm {
  id           String    @id @default(cuid())
  clinicId     String
  patientId    String
  procedure    String
  content      String
  signedAt     DateTime?
  signatureUrl String?
  token        String    @unique
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// Soft delete — SÓLO para pendientes sin firma (ver DELETE /api/consent/[id]).
  deletedAt DateTime?

  /// Quién lo generó y qué estomatólogo se responsabiliza del acto. Strings
  /// simples SIN @relation a propósito: la carta debe seguir leyéndose aunque
  /// el usuario se dé de baja, y una FK con onDelete restringiría esa baja.
  createdById String?
  doctorId    String?

  /// Clave del catálogo (CONSENT_PROCEDURES). null = texto libre del doctor.
  procedureKey String?

  /// Representante legal que firma en nombre del paciente (menor de edad o
  /// paciente sin capacidad de decidir) — NOM-004 10.1.1.3.
  signerName     String?
  signerRelation String?

  /// Evidencia de la firma electrónica (Código de Comercio arts. 89 y 89 bis;
  /// CFPC 210-A): cuándo se abrió la carta, desde dónde se firmó y el hash del
  /// texto firmado.
  viewedAt        DateTime?
  signedIp        String?
  signedUserAgent String?
  contentHash     String?

  /// Testigos del acto (opcionales, hasta dos) — NOM-004 10.1.1.7.
  witness1Name         String?
  witness1SignatureUrl String?
  witness1SignedAt     DateTime?
  witness2Name         String?
  witness2SignatureUrl String?
  witness2SignedAt     DateTime?

  /// Contrafirma del estomatólogo desde el panel — NOM-013 9.6.9.
  doctorSignedAt     DateTime?
  doctorSignatureUrl String?

  /// Revocación del consentimiento por el paciente (siempre posible mientras el
  /// procedimiento no haya iniciado). No borra nada: deja constancia.
  revokedAt     DateTime?
  revokedById   String?
  revokedReason String?

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId])
  @@index([clinicId, createdAt])
  @@map("consent_forms")
}

// ── Periodontal Records ────────────────────────────────────────────────────────
model PeriodontalRecord {
  id         String                @id @default(cuid())
  patientId  String
  clinicId   String
  doctorId   String
  recordedAt DateTime              @default(now())
  recordType PeriodontalRecordType @default(INICIAL)

  // 192 sitios capturados (6 × 32). JSON denso para evitar tabla pesada.
  // Estructura: Array<{ fdi, position:SitePosition, pdMm, recMm, bop, plaque, suppuration }>.
  // Spec §4.2 — el campo legacy `measurements` queda como compat con
  // implementación pre-perio module; los reportes nuevos leen `sites`.
  sites      Json?
  toothLevel Json?

  // Métricas calculadas en server action (opcional para registros legacy)
  bopPercentage         Float?
  plaqueIndexOleary     Float?
  sites1to3mm           Int?
  sites4to5mm           Int?
  sites6PlusMm          Int?
  teethWithPockets5Plus Int?

  notes           String?
  durationMinutes Int?

  // Comparación con sondaje previo (auto-relación)
  comparedToRecordId String?
  comparedToRecord   PeriodontalRecord?  @relation("PerioCompare", fields: [comparedToRecordId], references: [id])
  derivedRecords     PeriodontalRecord[] @relation("PerioCompare")

  // Legacy (compliance v1, anterior al módulo de Periodoncia 3/5).
  // Mantenido como opcional para no perder datos previos. Reportes
  // y vistas nuevas usan `sites` + `toothLevel`.
  measurements  Json?
  plaquIndex    Float?
  bleedingIndex Float?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor  User    @relation(fields: [doctorId], references: [id])

  classification         PeriodontalClassification?
  reevaluationsAsInitial PeriodontalReevaluation[]  @relation("ReevalInitial")
  reevaluationsAsPost    PeriodontalReevaluation[]  @relation("ReevalPost")

  @@index([patientId, recordedAt(sort: Desc)])
  @@index([clinicId, recordedAt(sort: Desc)])
  @@index([clinicId, deletedAt])
  @@map("periodontal_records")
}

// ── Subscription Invoices (for admin billing) ──────────────────────────────────
model SubscriptionInvoice {
  id          String    @id @default(cuid())
  clinicId    String
  amount      Float
  currency    String    @default("MXN")
  status      String    @default("pending") // pending, paid, failed
  method      String? // stripe, mercadopago, transfer, deposit
  // @unique: es el candado de idempotencia del webhook de Stripe (una fila por
  // invoice.id) — Stripe dispara invoice.paid + invoice.payment_succeeded para
  // la MISMA factura. Requiere el índice único parcial de
  // sql/subscription_invoices_stripe_ref.sql aplicado en la BD.
  reference   String?   @unique // payment reference/ID
  periodStart DateTime
  periodEnd   DateTime
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("subscription_invoices")
}

// ── Audit Log ─────────────────────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  clinicId   String
  userId     String
  entityType String // "patient" | "appointment" | "invoice" | "record"
  entityId   String
  action     String // "create" | "update" | "delete" | "view"
  changes    Json? // { field: { before, after } }
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  // WS2-T3 — atribución del actor de la acción: "staff" (User de clínica) o
  // "admin" (AdminUser de plataforma). actorAdminId referencia AdminUser.id SIN
  // FK estricta (a propósito): la bitácora no se acopla al panel y los borrados
  // de AdminUser no la rompen.
  actorType    String?  @default("staff")
  actorAdminId String?

  // NOM-024 §6.3.5 — la bitácora NO se destruye al borrar la clínica. La FK
  // real en BD es ON DELETE RESTRICT (ver sql/nom-audit-immutable.sql, aplicado
  // a mano). Se declara Restrict aquí para que el ORM no reintroduzca CASCADE.
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id])

  @@index([clinicId, entityType, entityId])
  @@index([clinicId, createdAt])
  // Panel de auditoría (/admin/auditoria, /dashboard/auditoria): orden y filtro
  // global por fecha y por usuario. El CREATE INDEX en BD lo aplica Rafael a
  // mano — ver sql/audit-indexes.sql.
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ── WS2-T3 · Sesiones de admin en DB ──────────────────────────────────────
// Identidad real del administrador de plataforma. Sustituye la cookie global
// única (env ADMIN_SECRET_TOKEN) por sesiones con identidad + revocación.
// GLOBAL: NO lleva clinicId, queda fuera del RLS por clínica a propósito.
model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  totpSecret   String?
  totpEnabled  Boolean        @default(false)
  role         String         @default("SUPER_ADMIN")
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())

  sessions     AdminSession[]

  @@map("admin_users")
}

// Una fila por sesión activa. En BD solo vive el sha256 del token; el token en
// claro únicamente viaja en la cookie httpOnly del navegador del admin.
model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_sessions")
}

model InventoryItem {
  id          String   @id @default(cuid())
  clinicId    String
  name        String
  description String?
  category    String
  emoji       String   @default("📦")
  quantity    Int      @default(0)
  minQuantity Int      @default(5)
  unit        String   @default("pza")
  price       Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic  Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  history InventoryHistory[]

  @@map("inventory_items")
}

model InventoryHistory {
  id        String   @id @default(cuid())
  itemId    String
