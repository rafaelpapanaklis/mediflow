// ── Cuenta y equipo ────────────────────────────────────────────────────

/// El inquilino (tenant) del vertical inmuebles. `mode` decide QUÉ producto
/// es esta cuenta (ver cabecera). storageUsedBytes es BigInt porque el cupo
/// del plan INMOBILIARIA (40 GB) desborda un Int de 4 bytes.
/// 🔴 JSON.stringify REVIENTA con un BigInt sin convertir: al armar un DTO
/// va SIEMPRE Number(account.storageUsedBytes).
model RealtyAccount {
  id        String     @id @default(cuid())
  mode      RealtyMode @default(AGENCY)
  name      String
  slug      String     @unique
  legalName String?
  phone     String?
  email     String?
  address   String?
  city      String?
  state     String?
  timezone  String     @default("America/Mexico_City")
  locale    String     @default("es")
  logoUrl   String?
  /// Tamaño declarado en el registro: "1" | "2-5" | "6-15" | "16+".
  teamSize  String?

  // Plan y suscripción. Registro sin trial → nace "pending_payment", igual
  // que barber y el dental. Activos: active | trialing | paid
  // (REALTY_ACTIVE_SUBSCRIPTION_STATUSES en realty/plan-shared.ts).
  //
  // ⚠️ `mode` y `plan` son ejes INDEPENDIENTES y NO hay constraint que los
  // ligue — a propósito. El MODO dice qué pantallas tienen sentido; el PLAN,
  // cuánta capacidad pagaste. Un rentista (OWNER) puede pagar INMOBILIARIA
  // para tener varias oficinas, y una agencia puede empezar en PROPIETARIO y
  // toparse con el límite de 1 usuario. Por eso los defaults (AGENCY +
  // PROPIETARIO) no son incoherentes: son "agencia que todavía no paga".
  // Quien inserte una cuenta sin pasar por /api/realty/auth/register tiene
  // que poner el modo a mano.
  plan                 RealtyPlan @default(PROPIETARIO)
  subscriptionStatus   String     @default("pending_payment")
  stripeCustomerId     String?
  stripeSubscriptionId String?

  /// Bytes ocupados en realty-files (fotos + tours + documentos). El CUPO
  /// vive en el plan (storageQuotaMb); esto es el consumo.
  storageUsedBytes BigInt @default(0)

  // Licencia inmobiliaria estatal (Jalisco, CDMX, Q. Roo… la exigen). Es
  // informativa y se enseña en la web pública si está vigente.
  licenseNumber    String?
  licenseState     String?
  licenseExpiresAt DateTime?

  // WhatsApp — soporta los DOS modelos de envío. whatsappToken se guardará
  // CIFRADO cuando la ola de WhatsApp lo implemente.
  whatsappSenderMode  RealtyWhatsappSender @default(PLATFORM)
  wabaId              String?
  phoneNumberId       String?
  whatsappToken       String?
  whatsappVerifiedAt  DateTime?
  /// Cupo PROPIO que PISA el del plan (null = manda realty_plan_configs).
  messageQuota        Int?
  messagesUsedPeriod  Int                  @default(0)
  messagesPeriodStart DateTime?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            RealtyUser[]
  offices          RealtyOffice[]
  officeAccess     RealtyUserOfficeAccess[]
  agentProfiles    RealtyAgentProfile[]
  properties       RealtyProperty[]
  propertyPhotos   RealtyPropertyPhoto[]
  propertyTours    RealtyPropertyTour[]
  propertyDocs     RealtyPropertyDocument[]
  propertyOwners   RealtyPropertyOwner[]
  exclusives       RealtyExclusive[]
  contacts         RealtyContact[]
  leads            RealtyLead[]
  leadActivities   RealtyLeadActivity[]
  searchProfiles   RealtySearchProfile[]
  tasks            RealtyTask[]
  visits           RealtyVisit[]
  keys             RealtyKey[]
  leases           RealtyLease[]
  leaseParties     RealtyLeaseParty[]
  rentCharges      RealtyRentCharge[]
  payments         RealtyPayment[]
  deposits         RealtyDeposit[]
  maintenances     RealtyMaintenance[]
  expenses         RealtyExpense[]
  inventoryChecks  RealtyInventoryCheck[]
  inventoryItems   RealtyInventoryItem[]
  deals            RealtyDeal[]
  commissionSplits RealtyCommissionSplit[]
  landingConfig    RealtyLandingConfig?
  portalAccounts   RealtyPortalAccount[]
  portalListings   RealtyPortalListing[]
  threads          RealtyThread[]
  messages         RealtyMessage[]
  clientAuthTokens RealtyClientAuthToken[]
  supportTickets   RealtySupportTicket[]
  supportMessages  RealtySupportMessage[]
  adminActions     RealtyAdminAction[]

  // Cumplimiento antilavado (feature `pld`, solo plan INMOBILIARIA).
  pldFiles      RealtyPldFile[]
  pldDocuments  RealtyPldDocument[]
  pldAccessLogs RealtyPldAccessLog[]
  pldOperations RealtyPldOperation[]
  pldNotices    RealtyPldNotice[]

  // Ola 2 · T2 — contratos y firma electrónica. Cascadean: si la
  // inmobiliaria se va del producto, sus contratos se van con ella (es su
  // expediente, no el nuestro).
  contractTemplates  RealtyContractTemplate[]
  contracts          RealtyContract[]
  contractSignatures RealtyContractSignature[]
  signatureTokens    RealtySignatureToken[]

  // ── CRECIMIENTO (Ola 2, O2-T7). Bloque ADITIVO: si al rebasar choca con
  //    otra terminal en esta misma lista, se CONSERVAN LOS DOS bloques.
  botSettings          RealtyBotSettings?
  botSpend             RealtyBotSpend[]
  botTurns             RealtyBotTurn[]
  botPauses            RealtyBotPause[]
  contactOptOuts       RealtyContactOptOut[]
  growthSettings       RealtyGrowthSettings?
  campaigns            RealtyCampaign[]
  campaignRecipients   RealtyCampaignRecipient[]
  priceWatch           RealtyPropertyPriceWatch[]
  screeningRequests    RealtyScreeningRequest[]
  affiliate            RealtyAffiliate?
  affiliateReferral    RealtyAffiliateReferral?
  affiliateCommissions RealtyAffiliateCommission[]

  // Sin @@index([slug]): `slug @unique` ya crea su propio índice.
  @@index([subscriptionStatus])
  @@map("realty_accounts")
}

/// Quien entra al panel /inmobiliaria. permissionsOverride: si tiene keys,
/// esas REEMPLAZAN el default del rol (no se suman) — misma semántica que
/// el dental y barber. `active` (no isActive) porque así lo pide el contrato
/// del vertical; el SQL usa la misma columna.
model RealtyUser {
  id                   String     @id @default(cuid())
  accountId            String
  /// Identidad del login COMPARTIDO (Supabase Auth). El User del dental no
  /// se toca: este vertical tiene su propia tabla de usuarios.
  supabaseId           String
  email                String
  firstName            String
  lastName             String
  role                 RealtyRole @default(OWNER)
  permissionsOverride  String[]   @default([])
  /// ¿Su ficha sale en la web pública? (feature agentPages del plan.)
  /// La ficha se pinta solo si publicProfileEnabled Y
  /// RealtyAgentProfile.active son true — un AND, para que apagar uno no deje
  /// al asesor visible por el otro. Este es el interruptor de la CUENTA (lo
  /// mueve quien administra el equipo); `active` es el de la ficha (lo mueve
  /// el propio asesor cuando la deja a medias).
  publicProfileEnabled Boolean    @default(false)
  active               Boolean    @default(true)
  lastLogin            DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  account      RealtyAccount            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  agentProfile RealtyAgentProfile?
  officeAccess RealtyUserOfficeAccess[]

  assignedProperties    RealtyProperty[]        @relation("RealtyPropertyAssignedTo")
  assignedContacts      RealtyContact[]         @relation("RealtyContactAssignedTo")
  assignedLeads         RealtyLead[]            @relation("RealtyLeadAssignedTo")
  leadActivities        RealtyLeadActivity[]    @relation("RealtyLeadActivityUser")
  tasks                 RealtyTask[]            @relation("RealtyTaskUser")
  visits                RealtyVisit[]           @relation("RealtyVisitUser")
  keysHeld              RealtyKey[]             @relation("RealtyKeyHolder")
  commissionSplits      RealtyCommissionSplit[] @relation("RealtyCommissionSplitUser")
  landingConfigsUpdated RealtyLandingConfig[]   @relation("RealtyLandingConfigUpdatedBy")
  supportTicketsCreated RealtySupportTicket[]   @relation("RealtySupportTicketCreatedBy")

  @@unique([supabaseId, accountId])
  // Dos invitaciones al mismo correo creaban DOS usuarios en la misma cuenta,
  // con permisos distintos y sin forma de saber cuál manda.
  @@unique([accountId, email])
  // Sin @@index([supabaseId]): la columna guía del @@unique de arriba ya
  // sirve para el lookup del login. Duplicarlo solo cuesta escrituras.
  @@index([accountId, active])
  @@map("realty_users")
}

/// Sucursal física. En modo AGENT y OWNER hay una sola (la que crea el alta);
/// multiOffice es feature del plan INMOBILIARIA.
model RealtyOffice {
  id        String   @id @default(cuid())
  accountId String
  name      String
  address   String?
  lat       Decimal? @db.Decimal(10, 7)
  lng       Decimal? @db.Decimal(10, 7)
  phone     String?
  /// La matriz; getAccessibleOfficeIds la pone primero en la lista.
  /// ⚠️ UNA por cuenta, y la BASE NO LO IMPONE (Prisma no expresa únicos
  /// parciales). Con dos, ese orden deja de ser determinista y la "principal"
  /// cambia sola entre peticiones. Quien marque una matriz quita la anterior
  /// en la MISMA transacción.
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account    RealtyAccount            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  access     RealtyUserOfficeAccess[]
  properties RealtyProperty[]

  @@index([accountId, isActive])
  @@map("realty_offices")
}

/// Acceso de un RealtyUser a una oficina. Se consume EXCLUSIVAMENTE vía
/// getAccessibleOfficeIds() (src/lib/realty-auth.ts) — ninguna terminal
/// inventa su filtro de oficina.
model RealtyUserOfficeAccess {
  id        String   @id @default(cuid())
  accountId String
  userId    String
  officeId  String
  createdAt DateTime @default(now())

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    RealtyUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  office  RealtyOffice  @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([userId, officeId])
  @@index([accountId])
  @@index([officeId])
  @@map("realty_user_office_access")
}

/// Ficha PÚBLICA del asesor (feature agentPages). credentials/socials son
/// Json de forma libre que define la ola de equipo.
model RealtyAgentProfile {
  id           String   @id @default(cuid())
  accountId    String
  realtyUserId String   @unique
  displayName  String
  photoUrl     String?
  bio          String?  @db.Text
  zones        String[] @default([])
  specialties  String[] @default([])
  credentials  Json?
  socials      Json?
  /// Sub-ruta pública del asesor. NULL = sin página propia; varios NULL NO
  /// chocan entre sí (Postgres trata cada NULL como distinto), que es justo
  /// lo que queremos aquí.
  publicSlug   String?
  /// Interruptor de la FICHA. La ficha se pinta solo si este Y
  /// RealtyUser.publicProfileEnabled son true (ver ahí).
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account    RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  realtyUser RealtyUser    @relation(fields: [realtyUserId], references: [id], onDelete: Cascade)

  @@unique([accountId, publicSlug])
  @@index([accountId, active])
  @@map("realty_agent_profiles")
}

// ── Inmuebles ──────────────────────────────────────────────────────────

/// El INMUEBLE (nunca "propiedad" a secas en la UI, nunca "ambiente").
/// assignedUserId es NULLABLE A PROPÓSITO: un inmueble entra a la cartera
/// antes de que se decida quién lo trabaja, y en modo OWNER no hay asesor
/// que asignar. Cualquier consulta que asuma que hay asesor está mal.
/// internalNotes NUNCA sale a la web pública.
model RealtyProperty {
  id             String               @id @default(cuid())
  accountId      String
  officeId       String?
  assignedUserId String?
  ownerId        String?
  kind           RealtyPropertyKind   @default(CASA)
  operation      RealtyOperation      @default(VENTA)
  status         RealtyPropertyStatus @default(DISPONIBLE)

  // Dinero. Decimal(14,2): un edificio de 80 millones no cabe en (10,2).
  price          Decimal        @default(0) @db.Decimal(14, 2)
  currency       RealtyCurrency @default(MXN)
  rentPrice      Decimal?       @db.Decimal(14, 2)
  maintenanceFee Decimal?       @db.Decimal(14, 2)

  // Medidas y distribución (español de México: recámara, cochera).
  /// Decimal(12,2) y no (10,2): con 10 el tope eran ~9 999 ha y RANCHO está
  /// en el enum — en Chihuahua y Sonora los hay más grandes.
  landM2        Decimal? @db.Decimal(12, 2)
  builtM2       Decimal? @db.Decimal(10, 2)
  bedrooms      Int?
  bathrooms     Int?
  halfBathrooms Int?
  parking       Int?
  ageYears      Int?
  /// Amenidades: mapa libre. Catálogo sugerido en REALTY_AMENITIES.
  amenities     Json?

  // Ubicación. showExactAddress false → la web pública enseña SOLO colonia
  // y ciudad. Es la privacidad que pide el propietario, no un adorno.
  address          String?
  colonia          String?
  city             String?
  state            String?
  zip              String?
  lat              Decimal? @db.Decimal(10, 7)
  lng              Decimal? @db.Decimal(10, 7)
  showExactAddress Boolean  @default(false)

  title         String
  description   String? @db.Text
  internalNotes String? @db.Text

  commissionPct  Decimal? @db.Decimal(5, 2)
  /// ¿Sale en la web pública y en el feed de portales? Es INDEPENDIENTE del
  /// estatus comercial: un inmueble DISPONIBLE que el dueño no quiere
  /// anunciado se despublica con esto, sin mentir sobre su estatus. Nace en
  /// false: nada se publica solo.
  isPublished    Boolean  @default(false)
  /// Sub-ruta pública dentro de /i/[slug]. Único POR CUENTA.
  publicUrlSlug  String?
  /// Clave corta que el asesor dicta por teléfono ("INM-7K3Q"). Ver
  /// makeRealtyFolio en realty/types.ts. Única POR CUENTA.
  shortTermFolio String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account      RealtyAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  office       RealtyOffice?        @relation(fields: [officeId], references: [id], onDelete: SetNull)
  assignedUser RealtyUser?          @relation("RealtyPropertyAssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)
  // NoAction: con SetNull, borrar al propietario dejaba sus inmuebles con
  // ownerId NULL — indistinguibles de los que nunca tuvieron dueño
  // capturado, y en modo AGENCY/AGENT el dueño es medio producto.
  owner        RealtyPropertyOwner? @relation(fields: [ownerId], references: [id], onDelete: NoAction)

  photos         RealtyPropertyPhoto[]
  tours          RealtyPropertyTour[]
  documents      RealtyPropertyDocument[]
  exclusives     RealtyExclusive[]
  leads          RealtyLead[]
  tasks          RealtyTask[]
  visits         RealtyVisit[]
  keys           RealtyKey[]
  leases         RealtyLease[]
  maintenances   RealtyMaintenance[]
  expenses       RealtyExpense[]
  deals          RealtyDeal[]
  portalListings RealtyPortalListing[]

  // Los dos únicos incluyen una columna NULLABLE: en Postgres cada NULL
  // cuenta como distinto, así que MUCHOS inmuebles pueden convivir con
  // publicUrlSlug/shortTermFolio en NULL sin chocar. Es justo lo que
  // queremos (un inmueble sin publicar no tiene liga ni clave), y el único
  // sigue impidiendo dos ligas iguales dentro de la misma cuenta.
  @@unique([accountId, publicUrlSlug])
  @@unique([accountId, shortTermFolio])
  @@index([accountId, status])
  // La lista por defecto de /inmuebles es "lo más nuevo primero": sin este
  // índice se ordena en memoria la cartera completa de la cuenta.
  @@index([accountId, createdAt])
  @@index([accountId, operation, kind])
  // El filtro más usado de la cartera es operación + estatus A LA VEZ.
  @@index([accountId, operation, status])
  @@index([accountId, assignedUserId])
  @@index([accountId, city, colonia])
  @@index([officeId])
  @@index([ownerId])
  @@map("realty_properties")
}

/// Foto del inmueble. `sortOrder` y no `order`: ORDER es palabra reservada
/// en SQL y en cuanto alguien escriba una consulta cruda se le vuelve un
/// campo minado. watermarked = ya lleva la marca de agua aplicada.
///
/// ⚠️ isCover: UNA por inmueble, y la BASE NO LO IMPONE (Prisma no expresa
/// índices únicos parciales). Con dos portadas, la tarjeta de la web pública
/// cambia de foto entre renders y nadie entiende por qué. Quien marque una
/// portada TIENE que quitar la anterior en la MISMA transacción:
///   await tx.realtyPropertyPhoto.updateMany({
///     where: { propertyId, isCover: true }, data: { isCover: false } });
///   await tx.realtyPropertyPhoto.update({
///     where: { id }, data: { isCover: true } });
model RealtyPropertyPhoto {
  id          String   @id @default(cuid())
  accountId   String
  propertyId  String
  sortOrder   Int      @default(0)
  url         String
  width       Int?
  height      Int?
  bytes       Int      @default(0)
  isCover     Boolean  @default(false)
  watermarked Boolean  @default(false)
  createdAt   DateTime @default(now())

  account  RealtyAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property RealtyProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([accountId, propertyId, sortOrder])
  @@index([propertyId, isCover])
  @@map("realty_property_photos")
}

/// Recorrido 3D / 360° / video. `provider` sale de detectRealtyTourProvider
/// (src/lib/realty/tours.ts) — la MISMA allowlist que arma el frame-src de
/// la CSP. Un dominio fuera de esa lista pinta un iframe EN BLANCO sin un
/// solo error en consola: por eso se valida al guardar, no al pintar.
/// externalUrl (enlace del proveedor) XOR fileUrl (panorámica propia
/// subida a realty-files).
model RealtyPropertyTour {
  id          String         @id @default(cuid())
  accountId   String
  propertyId  String
  kind        RealtyTourKind @default(TOUR_360)
  provider    String         @default("propio")
  externalUrl String?
  fileUrl     String?
  bytes       Int            @default(0)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  account  RealtyAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property RealtyProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([accountId, propertyId, sortOrder])
  @@map("realty_property_tours")
}

/// Documento del inmueble (escritura, predial, régimen…). PRIVADO: el
/// bucket realty-files no es público y el panel entrega signed URLs de 5
/// min después de comprobar el accountId de la sesión.
model RealtyPropertyDocument {
  id         String             @id @default(cuid())
  accountId  String
  propertyId String
  kind       RealtyDocumentKind @default(OTRO)
  name       String
  url        String
  bytes      Int                @default(0)
  createdAt  DateTime           @default(now())

  account  RealtyAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property RealtyProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([accountId, propertyId])
  @@map("realty_property_documents")
}

/// El DUEÑO del inmueble (persona a la que le pagas o le rindes cuentas).
/// En modo OWNER la cuenta es su propio dueño y esta tabla queda vacía.
model RealtyPropertyOwner {
  id        String   @id @default(cuid())
  accountId String
  name      String
  phone     String?
  email     String?
  /// Solo dato de contacto. Este vertical NO factura: no hay CFDI ni
  /// timbrado, el RFC es para el contrato de arrendamiento y ya.
  rfc       String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account    RealtyAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  properties RealtyProperty[]
  exclusives RealtyExclusive[]

  @@index([accountId, name])
  @@index([accountId, phone])
  @@map("realty_property_owners")
}

/// Contrato de EXCLUSIVA sobre un inmueble. Es lo que le da derecho a la
/// inmobiliaria a cobrar comisión: sin exclusiva vigente, la operación se
/// puede ir con cualquiera.
model RealtyExclusive {
  id            String   @id @default(cuid())
  accountId     String
  propertyId    String
  ownerId       String
  startsAt      DateTime
  endsAt        DateTime
  commissionPct Decimal  @db.Decimal(5, 2)
  signedDocUrl  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account  RealtyAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Los DOS lados con NoAction: la exclusiva y su signedDocUrl son el papel
  // que da derecho a cobrar la comisión. Con Cascade, borrar el inmueble se
  // llevaba el documento. Antes estaba protegido solo el lado del dueño.
  property RealtyProperty      @relation(fields: [propertyId], references: [id], onDelete: NoAction)
  owner    RealtyPropertyOwner @relation(fields: [ownerId], references: [id], onDelete: NoAction)

  // "Exclusivas por vencer" recorre la cuenta entera por fecha de fin.
  @@index([accountId, endsAt])
  @@index([accountId, propertyId, endsAt])
  @@index([ownerId])
  @@map("realty_exclusives")
}

// ── CRM ────────────────────────────────────────────────────────────────

/// La persona. kind dice en qué papel entró (prospecto, propietario,
/// inquilino); una misma persona puede terminar siendo las tres, por eso
/// el papel NO se usa como filtro de seguridad, solo de listado.
model RealtyContact {
  id             String            @id @default(cuid())
  accountId      String
  name           String
  /// 🔴 NORMALIZADO A 10 DÍGITOS (mxTenDigits de @/lib/phone-mx), igual que
  /// RealtyThread.phone. Si se guarda como lo escribió la persona ("33 1234
  /// 5678", "+52 33…"), el webhook de WhatsApp NUNCA logra ligar el hilo
  /// entrante con su contacto y el inbox se llena de conversaciones sin
  /// nombre. Un `contains` sobre un teléfono sin normalizar no compara nada.
  phone          String?
  email          String?
  kind           RealtyContactKind @default(PROSPECTO)
  /// De dónde llegó: "web", "portal:inmuebles24", "referido", "letrero"…
  source         String?
  assignedUserId String?
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  account      RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assignedUser RealtyUser?   @relation("RealtyContactAssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)

  leads          RealtyLead[]
  searchProfiles RealtySearchProfile[]
  leaseParties   RealtyLeaseParty[]
  deals          RealtyDeal[]
  threads        RealtyThread[]
  /// Expediente antilavado. Es UNO por cuenta (@@unique en RealtyPldFile).
  pldFiles       RealtyPldFile[]

  @@index([accountId, kind])
  @@index([accountId, phone])
  @@index([accountId, name])
  @@index([accountId, assignedUserId])
  @@map("realty_contacts")
}

/// El PROSPECTO dentro del embudo. firstResponseAt es el reloj del negocio:
/// en bienes raíces gana quien contesta primero, así que se guarda cuándo
/// alguien le respondió por PRIMERA vez y no se vuelve a escribir.
/// La máquina de estados vive en canTransition() (realty/types.ts).
model RealtyLead {
  id              String           @id @default(cuid())
  accountId       String
  contactId       String
  propertyId      String?
  /// Portal de origen ("inmuebles24", "lamudi", "propio"…).
  portal          String?
  stage           RealtyLeadStage  @default(NUEVO)
  /// Ver REALTY_LOST_REASONS (String en BD, catálogo en el contrato).
  lostReason      String?
  budgetMin       Decimal?         @db.Decimal(14, 2)
  budgetMax       Decimal?         @db.Decimal(14, 2)
  creditKind      RealtyCreditKind @default(NINGUNO)
  firstResponseAt DateTime?
  assignedAt      DateTime?
  assignedUserId  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  account      RealtyAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact      RealtyContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  property     RealtyProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignedUser RealtyUser?     @relation("RealtyLeadAssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)

  activities RealtyLeadActivity[]
  tasks      RealtyTask[]
  visits     RealtyVisit[]

  @@index([accountId, stage])
  @@index([accountId, assignedUserId, stage])
  @@index([accountId, createdAt])
  @@index([contactId])
  @@index([propertyId])
  @@map("realty_leads")
}

/// Bitácora del prospecto. userId es nullable y SetNull a propósito: los
/// usuarios se desactivan (active=false), no se borran, así que en la
/// práctica el autor no se pierde; y si algún día se borrara uno, la bitácora
/// SOBREVIVE sin autor en vez de bloquear el borrado. Lo que no puede pasar
/// es perder la línea de tiempo del prospecto.
model RealtyLeadActivity {
  id        String                 @id @default(cuid())
  accountId String
  leadId    String
  kind      RealtyLeadActivityKind @default(NOTA)
  note      String?                @db.Text
  userId    String?
  createdAt DateTime               @default(now())

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lead    RealtyLead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user    RealtyUser?   @relation("RealtyLeadActivityUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([accountId, leadId, createdAt])
  @@map("realty_lead_activities")
}

/// Lo que BUSCA un contacto. Alimenta el MATCH AUTOMÁTICO: cuando entra un
/// inmueble a la cartera, se cruza contra estos perfiles y se avisa a quien
/// encaje (notifyByWhatsapp).
model RealtySearchProfile {
  id               String          @id @default(cuid())
  accountId        String
  contactId        String
  /// Tipos de inmueble que acepta: mapa { CASA: true, TERRENO: false… }.
  kinds            Json?
  operation        RealtyOperation @default(VENTA)
  zones            String[]        @default([])
  budgetMin        Decimal?        @db.Decimal(14, 2)
  budgetMax        Decimal?        @db.Decimal(14, 2)
  bedroomsMin      Int?
  notifyByWhatsapp Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact RealtyContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([accountId, operation])
  @@index([contactId])
  @@map("realty_search_profiles")
}

/// Pendiente con fecha. Cuelga de un prospecto, de un inmueble, o de nada.
model RealtyTask {
  id         String   @id @default(cuid())
  accountId  String
  userId     String
  leadId     String?
  propertyId String?
  dueAt      DateTime
  done       Boolean  @default(false)
  title      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account  RealtyAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user     RealtyUser      @relation("RealtyTaskUser", fields: [userId], references: [id], onDelete: Cascade)
  // SetNull y NO Cascade: un pendiente puede colgar de los dos a la vez, así
  // que con Cascade borrar el inmueble se llevaba por delante un recordatorio
  // que era del prospecto. Un pendiente sin inmueble sigue teniendo título,
  // fecha y dueño; uno borrado en silencio es trabajo de alguien que
  // desaparece sin avisar.
  lead     RealtyLead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  property RealtyProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([accountId, userId, done, dueAt])
  @@index([accountId, dueAt])
  @@index([leadId])
  @@index([propertyId])
  @@map("realty_tasks")
}

/// Visita al inmueble. feedback es lo que dijo el prospecto al salir: es el
/// dato que le sirve al propietario para bajar el precio.
model RealtyVisit {
  id          String            @id @default(cuid())
  accountId   String
  propertyId  String
  leadId      String?
  userId      String?
  scheduledAt DateTime
  status      RealtyVisitStatus @default(PROGRAMADA)
  feedback    String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  account  RealtyAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property RealtyProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lead     RealtyLead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user     RealtyUser?    @relation("RealtyVisitUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([accountId, scheduledAt])
  @@index([accountId, userId, scheduledAt])
  @@index([propertyId, scheduledAt])
  @@index([leadId])
  @@map("realty_visits")
}

/// Quién tiene las llaves AHORA. returnedAt null = siguen fuera. Es la
/// pregunta que se hace todos los días en una inmobiliaria y hoy se
/// contesta con un grupo de WhatsApp.
model RealtyKey {
  id           String    @id @default(cuid())
  accountId    String
  propertyId   String
  holderUserId String?
  /// A quién se le prestaron si no es alguien del equipo ("al velador").
  holderNote   String?
  takenAt      DateTime  @default(now())
  returnedAt   DateTime?
  createdAt    DateTime  @default(now())

  account  RealtyAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property RealtyProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  holder   RealtyUser?    @relation("RealtyKeyHolder", fields: [holderUserId], references: [id], onDelete: SetNull)

  // "¿Qué llaves están fuera?" (accountId + returnedAt IS NULL) es la
  // pregunta de todos los días y no tenía índice con prefijo utilizable.
  @@index([accountId, returnedAt])
  @@index([accountId, propertyId, returnedAt])
  @@index([accountId, holderUserId, returnedAt])
  @@map("realty_keys")
}

// ── Rentas ─────────────────────────────────────────────────────────────

/// Contrato de arrendamiento. paymentDay = día del mes en que toca pagar
/// (1-31); la ola de cobranza genera los RealtyRentCharge a partir de él.
/// increaseRule INPC usa el índice de RealtyCalcParam del año que toque.
model RealtyLease {
  id            String             @id @default(cuid())
  accountId     String
  propertyId    String
  startsAt      DateTime
  endsAt        DateTime
  rentAmount    Decimal            @db.Decimal(14, 2)
  currency      RealtyCurrency     @default(MXN)
  paymentDay    Int                @default(1)
  depositAmount Decimal            @default(0) @db.Decimal(14, 2)
  increaseRule  RealtyIncreaseRule @default(NINGUNO)
  increasePct   Decimal?           @db.Decimal(5, 2)
  status        RealtyLeaseStatus  @default(BORRADOR)
  signedDocUrl  String?
  notes         String?            @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  account  RealtyAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property RealtyProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  parties         RealtyLeaseParty[]
  charges         RealtyRentCharge[]
  payments        RealtyPayment[]
  deposits        RealtyDeposit[]
  maintenances    RealtyMaintenance[]
  inventoryChecks RealtyInventoryCheck[]

  @@index([accountId, status])
  @@index([accountId, endsAt])
  @@index([propertyId, status])
  @@map("realty_leases")
}

/// Quién firma el contrato y en qué papel. screeningStatus = resultado de
/// la investigación de solvencia (la ola de rentas define el proceso).
model RealtyLeaseParty {
  id              String                 @id @default(cuid())
  accountId       String
  leaseId         String
  role            RealtyLeasePartyRole   @default(INQUILINO)
  contactId       String
  screeningStatus RealtyScreeningStatus?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lease   RealtyLease   @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  contact RealtyContact @relation(fields: [contactId], references: [id], onDelete: NoAction)

  @@unique([leaseId, contactId, role])
  @@index([accountId, leaseId])
  @@index([contactId])
  @@map("realty_lease_parties")
}

/// El cargo mensual de la renta. periodMonth = "YYYY-MM" del mes que cubre.
/// ÚNICO por (leaseId, periodMonth): correr el generador dos veces NO
/// duplica el cobro del mes.
model RealtyRentCharge {
  id          String             @id @default(cuid())
  accountId   String
  leaseId     String
  periodMonth String
  dueAt       DateTime
  amount      Decimal            @db.Decimal(14, 2)
  status      RealtyChargeStatus @default(PENDIENTE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  account  RealtyAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lease    RealtyLease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  payments RealtyPayment[]

  @@unique([leaseId, periodMonth])
  @@index([accountId, status, dueAt])
  @@index([accountId, dueAt])
  // La pantalla de cobranza se mira por MES ("agosto"), no solo por fecha.
  @@index([accountId, periodMonth])
  @@map("realty_rent_charges")
}

/// Un pago recibido. 🔴 receiptUrl es un RECIBO. Este vertical NO factura:
/// no hay CFDI, ni timbrado, ni complemento de pago, y ninguna pantalla
/// puede decir "factura".
/// chargeId (renta) / leaseId (depósito, penalización) / dealId (comisión
/// de una operación): al menos uno debería venir, lo cuida la ola de dinero.
model RealtyPayment {
  id         String              @id @default(cuid())
  accountId  String
  chargeId   String?
  leaseId    String?
  dealId     String?
  amount     Decimal             @db.Decimal(14, 2)
  method     RealtyPaymentMethod @default(EFECTIVO)
  paidAt     DateTime            @default(now())
  /// Referencia bancaria o folio del SPEI.
  reference  String?
  receiptUrl String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  account RealtyAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // 🔴 NoAction y NO SetNull en las tres. Con SetNull, borrar el inmueble
  // arrastraba el contrato y con él sus cargos — pero el PAGO sobrevivía con
  // chargeId/leaseId/dealId en NULL, seguía sumando en el reporte de ingresos
  // por @@index([accountId, paidAt]) y ya no había forma de saber de quién
  // era. Con NoAction ese borrado FALLA (P2003) y hay que TERMINAR el
  // contrato en vez de borrarlo, que es lo correcto.
  // El borrado de la cuenta entera sigue funcionando: NO ACTION se verifica
  // al FINAL del statement y para entonces el pago también se fue en cascada.
  charge  RealtyRentCharge? @relation(fields: [chargeId], references: [id], onDelete: NoAction)
  lease   RealtyLease?      @relation(fields: [leaseId], references: [id], onDelete: NoAction)
  deal    RealtyDeal?       @relation(fields: [dealId], references: [id], onDelete: NoAction)

  @@index([accountId, paidAt])
  @@index([chargeId])
  @@index([leaseId])
  @@index([dealId])
  @@map("realty_payments")
}

/// El depósito en garantía. RETENIDO mientras dura el contrato; al final se
/// DEVUELVE o se APLICA (a daños o a rentas no pagadas).
model RealtyDeposit {
  id         String              @id @default(cuid())
  accountId  String
  leaseId    String
  amount     Decimal             @db.Decimal(14, 2)
  status     RealtyDepositStatus @default(RETENIDO)
  resolvedAt DateTime?
  note       String?             @db.Text
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // NoAction: un depósito RETENIDO es dinero del inquilino que hay que
  // devolver. Con Cascade, borrar el contrato lo borraba sin dejar rastro de
  // que se había cobrado. El contrato se TERMINA, no se borra.
  lease   RealtyLease   @relation(fields: [leaseId], references: [id], onDelete: NoAction)

  @@index([accountId, status])
  @@index([leaseId])
  @@map("realty_deposits")
}

/// Incidencia de mantenimiento. reportedBy es texto libre porque casi
/// siempre lo reporta el inquilino, que no tiene usuario del panel.
model RealtyMaintenance {
  id          String                  @id @default(cuid())
  accountId   String
  propertyId  String
  leaseId     String?
  reportedBy  String?
  description String                  @db.Text
  photoUrls   String[]                @default([])
  status      RealtyMaintenanceStatus @default(ABIERTO)
  vendorName  String?
  cost        Decimal?                @db.Decimal(14, 2)
  resolvedAt  DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  account  RealtyAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property RealtyProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lease    RealtyLease?   @relation(fields: [leaseId], references: [id], onDelete: SetNull)

  @@index([accountId, status, createdAt])
  @@index([propertyId, status])
  @@index([leaseId])
  @@map("realty_maintenances")
}

/// Gasto del inmueble (predial, agua, reparaciones). Es lo que se le resta
/// al propietario en su corte, y lo que hace real el "rendimiento" de la
/// calculadora.
model RealtyExpense {
  id         String            @id @default(cuid())
  accountId  String
  propertyId String
  kind       RealtyExpenseKind @default(OTRO)
  amount     Decimal           @db.Decimal(14, 2)
  paidAt     DateTime
  note       String?           @db.Text
  receiptUrl String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  account  RealtyAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property RealtyProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([accountId, paidAt])
  @@index([propertyId, kind, paidAt])
  @@map("realty_expenses")
}

/// Inventario de ENTRADA (lo que se entrega) y de SALIDA (lo que se
/// devuelve). Es la prueba con la que se decide si el depósito se devuelve.
model RealtyInventoryCheck {
  id          String                   @id @default(cuid())
  accountId   String
  leaseId     String
  kind        RealtyInventoryCheckKind @default(ENTRADA)
  performedAt DateTime                 @default(now())
  signedBy    String?
  notes       String?                  @db.Text
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  account RealtyAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lease   RealtyLease           @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  items   RealtyInventoryItem[]

  @@index([accountId, leaseId, kind])
  @@map("realty_inventory_checks")
}

/// Renglón del inventario: recámara / clóset / "puerta corrediza rayada".
model RealtyInventoryItem {
  id        String   @id @default(cuid())
  accountId String
  checkId   String
  room      String
  item      String
  condition String
  photoUrls String[] @default([])
  createdAt DateTime @default(now())

  account RealtyAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  check   RealtyInventoryCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@index([accountId, checkId])
  @@map("realty_inventory_items")
}

// ── Operaciones y comisiones ───────────────────────────────────────────

/// La operación cerrada (venta o renta). amount = precio de la operación;
/// commissionAmount = lo que cobró la casa. El reparto vive en los splits.
model RealtyDeal {
  id               String           @id @default(cuid())
  accountId        String
  propertyId       String
  kind             RealtyDealKind   @default(VENTA)
  contactId        String?
  closedAt         DateTime?
  amount           Decimal          @default(0) @db.Decimal(14, 2)
  commissionAmount Decimal          @default(0) @db.Decimal(14, 2)
  status           RealtyDealStatus @default(EN_PROCESO)
  notes            String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  account  RealtyAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property RealtyProperty @relation(fields: [propertyId], references: [id], onDelete: NoAction)
  contact  RealtyContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  splits   RealtyCommissionSplit[]
  payments RealtyPayment[]
  /// La cara PLD de la operación: las decisiones que tomó una persona sobre
  /// el efectivo y la alerta de 24 horas. El umbral NO se guarda aquí.
  pldOps   RealtyPldOperation[]

  @@index([accountId, status, closedAt])
  @@index([accountId, closedAt])
  @@index([propertyId])
  @@index([contactId])
  @@map("realty_deals")
}

/// El reparto de la comisión. realtyUserId null = la parte es de la oficina,
/// de la franquicia o de un asesor EXTERNO que no tiene usuario aquí — por
/// eso es nullable y por eso `party` es obligatorio.
/// La suma de los pct de un deal debería dar 100: lo valida la ola de
/// comisiones, no la base (un split se captura antes que los otros).
model RealtyCommissionSplit {
  id           String                @id @default(cuid())
  accountId    String
  dealId       String
  realtyUserId String?
  party        RealtyCommissionParty @default(COLOCADOR)
  pct          Decimal               @default(0) @db.Decimal(5, 2)
  amount       Decimal               @default(0) @db.Decimal(14, 2)
  /// Nombre de la contraparte externa cuando no hay realtyUserId.
  externalName String?
  paidAt       DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  account    RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deal       RealtyDeal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  // 🔴 NoAction y NO SetNull: aquí realtyUserId NULL SIGNIFICA "la parte es
  // de la oficina". Con SetNull, dar de baja a un asesor convertía su
  // comisión sin pagar en una parte de la oficina, sin aviso y sin rastro.
  // Los usuarios se desactivan (active=false), no se borran.
  realtyUser RealtyUser?   @relation("RealtyCommissionSplitUser", fields: [realtyUserId], references: [id], onDelete: NoAction)

  @@index([accountId, dealId])
  @@index([accountId, realtyUserId, paidAt])
  @@map("realty_commission_splits")
}

// ── Web pública ────────────────────────────────────────────────────────

/// Configuración de la web pública (/i/[slug]). UNA por cuenta.
/// 🔴 `version` es BLOQUEO OPTIMISTA: el editor manda de vuelta la versión
/// que cargó y si no coincide se responde 409 en vez de pisar el trabajo de
/// otra pestaña. Es exactamente el 409 que sufrió la mini-web del dental
/// hasta que se le puso este campo — aquí nace con él.
model RealtyLandingConfig {
  id              String   @id @default(cuid())
  accountId       String   @unique
  template        String   @default("clasica")
  data            Json     @default("{}")
  published       Boolean  @default(false)
  version         Int      @default(1)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account   RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  updatedBy RealtyUser?   @relation("RealtyLandingConfigUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("realty_landing_configs")
}

// ── Portales ───────────────────────────────────────────────────────────

/// Credenciales de la cuenta en un portal (inmuebles24, lamudi, vivanuncios).
/// 🔴 apiKey JAMÁS sale al navegador: el DTO solo dice si está configurada.
/// La Ola 1 solo construye el FEED propio; la sincronización real llega
/// después, pero el schema ya está para que nadie tenga que migrarlo.
model RealtyPortalAccount {
  id                String   @id @default(cuid())
  accountId         String
  portal            String
  externalAccountId String?
  apiKey            String?
  maxListings       Int      @default(0)
  active            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, portal])
  @@index([accountId, active])
  @@map("realty_portal_accounts")
}

/// Estado de UN inmueble en UN portal. lastError guarda el mensaje crudo:
/// sin él, "no se publicó" es indistinguible de "se publicó y lo bajaron".
model RealtyPortalListing {
  id           String                    @id @default(cuid())
  accountId    String
  propertyId   String
  portal       String
  externalId   String?
  status       RealtyPortalListingStatus @default(BORRADOR)
  lastPushedAt DateTime?
  lastError    String?                   @db.Text
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  account  RealtyAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property RealtyProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, portal])
  @@index([accountId, portal, status])
  @@map("realty_portal_listings")
}

// ── WhatsApp ───────────────────────────────────────────────────────────

/// Conversación con un teléfono. ÚNICO por (accountId, phone): dos mensajes
/// entrando a la vez NO abren dos hilos del mismo número.
/// OJO al comparar teléfonos: se guardan normalizados a 10 dígitos.
model RealtyThread {
  id            String   @id @default(cuid())
  accountId     String
  contactId     String?
  phone         String
  lastMessageAt DateTime @default(now())
  unread        Int      @default(0)
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account  RealtyAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact  RealtyContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages RealtyMessage[]

  @@unique([accountId, phone])
  @@index([accountId, archived, lastMessageAt])
  @@index([contactId])
  @@map("realty_threads")
}

/// Mensaje de WhatsApp. errorCode/errorTitle vienen de Meta y son lo único
/// que explica un envío fallido: guardarlos es la diferencia entre "no
/// llegó" y "la plantilla no está aprobada".
model RealtyMessage {
  id           String                 @id @default(cuid())
  accountId    String
  threadId     String
  direction    RealtyMessageDirection @default(OUTBOUND)
  body         String?                @db.Text
  mediaUrl     String?
  templateName String?
  externalId   String?
  status       RealtyMessageStatus    @default(PENDING)
  /// Int y no String: Meta CAMBIA la redacción del error cuando quiere, pero
  /// nunca el número. Comparar contra el texto es una prueba que se rompe
  /// sola (mismo criterio que InboxMessage.errorCode del dental).
  errorCode    Int?
  errorTitle   String?
  createdAt    DateTime               @default(now())

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  thread  RealtyThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)

  // 🔴 ÚNICO y no solo índice: Meta REENTREGA el webhook ante cualquier
  // respuesta que no sea 200 y ante un timeout. Sin este único, cada
  // reentrega insertaba otra vez el mismo mensaje en el hilo. externalId es
  // nullable y en Postgres los NULL no chocan entre sí, así que los salientes
  // que todavía no tienen id de Meta conviven sin problema.
  @@unique([threadId, externalId])
  @@index([accountId, threadId, createdAt])
  @@index([externalId])
  @@map("realty_messages")
}

// ── Plataforma ─────────────────────────────────────────────────────────

/// Los 3 planes del vertical, EDITABLES sin redeploy. FUENTE ÚNICA de
/// precios y límites — CERO precios escritos en la UI.
/// planId: PROPIETARIO | ASESOR | INMOBILIARIA. -1 = ilimitado.
/// ⚠️ SIN accountId a propósito: es config de PLATAFORMA, no de una cuenta.
model RealtyPlanConfig {
  planId          String   @id
  name            String
  priceMonthly    Decimal  @db.Decimal(10, 2)
  priceYearly     Decimal? @db.Decimal(10, 2)
  maxUsers        Int      @default(1)
  maxOffices      Int      @default(1)
  maxProperties   Int      @default(-1)
  /// Cupo de archivos en MEGABYTES.
  storageQuotaMb  Int      @default(2048)
  /// 0 = el plan NO incluye WhatsApp (el de $199 no lo tiene).
  messageQuota    Int      @default(0)
  features        Json
  stripeLookupKey String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  @@map("realty_plan_configs")
}

/// Código de un solo uso para que el CLIENTE FINAL (inquilino, propietario)
/// entre a su portal con su teléfono. codeHash: el código en claro JAMÁS se
/// guarda ni sale del servidor. attempts frena la fuerza bruta.
model RealtyClientAuthToken {
  id        String    @id @default(cuid())
  accountId String
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, phone, expiresAt])
  @@map("realty_client_auth_tokens")
}

/// Ticket de la cuenta a soporte DaleControl. category es String con
/// catálogo en REALTY_TICKET_CATEGORIES (como el dental y barber).
model RealtySupportTicket {
  id              String               @id @default(cuid())
  accountId       String
  subject         String
  category        String               @default("DUDA")
  status          RealtyTicketStatus   @default(OPEN)
  priority        RealtyTicketPriority @default(NORMAL)
  lastMessageAt   DateTime             @default(now())
  closedAt        DateTime?
  createdByUserId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  account   RealtyAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy RealtyUser?            @relation("RealtySupportTicketCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  messages  RealtySupportMessage[]

  @@index([accountId, status, lastMessageAt])
  // El panel de DaleControl mira los tickets abiertos de TODAS las cuentas:
  // ese barrido no puede empezar por accountId.
  @@index([status, lastMessageAt])
  @@map("realty_support_tickets")
}

/// Mensaje del ticket. attachments: [{ path, name, size, type }] en el
/// bucket realty-files. authorUserId de un ADMIN no tiene FK (el admin de
/// DaleControl no vive en las tablas del vertical).
model RealtySupportMessage {
  id           String             @id @default(cuid())
  accountId    String
  ticketId     String
  authorType   RealtyTicketAuthor @default(AGENCY)
  authorUserId String?
  body         String             @db.Text
  attachments  Json               @default("[]")
  createdAt    DateTime           @default(now())

  account RealtyAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ticket  RealtySupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([accountId, ticketId, createdAt])
  @@map("realty_support_messages")
}

/// Bitácora de lo que el admin de DaleControl le hace a una cuenta
/// (suspender, cambiar de plan, subir un cupo). adminUserId SIN FK a
/// propósito: el admin vive en las tablas de plataforma, no aquí.
model RealtyAdminAction {
  id          String   @id @default(cuid())
  accountId   String
  adminUserId String?
  action      String
  payload     Json?
  createdAt   DateTime @default(now())

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("realty_admin_actions")
}

/// Parámetros de las CALCULADORAS mexicanas (ISAI por estado, UMA, UDI,
/// INPC, tasas de Infonavit/Fovissste).
///
/// 🔴 CAMBIAN CADA AÑO: la UMA se publica en enero y el ISAI lo fija cada
/// congreso estatal. Por eso viven en tabla EDITABLE y jamás quemados en el
/// código. effectiveFrom permite que el valor viejo y el nuevo convivan y
/// que una operación se calcule con el que estaba vigente ese día.
///
/// stateCode es NOT NULL con default "MX" (= federal) A PROPÓSITO: en un
/// índice único de Postgres cada NULL cuenta como distinto, así que con la
/// columna nullable el único de abajo no serviría de nada.
///
/// El único SÍ incluye effectiveFrom, o sea que PERMITE dos valores del mismo
/// año con vigencias distintas — eso es a propósito (un congreso estatal
/// puede cambiar el ISAI a media anualidad). Lo que impide es capturar DOS
/// VECES el mismo valor con la misma vigencia. Para saber cuál aplica a una
/// operación se toma el de effectiveFrom más reciente que sea <= la fecha de
/// la operación; NUNCA se asume que hay uno solo por año.
///
/// ⚠️ SIN accountId a propósito: son parámetros de PLATAFORMA que comparten
/// todas las cuentas.
model RealtyCalcParam {
  id            String              @id @default(cuid())
  kind          RealtyCalcParamKind
  stateCode     String              @default("MX")
  year          Int
  value         Decimal             @db.Decimal(14, 6)
  meta          Json?
  effectiveFrom DateTime
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([kind, stateCode, year, effectiveFrom])
  @@index([kind, stateCode, year])
  @@map("realty_calc_params")
}

// ── Cumplimiento antilavado (PLD / LFPIORPI) ───────────────────────────
//
// 🔴 QUÉ ES Y QUÉ NO ES ESTE MÓDULO. Es un EXPEDIENTE y unas ALERTAS: junta
// los papeles, compara contra el umbral vigente y arma el archivo para que
// el cliente lo suba. NO presenta avisos ante el SAT, no dictamina y no
// sustituye a un despacho. Si el cliente incumple, la multa es suya. Ningún
// texto de estas pantallas puede decir lo contrario.
//
// 🔴 CERO NÚMEROS DE LA LEY EN EL SCHEMA. Los umbrales (8 025 y 16 000 UMA),
// la UMA diaria, el día de corte, las 24 horas y los 10 años de conservación
// viven en realty_calc_params (kind = UMA, stateCode = "MX") y se editan en
// /admin/inmobiliarias/parametros. Aquí solo se guardan RESULTADOS y
// DECISIONES de una persona, nunca la regla.
//
// Aislamiento: accountId en TODAS las tablas, como el resto del vertical.

/// Persona física, moral o fideicomiso: cambia QUÉ papeles pide el
/// expediente (una moral debe declarar beneficiario controlador).
enum RealtyPldPersonKind {
  FISICA
  MORAL
  FIDEICOMISO
}

/// Relación de la persona con un cargo público. La reforma publicada el
/// 27 de marzo de 2026 obliga a identificar PEP en actividades vulnerables,
/// y el familiar o el asociado cercano cuentan igual que el titular.
enum RealtyPldPepKind {
  NO
  PEP
  FAMILIAR
  ASOCIADO
}

/// Grado de riesgo del expediente. Se CALCULA (ver riesgoDeExpediente en
/// src/lib/realty/pld/umbrales.ts) y se guarda para poder ordenar y filtrar
/// sin recalcular la cartera entera en cada pintada.
enum RealtyPldRisk {
  BAJO
  MEDIO
  ALTO
}

/// Los papeles que puede llevar un expediente. IDENTIFICACION y
/// COMPROBANTE_DOMICILIO son los dos que casi siempre se piden; el resto
/// depende del tipo de persona.
enum RealtyPldDocKind {
  IDENTIFICACION
  COMPROBANTE_DOMICILIO
  CONSTANCIA_FISCAL
  CURP
  ACTA_CONSTITUTIVA
  PODER
  BENEFICIARIO_CONTROLADOR
  OTRO
}

/// NORMAL = hubo operaciones que avisar. EN_CEROS = no hubo, y aun así hay
/// que reportarlo: es el error más caro y más fácil de cometer.
enum RealtyPldNoticeKind {
  NORMAL
  EN_CEROS
}

/// PENDIENTE nace solo; PRESENTADO lo marca una persona después de subirlo
/// en el portal del SAT. DaleControl nunca lo pone por su cuenta.
enum RealtyPldNoticeStatus {
  PENDIENTE
  PRESENTADO
}

/// Qué se consultó. La bóveda de diez años exige poder decir quién vio qué
/// papel y cuándo.
enum RealtyPldAccessAction {
  VER_EXPEDIENTE
  ABRIR_DOCUMENTO
  DESCARGAR_AVISO
  ARCHIVAR_DOCUMENTO
}

/// El EXPEDIENTE de identificación de un cliente. Uno por contacto y por
/// cuenta: la misma persona puede aparecer en varias operaciones y el
/// expediente se integra UNA vez.
///
/// `status` NO es una columna: el estado (incompleto / completo / vencido)
/// se calcula con estadoDeExpediente() a partir de los papeles que hay y de
/// sus vigencias. Guardarlo sería tener dos verdades.
model RealtyPldFile {
  id         String              @id @default(cuid())
  accountId  String
  contactId  String
  personKind RealtyPldPersonKind @default(FISICA)

  /// Datos de identificación. Nullable a propósito: un expediente se empieza
  /// con lo que hay y la pantalla dice qué falta.
  rfc         String?
  curp        String?
  birthDate   DateTime?
  nationality String?
  /// Ocupación, profesión, actividad o giro del negocio.
  occupation  String?
  /// Domicilio declarado. Es el del expediente, NO el del inmueble.
  address     String?

  /// Semáforo PEP. pepDetail guarda el cargo, el ente y el parentesco.
  pep          RealtyPldPepKind @default(NO)
  pepDetail    String?          @db.Text
  /// Cuándo se le PREGUNTÓ. Sin fecha, el cuestionario no está contestado:
  /// "NO" por omisión y "NO" declarado no son lo mismo.
  pepAskedAt   DateTime?

  /// Beneficiario controlador de una persona moral o fideicomiso:
  /// [{ name, rfc, curp, pct, pep }]. Json y no tabla porque son dos o tres
  /// renglones que solo se leen junto con el expediente (mismo patrón que
  /// RealtySupportMessage.attachments).
  beneficialOwners Json?

  /// Riesgo calculado y su sello de tiempo.
  risk        RealtyPldRisk @default(BAJO)
  riskNote    String?       @db.Text

  /// Última revisión humana del expediente.
  reviewedAt     DateTime?
  /// Sin FK a RealtyUser A PROPÓSITO: un expediente de cumplimiento tiene que
  /// sobrevivir a que la persona que lo revisó deje la inmobiliaria. Se
  /// guarda también el nombre para que la bitácora se lea dentro de 10 años.
  reviewedById   String?
  reviewedByName String?

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Cascade y no NoAction: con NoAction, borrar una CUENTA entera podía
  // fallar por el orden en que Postgres resuelve los cascades. La retención
  // de diez años se hace valer en la aplicación (los documentos se ARCHIVAN,
  // no se borran) — ver puedeBorrarDocumento en src/lib/realty/pld/.
  contact RealtyContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  documents RealtyPldDocument[]
  accesses  RealtyPldAccessLog[]

  /// Un expediente por persona y por cuenta.
  @@unique([accountId, contactId])
  @@index([accountId, risk])
  @@index([accountId, pep])
  @@index([contactId])
  @@map("realty_pld_files")
}

/// Un papel del expediente, en el bucket PRIVADO realty-files.
///
/// 🔴 BÓVEDA DE DIEZ AÑOS: `retainUntil` se calcula al subir, con el plazo
/// que diga el parámetro vigente. Mientras esa fecha no pase, la UI NO
/// BORRA: archiva (archivedAt). El objeto sigue en el bucket.
model RealtyPldDocument {
  id        String           @id @default(cuid())
  accountId String
  fileId    String
  kind      RealtyPldDocKind @default(OTRO)
  name      String
  /// PATH interno del bucket, NUNCA una URL firmada (una firma guardada en
  /// la columna queda muerta, y si acaba en una página cacheada se publica).
  url       String
  bytes     Int              @default(0)

  /// Vigencia del papel. Un comprobante de domicilio de hace tres años no
  /// integra el expediente aunque esté subido.
  issuedAt  DateTime?
  expiresAt DateTime?

  /// Hasta cuándo hay que conservarlo. Se calcula al subir.
  retainUntil DateTime
  /// Archivado desde la UI. El renglón y el objeto SIGUEN existiendo.
  archivedAt  DateTime?

  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime @default(now())

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  file    RealtyPldFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  accesses RealtyPldAccessLog[]

  @@index([accountId, fileId])
  @@index([accountId, expiresAt])
  @@index([accountId, retainUntil])
  @@map("realty_pld_documents")
}

/// Quién consultó qué y cuándo. Es la mitad auditable de la bóveda.
///
/// SIN FK a RealtyUser ni onDelete que lo toque: una bitácora que se borra
/// con su autor no es una bitácora. Se guarda el nombre en el renglón.
model RealtyPldAccessLog {
  id         String                @id @default(cuid())
  accountId  String
  action     RealtyPldAccessAction
  fileId     String?
  documentId String?
  /// Para DESCARGAR_AVISO: el periodo o la operación de la que se bajó.
  subject    String?

  userId    String?
  userName  String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  account  RealtyAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  file     RealtyPldFile?     @relation(fields: [fileId], references: [id], onDelete: SetNull)
  document RealtyPldDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([accountId, fileId, createdAt])
  @@index([documentId])
  @@map("realty_pld_access_logs")
}

/// La cara PLD de una operación (RealtyDeal). No duplica el monto ni el
/// umbral: eso se calcula en vivo contra el parámetro vigente. Aquí solo
/// viven las DECISIONES de una persona.
model RealtyPldOperation {
  id        String @id @default(cuid())
  accountId String
  dealId    String

  /// EFECTIVO DECLARADO A MANO, en pesos.
  ///
  /// La fuente normal del efectivo NO es esta columna: es la suma de los
  /// RealtyPayment de la operación con `method = EFECTIVO`, que es dinero
  /// que alguien capturó de verdad. Esta columna existe para la operación
  /// cuyos pagos no se registraron en DaleControl y aun así hay que
  /// declarar cuánto se liquidó en efectivo.
  ///
  /// 🔴 PRECEDENCIA: si está capturada, MANDA sobre la suma de pagos — no
  /// se suman. Sumarlas contaría dos veces el mismo billete y dispararía
  /// una bandera roja falsa; y una bandera roja que resulta ser falsa es
  /// la forma más rápida de que dejen de creerle a las banderas.
  cashDeclared Decimal? @db.Decimal(14, 2)

  /// Efectivo capturado por encima del tope: quién lo vio y qué dijo. La
  /// bandera roja NO se apaga; se deja constancia de que se revisó.
  cashAckAt   DateTime?
  cashAckById String?
  cashAckNote String?   @db.Text

  /// Alerta de 24 horas (indicios o coincidencia con listas). dueAt se
  /// calcula con el plazo del parámetro, no con un 24 escrito aquí.
  urgentFlaggedAt DateTime?
  urgentReason    String?   @db.Text
  urgentDueAt     DateTime?
  urgentDoneAt    DateTime?

  /// El aviso mensual en el que se reportó, si ya se reportó.
  noticeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account RealtyAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deal    RealtyDeal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  notice  RealtyPldNotice? @relation(fields: [noticeId], references: [id], onDelete: SetNull)

  /// Una fila PLD por operación.
  @@unique([accountId, dealId])
  @@index([accountId, urgentDueAt])
  @@index([dealId])
  @@index([noticeId])
  @@map("realty_pld_operations")
}

/// El aviso MENSUAL. periodMonth = "AAAA-MM" del mes que se reporta; el
/// plazo vence el día que diga el parámetro del mes SIGUIENTE.
///
/// EN_CEROS existe porque un mes sin operaciones TAMBIÉN se reporta.
model RealtyPldNotice {
  id          String                @id @default(cuid())
  accountId   String
  periodMonth String
  kind        RealtyPldNoticeKind   @default(NORMAL)
  status      RealtyPldNoticeStatus @default(PENDIENTE)
  /// Fecha límite calculada al crear la fila, con el parámetro vigente.
  dueDate     DateTime

  /// Lo marca una PERSONA después de subirlo en el portal del SAT.
  presentedAt     DateTime?
  presentedById   String?
  presentedByName String?
  /// Acuse que devuelve el portal. Texto libre: el formato lo pone el SAT.
  acuse           String?

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account    RealtyAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  operations RealtyPldOperation[]

  /// Un aviso por mes y por cuenta.
  @@unique([accountId, periodMonth])
  @@index([accountId, status, dueDate])
  @@map("realty_pld_notices")
}

// ═══════════════════════════════════════════════════════════════════════
// CONTRATOS Y FIRMA ELECTRÓNICA (Ola 2 · T2)
//
// Cinco tablas. Están AQUÍ —y no solo en sql/realty-contratos.sql— por una
// razón concreta y ya vivida: `prisma db push` reconcilia la base con ESTE
// archivo, así que una tabla que solo existe en un .sql se la lleva por
// delante. En barber pasó. La regla del vertical es "nada vive solo en
// SQL", y estas cinco la cumplen.
//
// El módulo las CONSULTA con $queryRaw parametrizado desde
// src/lib/realty/contracts.ts (el único archivo del repo que las toca), no
// con el cliente generado: se construyeron con diez terminales trabajando
// a la vez sobre este mismo archivo, donde no hay garantía de que cada
// worktree tenga el cliente regenerado. Los nombres de columna, de índice
// y de constraint de abajo están ESCRITOS A MANO (`map:`) para que
// coincidan carácter por carácter con el .sql: los dos caminos crean
// exactamente la misma base.
//
// ⚠️ Las PLANTILLAS de contrato que trae el módulo las tiene que revisar un
// abogado antes de que un cliente firme con ellas.
// ═══════════════════════════════════════════════════════════════════════

/// Plantilla de contrato de una inmobiliaria. UNA por (cuenta, tipo).
/// Sin fila = se usa la plantilla base del código (REALTY_BASE_TEMPLATES).
model RealtyContractTemplate {
  id String @id
  accountId String
  /// ARRENDAMIENTO | EXCLUSIVA | PROMESA | COMISION
  kind String
  name String
  body String
  version Int @default(1)
  updatedByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, kind], map: "realty_contract_templates_account_kind_key")
  @@map("realty_contract_templates")
}

/// El contrato generado.
///
/// `body` es un SNAPSHOT del texto ya resuelto: el que las partes leen y
/// firman. No se vuelve a renderizar desde la plantilla, así que editarla
/// mañana no cambia lo que alguien firmó ayer.
///
/// `documentHash` es el sha256 del canónico de ESE snapshot
/// (canonicalDocument en src/lib/realty/signature.ts).
///
/// `sealedAt` es la línea que no se cruza dos veces: en cuanto se manda a
/// firmar, el cuerpo queda congelado. TODAS las escrituras al cuerpo llevan
/// `"sealedAt" IS NULL` en el WHERE, no un `if` en JavaScript.
///
/// leaseId / exclusiveId / dealId / propertyId / contactId van SIN relación
/// a propósito: un contrato firmado es prueba y tiene que sobrevivir a que
/// alguien borre la renta de la que salió. Se guarda el id y se resuelve al
/// leer; si el origen ya no está, el contrato sigue legible.
model RealtyContract {
  id String @id
  accountId String
  kind String
  folio String
  title String

  leaseId String?
  exclusiveId String?
  dealId String?
  propertyId String?
  contactId String?

  body String
  /// JSON de las variables resueltas, como TEXT (no Json): aquí no hay
  /// consultas por dentro del objeto y TEXT evita el baile de DbNull.
  variables String @default("{}")
  documentHash String

  /// BORRADOR | ENVIADO | PARCIAL | FIRMADO | ARCHIVADO | ANULADO
  status String @default("BORRADOR")

  effectiveFrom DateTime?
  effectiveTo DateTime?

  sealedAt DateTime?
  signedAt DateTime?
  archivedAt DateTime?
  voidedAt DateTime?
  voidReason String?
  /// Cuando se anula por corrección, el contrato que lo sustituye.
  replacedById String?

  createdByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  parties RealtyContractParty[]

  @@unique([accountId, folio], map: "realty_contracts_account_folio_key")
  @@index([accountId, status, createdAt], map: "realty_contracts_account_status_idx")
  @@index([accountId, effectiveTo], map: "realty_contracts_account_effectiveto_idx")
  @@index([accountId, propertyId], map: "realty_contracts_account_property_idx")
  @@index([accountId, contactId], map: "realty_contracts_account_contact_idx")
  @@index([accountId, leaseId], map: "realty_contracts_account_lease_idx")
  @@map("realty_contracts")
}

/// Quién firma. El contrato NO queda FIRMADO hasta que todas las partes con
/// `mustSign = true` tienen `signedAt`.
model RealtyContractParty {
  id String @id
  accountId String
  contractId String
  /// ARRENDADOR | INQUILINO | AVAL | PROPIETARIO | INMOBILIARIA |
  /// COMPRADOR | VENDEDOR | ASESOR
  role String
  name String
  email String?
  phone String?
  contactId String?
  mustSign Boolean @default(true)
  sortOrder Int @default(0)
  signedAt DateTime?
  signatureId String?
  createdAt DateTime @default(now())

  contract RealtyContract @relation(fields: [contractId], references: [id], onDelete: Cascade, map: "realty_contract_parties_contract_fkey")

  @@index([contractId, sortOrder], map: "realty_contract_parties_contract_idx")
  @@index([accountId], map: "realty_contract_parties_account_idx")
  @@map("realty_contract_parties")
}

/// La evidencia de cada firma.
///
/// 🔴 ESTA TABLA NO SE ACTUALIZA NUNCA. Solo INSERT y SELECT: no hay una
/// sola sentencia UPDATE ni DELETE contra ella en todo el módulo, y el
/// único por (contractId, partyId) hace que un segundo intento choque en la
/// base en vez de pisar la primera firma.
///
/// `documentHash` se duplica aquí a propósito: es el hash del texto TAL
/// COMO ESTABA cuando esta persona firmó. Si algún día no coincide con el
/// del contrato, la evidencia lo delata sola.
///
/// `strokePath` vive en el bucket privado realty-files; `strokeInline` es la
/// red de abajo si el bucket falla. Una de las dos SIEMPRE tiene algo.
///
/// SIN relación a RealtyContractParty a propósito: la evidencia no puede
/// desaparecer en cascada detrás de una fila de partes.
model RealtyContractSignature {
  id String @id
  accountId String
  contractId String
  partyId String
  signerName String
  documentHash String
  strokePath String?
  strokeInline String?
  strokeHash String
  ip String?
  userAgent String?
  /// Reloj del SERVIDOR. Jamás una fecha que venga del dispositivo.
  signedAt DateTime @default(now())
  tokenId String?
  createdAt DateTime @default(now())

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([contractId, partyId], map: "realty_contract_signatures_party_key")
  @@index([accountId, signedAt], map: "realty_contract_signatures_account_idx")
  @@map("realty_contract_signatures")
}

/// La liga de firma (/i/firmar/{token}).
///
/// 🔴 EL TOKEN EN CLARO NO SE GUARDA: solo su sha256, igual que
/// RealtyClientAuthToken.codeHash. Quien se lleve un volcado de la base no
/// puede firmar por nadie.
///
/// `attempts` cuenta los intentos de FIRMA fallidos, no las aperturas: un
/// token de 256 bits no se adivina a fuerza bruta; lo que hay que frenar es
/// que una liga filtrada se use a golpes.
model RealtySignatureToken {
  id String @id
  accountId String
  contractId String
  partyId String
  tokenHash String
  expiresAt DateTime
  attempts Int @default(0)
  usedAt DateTime?
  revokedAt DateTime?
  sentAt DateTime?
  /// whatsapp | correo | copiada
  sentVia String?
  viewedAt DateTime?
  createdAt DateTime @default(now())

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([tokenHash], map: "realty_signature_tokens_hash_key")
  @@index([contractId, partyId], map: "realty_signature_tokens_contract_idx")
  @@index([accountId, expiresAt], map: "realty_signature_tokens_account_idx")
  @@map("realty_signature_tokens")
}

// ═══════════════════════════════════════════════════════════════════════
// BOLSA INMOBILIARIA (MLS interna) — O2-T4
//
// La ÚNICA parte del producto donde una cuenta ve datos de otra. Tres
// tablas, y las tres existen para responder a una sola pregunta con una
// fila: "¿el dueño de este inmueble dijo explícitamente que sí?".
//
// 🔴 SIN RELACIONES DE PRISMA, A PROPÓSITO. Una relación obliga a declarar
// el lado inverso DENTRO de RealtyAccount y de RealtyProperty, es decir a
// editar modelos que están a mil líneas de aquí, en medio del archivo que
// se pelean siete terminales en paralelo. Estos tres bloques son
// CONTIGUOS y van al final: si otra terminal agrega los suyos también al
// final, el conflicto de git es "conserva los dos bloques" y nada más.
//
// El precio de esa decisión, dicho en voz alta: no hay ON DELETE CASCADE.
// Borrar un inmueble deja su fila de bolsa huérfana. NO es una fuga: cada
// lectura de la bolsa vuelve a leer el inmueble y la cuenta, y una fila
// huérfana simplemente no produce resultados (falla CERRADA). Quien
// cablee la limpieza es `deleteRealtyProperty`, que vive en T1.
//
// Lo que se comparte y lo que no lo decide `src/lib/realty/mls.ts`, no
// estas tablas: aquí solo vive el CONSENTIMIENTO.
// ═══════════════════════════════════════════════════════════════════════

/// Estado de un acuerdo de colaboración entre dos cuentas.
/// PROPUESTO → ACEPTADO → CERRADO es el camino feliz. RECHAZADO y
/// CANCELADO son finales, pero la fila se queda: es la memoria de que ya
/// se preguntó (y el único índice que impide volver a preguntar en bucle).
enum RealtyMlsAgreementStatus {
  PROPUESTO
  ACEPTADO
  RECHAZADO
  CANCELADO
  CERRADO
}

/// Un inmueble puesto en la bolsa por su dueño. Es el CONSENTIMIENTO
/// explícito: sin fila aquí, o con `active` en false, el inmueble no
/// existe para ninguna otra cuenta. Apagarlo lo retira de la bolsa de
/// todos en la misma consulta, sin trabajos diferidos.
///
/// `propertyId` es único GLOBAL y no `[accountId, propertyId]`: el id de
/// un inmueble ya es único en toda la base, así que el compuesto no
/// añadiría nada y en cambio obligaría a llevar las dos columnas a cada
/// upsert. La pertenencia se comprueba ANTES de escribir, contra
/// realty_properties, nunca confiando en el accountId que llegue del
/// navegador.
model RealtyMlsListing {
  id String @id @default(cuid())

  /// La cuenta que CAPTÓ el inmueble y decide compartirlo.
  accountId  String
  propertyId String @unique

  /// Lo primero que mira el otro asesor: qué parte de la comisión suelta
  /// quien captó. 0–100 con dos decimales, igual que todos los
  /// porcentajes del vertical (RealtyCommissionSplit.pct).
  sharedCommissionPct Decimal @default(0) @db.Decimal(5, 2)

  /// ¿Acepta trabajar con otro asesor? false = está en la bolsa solo para
  /// que se vea el inventario, sin colaboración.
  acceptsCollaboration Boolean @default(true)

  /// ¿Exige que el cliente lo traiga el otro asesor? true = no acepta
  /// referidos tibios, quiere comprador propio del colega.
  requiresBuyerFromPartner Boolean @default(false)

  /// Lista BLANCA de campos que este inmueble enseña en la bolsa. null =
  /// los públicos por defecto. Nunca puede AMPLIAR lo público: la reja
  /// dura vive en REALTY_MLS_PUBLIC_FIELDS (src/lib/realty/mls.ts) y esta
  /// columna solo puede RECORTAR sobre ella.
  exposedFields Json?

  /// El interruptor. false = fuera de la bolsa, de inmediato.
  active Boolean @default(true)

  /// Recado para el colega ("solo cita con cliente calificado"). Es texto
  /// que su autor ESCRIBE sabiendo que lo van a leer otras cuentas — no
  /// confundir con internalNotes del inmueble, que jamás sale.
  notes String? @db.Text

  sharedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // La consulta de la bolsa es "todo lo activo MENOS lo mío", así que el
  // índice útil empieza por active y no por accountId (al revés que el
  // resto del vertical, donde todo empieza por el inquilino).
  @@index([active, sharedAt])
  @@index([accountId, active])
  @@map("realty_mls_listings")
}

/// El acuerdo entre dos cuentas sobre UN inmueble: quién capta, quién
/// coloca, qué porcentaje y desde cuándo.
///
/// `listingAccountId` está DESNORMALIZADO a propósito: sin él, "mis
/// acuerdos como captador" obligaría a un join contra realty_mls_listings
/// en cada pantalla. Se copia al crear y no se vuelve a tocar.
///
/// Al cerrarse la operación, este acuerdo alimenta el split de comisión
/// de T8 — party EXTERNO + externalName — y guarda el `dealId` para que
/// se pueda rastrear al revés. NO hay reparto propio: el único motor de
/// comisiones del vertical es computeSplits().
model RealtyMlsAgreement {
  id        String @id @default(cuid())
  listingId String

  /// Quien CAPTA: la cuenta dueña del inmueble.
  listingAccountId String
  /// Quien COLOCA: la cuenta que trae al cliente y propone colaborar.
  partnerAccountId String
  propertyId       String

  /// Porcentaje de la comisión que se lleva QUIEN COLOCA. 0–100.
  agreedPct Decimal @default(0) @db.Decimal(5, 2)

  status RealtyMlsAgreementStatus @default(PROPUESTO)

  /// El recado de la propuesta. Lo escribe quien coloca, lo lee quien
  /// capta. Ambos saben que la otra cuenta lo va a leer.
  message String? @db.Text

  proposedAt  DateTime  @default(now())
  respondedAt DateTime?
  closedAt    DateTime?

  /// El RealtyDeal (de la cuenta que CAPTA) al que alimentó este acuerdo.
  /// null mientras no se cierre.
  dealId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un solo acuerdo por par (inmueble, cuenta que coloca). Volver a
  // proponer tras un rechazo REUSA esta fila: así nadie puede llenar la
  // bandeja del vecino a base de propuestas repetidas.
  @@unique([listingId, partnerAccountId])
  @@index([listingAccountId, status, proposedAt])
  @@index([partnerAccountId, status, proposedAt])
  @@index([propertyId])
  @@map("realty_mls_agreements")
}

/// Un inmueble AJENO que una cuenta eligió pintar en SU propia mini-web,
/// marcado "en colaboración". El formulario de esa ficha cae en el CRM de
/// quien hospeda —él atiende al prospecto— y se le avisa al dueño.
///
/// Adoptar NO es un acuerdo: es escaparate. El acuerdo se firma cuando
/// hay cliente. Por eso son dos tablas y no una.
model RealtyMlsAdoption {
  id String @id @default(cuid())

  /// La cuenta que ADOPTA (la que lo pinta en su web). NO la dueña.
  accountId  String
  listingId  String
  propertyId String

  showOnLanding Boolean @default(true)
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, listingId])
  @@index([accountId, showOnLanding, sortOrder])
  @@index([listingId])
  @@map("realty_mls_adoptions")
}

// ═══════════════════════════════════════════════════════════════════════
// INMUEBLES — CRECIMIENTO (Ola 2, terminal O2-T7)
// Bot de WhatsApp · consentimiento · campañas · vigilancia de precio ·
// investigación de inquilino · programa de socios.
//
// 🔴 ESTE BLOQUE Y `sql/realty_growth.sql` SON LA MISMA VERDAD. Nada de
// esto vive solo en SQL: los nombres de tabla (@@map), de columna, los
// tipos y las FK con onDelete: Cascade son un espejo 1:1 del .sql, para que
// `prisma migrate diff` contra una base que ya corrió el .sql salga VACÍO.
// Si cambias uno, cambia el otro en el mismo commit.
//
// La capa de datos (src/lib/realty/bot/growth-db.ts) habla con estas tablas
// por $queryRaw parametrizado y NO por el cliente tipado: se escribió para
// tolerar que el .sql todavía no se haya aplicado en producción (el panel
// dice "falta aplicar sql/realty_growth.sql" en vez de tronar). Tener aquí
// los modelos NO cambia eso — los pone en el contrato, que es donde deben
// estar, y deja el camino listo para migrarla al cliente tipado.
// ═══════════════════════════════════════════════════════════════════════

/// Configuración del BOT por cuenta.
///
/// 🔴 `enabled` y `aiDailyCapMxn` están FUERA del Json `settings` a
/// propósito: son las dos que deciden si se le habla a un prospecto en
/// nombre de la inmobiliaria y cuánto se puede gastar haciéndolo. Fuera del
/// blob se pueden inspeccionar con un SELECT y acotar con un CHECK
/// (`realty_bot_cap_bounded`, en el .sql: 0 ≤ cap ≤ 500). NO existe valor
/// "ilimitado". Nace APAGADO y CON tope.
model RealtyBotSettings {
  accountId       String   @id
  enabled         Boolean  @default(false)
  aiDailyCapMxn   Int      @default(0)
  settings        Json     @default("{}")
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("realty_bot_settings")
}

/// Gasto de IA POR CUENTA Y POR DÍA. `day` es la fecha en la ZONA DE LA
/// CUENTA, no en UTC: un tope "por día" que se reinicia a las 6 de la tarde
/// no es un tope, es una sorpresa.
///
/// costMicros: 1 peso = 1 000 000 micros. Un turno cuesta fracciones de
/// centavo y sumarlo en centavos redondeados regala el tope.
model RealtyBotSpend {
  accountId  String
  day        DateTime @db.Date
  costMicros BigInt   @default(0)
  turns      Int      @default(0)
  updatedAt  DateTime @default(now()) @updatedAt

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, day])
  @@map("realty_bot_spend")
}

/// Cada turno del bot: qué le escribieron, qué contestó y cuánto costó.
///
/// `correctedBody` es la corrección que escribe una persona desde el panel y
/// NO reescribe `outboundBody`: lo que se mandó, se mandó, y borrarlo haría
/// imposible entender por qué el bot dijo lo que dijo. Las correcciones se
/// le dan de comer al siguiente turno como reglas.
model RealtyBotTurn {
  id            String    @id
  accountId     String
  threadId      String?
  contactId     String?
  leadId        String?
  phone         String
  inboundBody   String?
  outboundBody  String?
  /// Por qué NO contestó (RealtyBotSkipReason en bot/core.ts). null = contestó.
  skipReason    String?
  handoff       Boolean   @default(false)
  handoffReason String?
  model         String?
  inputTokens   Int       @default(0)
  outputTokens  Int       @default(0)
  costMicros    BigInt    @default(0)
  /// Lo que el bot dedujo en este turno (presupuesto, crédito, zona). Se
  /// guarda aunque ya se haya escrito en el lead: es la evidencia de DÓNDE
  /// salió el dato.
  extracted     Json?
  correctedBody String?
  correctedById String?
  correctedAt   DateTime?
  createdAt     DateTime  @default(now())

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt(sort: Desc)], map: "realty_bot_turns_account_created_idx")
  @@index([threadId, createdAt(sort: Desc)], map: "realty_bot_turns_thread_idx")
  @@map("realty_bot_turns")
}

/// Conversaciones que atiende UNA PERSONA. Mientras haya fila, el bot calla
/// en ese teléfono: es lo que pasa cuando el prospecto pide humano o cuando
/// alguien del equipo toma el hilo desde el panel.
model RealtyBotPause {
  accountId String
  phone     String
  reason    String?
  pausedAt  DateTime @default(now())

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, phone])
  @@map("realty_bot_pauses")
}

/// LA BAJA. La tabla que evita que Meta le tumbe el número al cliente.
///
/// 🔴 El número de WhatsApp es DEL CLIENTE: un reporte de spam se lo tumba a
/// él, no a DaleControl. Por eso la baja es tabla propia, con único por
/// (cuenta, teléfono), y se consulta ANTES de cada envío de campaña.
///
/// La llave es el TELÉFONO y no el contactId: la misma persona puede estar
/// dos veces en la libreta y la baja es de la PERSONA, no del registro.
/// scope MARKETING = no quiere campañas (sigue recibiendo el aviso de su
/// visita). scope ALL = no quiere nada automático.
model RealtyContactOptOut {
  id        String   @id
  accountId String
  contactId String?
  /// 10 dígitos (mxTenDigits).
  phone     String
  scope     String   @default("MARKETING")
  source    String   @default("REPLY")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, phone], map: "realty_contact_optouts_account_phone_key")
  @@index([contactId], map: "realty_contact_optouts_contact_idx")
  @@map("realty_contact_optouts")
}

/// Ajustes de crecimiento por cuenta.
///
/// `campaignDailyCap` es INDEPENDIENTE del cupo del plan (messageQuota, que
/// es mensual): protege del envío masivo en un solo día, que es exactamente
/// lo que dispara los reportes de spam y las restricciones de Meta.
model RealtyGrowthSettings {
  accountId        String   @id
  googleReviewUrl  String?
  reviewsEnabled   Boolean  @default(false)
  campaignDailyCap Int      @default(100)
  priceDropEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("realty_growth_settings")
}

/// Una campaña. `segment` guarda el criterio EN CRUDO con el que se armó la
/// lista, para poder explicar a quién se le mandó y por qué meses después.
///
/// `templateKind` es la plantilla de WhatsApp (RealtyWaKind) con la que sale:
/// fuera de la ventana de 24 h no hay texto libre — o hay plantilla, o no se
/// manda. `body` es para quien SÍ tenga la ventana abierta y para la vista
/// previa.
///
/// El único parcial `realty_campaigns_price_drop_open_key` (en el .sql;
/// Prisma no modela índices parciales) deja UNA sola campaña viva de bajada
/// de precio por inmueble: sin él, tres ajustes de precio en una semana son
/// tres WhatsApps a la misma persona.
model RealtyCampaign {
  id           String    @id
  accountId    String
  name         String
  kind         String    @default("MANUAL")
  status       String    @default("BORRADOR")
  templateKind String?
  body         String?
  propertyId   String?
  segment      Json      @default("{}")
  scheduledAt  DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  account    RealtyAccount             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recipients RealtyCampaignRecipient[]

  @@index([accountId, status, scheduledAt], map: "realty_campaigns_account_status_idx")
  @@index([accountId, createdAt(sort: Desc)], map: "realty_campaigns_account_created_idx")
  @@map("realty_campaigns")
}

/// Un destinatario por fila. `status` OMITIDO + `skipReason` es lo que
/// permite enseñar "no se le mandó a 12 personas porque pidieron baja" en
/// vez de un silencio.
///
/// El único (campaignId, phone) es lo que hace el envío REENTRANTE: correr
/// la tanda dos veces NO le manda dos veces a la misma persona.
model RealtyCampaignRecipient {
  id         String    @id
  campaignId String
  accountId  String
  contactId  String?
  phone      String
  name       String?
  params     Json?
  status     String    @default("PENDIENTE")
  skipReason String?
  messageId  String?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  campaign RealtyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  account  RealtyAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([campaignId, phone], map: "realty_campaign_recipients_unique")
  @@index([campaignId, status], map: "realty_campaign_recipients_pending_idx")
  @@index([accountId, sentAt], map: "realty_campaign_recipients_account_sent_idx")
  @@map("realty_campaign_recipients")
}

/// Vigilancia de precio: el disparador de "bajó de precio la casa que viste".
///
/// 🔴 POR QUÉ EXISTE: `RealtyProperty.price` se PISA al editarlo — el
/// vertical no guarda histórico de precio. Así que la vigilancia lleva su
/// propia foto del último precio visto: el barrido compara y, si BAJÓ, arma
/// la campaña. La PRIMERA corrida solo toma la foto (sin precio anterior no
/// hay bajada, y fabricar una habría mandado un WhatsApp a media cartera el
/// día del estreno).
model RealtyPropertyPriceWatch {
  propertyId   String    @id
  accountId    String
  /// Precio de la operación que anuncia, en la moneda del inmueble.
  lastPrice    Decimal   @db.Decimal(14, 2)
  currency     String    @default("MXN")
  operation    String    @default("VENTA")
  lastDropAt   DateTime?
  lastDropFrom Decimal?  @db.Decimal(14, 2)
  checkedAt    DateTime  @default(now())

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, checkedAt], map: "realty_price_watch_account_idx")
  @@map("realty_property_price_watch")
}

/// INVESTIGACIÓN DE INQUILINO — ingreso que no depende de la suscripción.
///
/// 🔴 CONSULTAR EL BURÓ SIN PERMISO DEL INVESTIGADO ES ILEGAL (LFPDPPP art.
/// 8 y Ley para Regular las Sociedades de Información Crediticia art. 28: la
/// consulta necesita autorización EXPRESA). Por eso el consentimiento no es
/// un checkbox: se guarda el TEXTO que aceptó, con fecha, nombre e IP, y la
/// base lo repite con el CHECK `realty_screening_needs_consent` — sin
/// `consentAt` la solicitud no sale de PENDIENTE_CONSENTIMIENTO. Un bug de
/// UI no puede saltárselo.
///
/// `provider` es MANUAL hoy (la tramita alguien de DaleControl y sube el
/// resultado). El adaptador para enchufar una API vive en
/// src/lib/realty/screening.ts (RealtyScreeningProvider) y `providerRef`
/// ya guarda el folio del tercero.
///
/// `applicant` lleva lo MÍNIMO (nombre, ingreso declarado, empleo,
/// referencias). Aquí NO se guardan documentos de identidad ni números de
/// cuenta: eso viaja al proveedor y vuelve como resultado.
model RealtyScreeningRequest {
  id               String    @id
  accountId        String
  contactId        String
  leaseId          String?
  leasePartyId     String?
  propertyId       String?
  tier             String    @default("BASICA")
  provider         String    @default("MANUAL")
  providerRef      String?
  status           String    @default("PENDIENTE_CONSENTIMIENTO")
  consentText      String?
  consentAt        DateTime?
  consentName      String?
  consentIp        String?
  consentUserAgent String?
  applicant        Json      @default("{}")
  priceCents       Int?
  currency         String    @default("MXN")
  resultUrl        String?
  resultSummary    String?
  riskLevel        String?
  recommendation   String?
  requestedById    String?
  requestedAt      DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  account RealtyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status, createdAt(sort: Desc)], map: "realty_screening_account_status_idx")
  @@index([contactId, createdAt(sort: Desc)], map: "realty_screening_contact_idx")
  @@index([leaseId], map: "realty_screening_lease_idx")
  @@map("realty_screening_requests")
}

/// PROGRAMA DE SOCIOS — configuración de PLATAFORMA, no de una cuenta: una
/// sola fila con id = 'default' (mismo criterio que RealtyPlanConfig, sin
/// accountId a propósito). El monto es EDITABLE desde el admin sin redeploy:
/// cero pesos escritos en el código.
///
/// `commissionMonths` = -1 significa "mientras la referida siga pagando"
/// (mismo criterio de ilimitado que el resto del vertical).
model RealtyAffiliateConfig {
  id               String   @id @default("default")
  enabled          Boolean  @default(true)
  /// Porcentaje de la mensualidad de la cuenta referida.
  commissionPct    Decimal  @default(20) @db.Decimal(5, 2)
  commissionMonths Int      @default(12)
  /// Días que dura la cookie de atribución.
  cookieDays       Int      @default(60)
  /// Mínimo para poder solicitar pago, en centavos.
  payoutMinCents   Int      @default(50000)
  terms            String?
  updatedAt        DateTime @default(now()) @updatedAt

  @@map("realty_affiliate_config")
}

/// EL SOCIO. Hoy siempre es una cuenta de inmuebles que recomienda a otra
/// (espejo de barber). Una cuenta, un código.
model RealtyAffiliate {
  id         String   @id
  accountId  String   @unique(map: "realty_affiliates_account_key")
  code       String   @unique(map: "realty_affiliates_code_key")
  status     String   @default("ACTIVO")
  payoutInfo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  account     RealtyAccount               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  referrals   RealtyAffiliateReferral[]
  commissions RealtyAffiliateCommission[]

  @@map("realty_affiliates")
}

/// Clics de atribución. `vid` es el id anónimo del visitante (cookie); el
/// único por (code, vid, día) evita que F5 infle el contador.
///
/// NO se guarda la IP en claro: solo un hash, y sirve para detectar bots.
/// SIN accountId a propósito: el clic ocurre ANTES de que exista cuenta.
model RealtyAffiliateClick {
  id        String   @id
  code      String
  vid       String
  day       DateTime @db.Date
  ipHash    String?
  userAgent String?
  isBot     Boolean  @default(false)
  landedAt  DateTime @default(now())

  @@unique([code, vid, day], map: "realty_affiliate_clicks_dedupe")
  @@index([code, landedAt(sort: Desc)], map: "realty_affiliate_clicks_code_idx")
  @@map("realty_affiliate_clicks")
}

/// La cuenta referida. Único por cuenta referida: una cuenta tiene UN
/// padrino y no se lo puede robar otro socio después.
model RealtyAffiliateReferral {
  id                String    @id
  affiliateId       String
  referredAccountId String    @unique(map: "realty_affiliate_referrals_account_key")
  attributedAt      DateTime  @default(now())
  firstPaidAt       DateTime?
  createdAt         DateTime  @default(now())

  affiliate       RealtyAffiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredAccount RealtyAccount   @relation(fields: [referredAccountId], references: [id], onDelete: Cascade)

  @@index([affiliateId, attributedAt(sort: Desc)], map: "realty_affiliate_referrals_affiliate_idx")
  @@map("realty_affiliate_referrals")
}

/// La comisión DEVENGADA. Nace cuando la cuenta referida PAGA (espejo de
/// barber: al pagar, no al registrarse). PENDIENTE → APROBADA → PAGADA, o
/// CANCELADA por reembolso.
///
/// `sourceRef` es ÚNICO (índice parcial en el .sql, solo sobre los no nulos):
/// el webhook de Stripe REENTREGA, y sin esto cada reentrega devengaba otra
/// comisión.
model RealtyAffiliateCommission {
  id                String    @id
  affiliateId       String
  referredAccountId String
  amountCents       Int
  currency          String    @default("MXN")
  baseCents         Int       @default(0)
  commissionPct     Decimal   @default(0) @db.Decimal(5, 2)
  /// "YYYY-MM" del mes que se cobró.
  periodMonth       String
  status            String    @default("PENDIENTE")
  sourceRef         String?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  affiliate       RealtyAffiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredAccount RealtyAccount   @relation(fields: [referredAccountId], references: [id], onDelete: Cascade)

  @@index([affiliateId, status, createdAt(sort: Desc)], map: "realty_affiliate_commissions_affiliate_idx")
  @@map("realty_affiliate_commissions")
}

// ═══════════════════════════════════════════════════════════════════════
// DaleControl INSTITUCIONAL — escuelas de especialidades odontológicas.
// Producto SEPARADO del dental (Ola 0). Hermano de Barber* y Realty*.
//
// Multi-tenant: institutionId sale SIEMPRE de la sesión (getEduContext en
// src/lib/edu-auth.ts), NUNCA del body/query. Ojo Prisma: un institutionId
// undefined BORRA el filtro de tenant — jamás dejar pasar un undefined a un
// where.
//
// Estos modelos son ADITIVOS: no tocan ni una columna del dental, que está
// vivo en producción. El .sql equivalente e idempotente vive en
// sql/edu-ola-0.sql y hay que aplicarlo a mano en Supabase.
// ═══════════════════════════════════════════════════════════════════════

/// Rol dentro del instituto. DIRECCION manda; DOCENTE es el profesor que
/// supervisa y autoriza; ALUMNO es el residente que atiende; CAJA cobra.
enum EduRole {
  DIRECCION
  DOCENTE
  ALUMNO
  CAJA
}

/// El instituto (tenant raíz del vertical).
model EduInstitution {
  id        String  @id @default(cuid())
  name      String  @db.VarChar(160)
  slug      String  @unique @db.VarChar(80)
  legalName String? @db.VarChar(200)
  rfc       String? @db.VarChar(13)
  city      String? @db.VarChar(80)
  state     String? @db.VarChar(80)
  phone     String? @db.VarChar(30)
  email     String? @db.VarChar(160)
  logoUrl   String?
  /// Zona horaria del instituto. El default es Ciudad de México porque
  /// esto es un producto GENÉRICO para cualquier escuela del país, no
  /// para una de Tijuana. Cambiar el default NO reescribe las filas que
  /// ya existen: sql/edu-ola-1.sql solo mueve el DEFAULT de la columna.
  timezone  String  @default("America/Mexico_City") @db.VarChar(60)
  isActive  Boolean @default(true)

  // Contrato institucional. NO pasa por Stripe ni por el gate de plan del
  // dental: se administra a mano. Si contractEndsAt queda en el pasado, el
  // panel avisa pero NO corta el acceso — 120 alumnos con pacientes en el
  // sillón no se quedan fuera por una fecha vencida.
  contractStartsAt DateTime?
  contractEndsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users        EduUser[]
  programs     EduProgram[]
  cohorts      EduCohort[]
  students     EduStudent[]
  supervisions EduSupervisorAssignment[]
  // Ola 2 · el piso clínico.
  patients        EduPatient[]
  chairs          EduChair[]
  chairSchedules  EduChairSchedule[]
  cases           EduCase[]
  appointments    EduAppointment[]
  // Ola 3 · el expediente clínico.
  records           EduRecord[]
  odontogramEntries EduOdontogramEntry[]
  studies           EduStudy[]

  @@map("edu_institutions")
}

/// Persona con login en el instituto. Espejo de BarberUser/RealtyUser:
/// supabaseId es la identidad de Supabase Auth y el par
/// (supabaseId, institutionId) es único, así que una misma persona puede
/// existir en dos institutos sin pisarse.
model EduUser {
  id            String  @id @default(cuid())
  institutionId String
  supabaseId    String
  email         String  @db.VarChar(160)
  firstName     String  @db.VarChar(80)
  lastName      String  @db.VarChar(80)
  role          EduRole
  phone         String? @db.VarChar(30)
  avatarUrl     String?
  isActive      Boolean @default(true)
  mustChangePassword  Boolean  @default(false)
  /// Si trae keys, REEMPLAZAN al default del rol (no se suman). Misma
  /// semántica que User.permissionsOverride del dental — ver
  /// src/lib/edu/permissions.ts.
  permissionsOverride String[] @default([])
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution EduInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  /// Ficha académica. Solo la tienen los ALUMNO, y es 1:1: una persona
  /// no puede estar inscrita dos veces en el mismo instituto.
  studentProfile EduStudent?
  /// Alumnos que esta persona supervisa como DOCENTE. Lleva VIGENCIA:
  /// una fila con endsAt en el pasado ya no cuenta (ver EduSupervisorAssignment).
  supervisees    EduSupervisorAssignment[] @relation("EduSupervisor")

  /// Ola 2. Casos y citas en los que esta persona figura como DOCENTE
  /// responsable, y pacientes a los que le marcó el origen. Son columnas
  /// de registro: la visibilidad del docente NO se calcula con ellas sino
  /// con la asignación vigente de arriba (ver src/lib/edu/visibility.ts).
  casesSupervised        EduCase[]        @relation("EduCaseSupervisor")
  appointmentsSupervised EduAppointment[] @relation("EduApptSupervisor")
  patientOriginsSet      EduPatient[]     @relation("EduPatientOriginSetBy")

  /// Ola 3. NOM-004: el AUTOR de una nota clínica siempre es identificable,
  /// y es un EduUser (no un EduStudent) porque también escribe el docente.
  /// `recordsSigned` guarda quién la firmó — que puede no ser el que la
  /// escribió, y es justo lo que hay que poder contestar dentro de un año.
  recordsAuthored   EduRecord[]          @relation("EduRecordAuthor")
  recordsSigned     EduRecord[]          @relation("EduRecordSigner")
  odontogramEntries EduOdontogramEntry[] @relation("EduOdontogramRecorder")
  studiesUploaded   EduStudy[]           @relation("EduStudyUploader")

  @@unique([supabaseId, institutionId])
  @@index([supabaseId])
  @@index([institutionId, role, isActive])
  @@map("edu_users")
}

// ═══════════════════════════════════════════════════════════════════════
// INSTITUCIONAL — Ola 1A · EL PADRÓN ACADÉMICO.
//
// Cuatro tablas: la especialidad (EduProgram), la generación (EduCohort),
// la ficha del alumno (EduStudent, 1:1 con EduUser) y la asignación
// alumno↔docente (EduSupervisorAssignment, CON VIGENCIA).
//
// 🔴 institutionId está en las CUATRO a propósito, aunque se pudiera
// deducir subiendo por la relación: TODA consulta del vertical filtra por
// el institutionId de la sesión y un filtro que necesita un JOIN para
// existir es un filtro que alguien va a olvidar. Ojo Prisma: un
// institutionId undefined BORRA el filtro y una escuela ve el padrón de
// otra.
//
// ⚠️ NADA de esto se BORRA desde el producto: los programas y las
// generaciones se DESACTIVAN (isActive) y los alumnos cambian de status.
// Por eso los onDelete son Cascade — para que borrar un instituto entero
// (operación de administración, no del panel) no se atore en una FK. Si
// una ola futura agrega un botón de borrar programa, tiene que comprobar
// ANTES que no le queden alumnos: el Cascade se los llevaría.
//
// El .sql idempotente equivalente vive en sql/edu-ola-1.sql y hay que
// aplicarlo a mano en Supabase.
// ═══════════════════════════════════════════════════════════════════════

/// Estado académico del alumno. Darse de baja NO borra la ficha: el padrón
/// es un registro histórico y los actos clínicos que ese alumno hizo
/// siguieron ocurriendo.
enum EduStudentStatus {
  ACTIVE
  ON_LEAVE
  GRADUATED
  WITHDRAWN
}

/// Especialidad académica que imparte el instituto: Endodoncia,
/// Ortodoncia, Periodoncia… `code` es la clave corta que la escuela ya usa
/// en sus papeles, y es única DENTRO del instituto (dos escuelas pueden
/// llamarle "ENDO" a la suya sin pisarse).
model EduProgram {
  id                String   @id @default(cuid())
  institutionId     String
  name              String   @db.VarChar(120)
  code              String   @db.VarChar(20)
  durationSemesters Int      @default(6)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  institution EduInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  cohorts     EduCohort[]
  students    EduStudent[]
  /// Ola 2: el caso clínico cuelga de la especialidad.
  cases       EduCase[]

  @@unique([institutionId, code])
  @@index([institutionId, isActive])
  @@map("edu_programs")
}

/// Generación de una especialidad: "2026-A". El nombre es único dentro del
/// par (instituto, programa) — la "2026-A" de Endodoncia y la "2026-A" de
/// Ortodoncia son dos generaciones distintas.
model EduCohort {
  id            String    @id @default(cuid())
  institutionId String
  programId     String
  name          String    @db.VarChar(60)
  startDate     DateTime
  /// null = todavía no termina. Es fecha de CALENDARIO: se guarda a
  /// medianoche y se pinta en UTC (ver formatEduContractDate) para que el
  /// 31 de diciembre no salga "30 de diciembre" en una zona UTC−.
  endDate       DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  institution EduInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  program     EduProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  students    EduStudent[]

  @@unique([institutionId, programId, name])
  @@index([institutionId, isActive])
  @@map("edu_cohorts")
}

/// Ficha académica del alumno. Es 1:1 con EduUser: el login lo da la ola
/// de Equipo, esta ola le cuelga la matrícula, el programa y la generación.
///
/// ⚠️ institutionId y user.institutionId TIENEN que coincidir. Prisma no
/// puede exigirlo (haría falta una FK compuesta), así que lo garantiza el
/// código: la ficha se crea SIEMPRE con el institutionId de la sesión y
/// buscando al EduUser dentro de ese mismo instituto.
model EduStudent {
  id            String           @id @default(cuid())
  institutionId String
  userId        String           @unique
  programId     String
  cohortId      String
  matricula     String           @db.VarChar(30)
  semester      Int              @default(1)
  status        EduStudentStatus @default(ACTIVE)
  enrolledAt    DateTime         @default(now())
  graduatedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  institution EduInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        EduUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  program     EduProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  cohort      EduCohort      @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  supervisors EduSupervisorAssignment[]
  /// Ola 2: lo que este alumno lleva en el piso clínico.
  cases            EduCase[]
  appointments     EduAppointment[]
  /// Pacientes que ESTE alumno trajo a la clínica. En la Ola 5 decide el
  /// precio, por eso se guarda desde ahora.
  referredPatients EduPatient[] @relation("EduPatientReferrer")
  /// Ola 3: las notas clínicas de sus casos. Es el alumno RESPONSABLE del
  /// acto clínico, no necesariamente quien tecleó la nota (eso es
  /// EduRecord.authorUserId).
  records          EduRecord[]

  @@unique([institutionId, matricula])
  @@index([institutionId, status])
  @@index([institutionId, cohortId, status])
  @@map("edu_students")
}

/// Alumno ↔ docente, CON VIGENCIA.
///
/// 🔴 El endsAt existe a propósito y no es un lujo: el docente ROTA a media
/// generación. Sin vigencia no se puede contestar "¿quién supervisaba a
/// este alumno el día que pasó esto?", que es exactamente la pregunta que
/// se hace cuando algo sale mal en el sillón. Por eso las asignaciones NO
/// se borran ni se editan al rotar: se cierran (endsAt = ahora) y se abre
/// una nueva.
///
/// Vigente en el instante T ⇔ startsAt <= T && (endsAt == null || endsAt > T).
/// Ese predicado vive UNA sola vez, en src/lib/edu/padron-core.ts, y de ahí
/// lo usan la UI, las consultas y las pruebas.
model EduSupervisorAssignment {
  id               String    @id @default(cuid())
  institutionId    String
  studentId        String
  /// EduUser con rol DOCENTE. Lo comprueba el endpoint que asigna: el
  /// schema no puede exigir un rol.
  supervisorUserId String
  isPrimary        Boolean   @default(true)
  startsAt         DateTime  @default(now())
  /// null = vigente. Cerrar es escribir aquí, nunca borrar la fila.
  endsAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  institution EduInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student     EduStudent     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  supervisor  EduUser        @relation("EduSupervisor", fields: [supervisorUserId], references: [id], onDelete: Cascade)

  // Los nombres van EXPLÍCITOS porque el que Prisma generaría solo
  // (edu_supervisor_assignments_institutionId_supervisorUserId_endsAt_idx)
  // pasa de los 63 caracteres que admite un identificador de Postgres. Con
  // el map puestos aquí y en sql/edu-ola-1.sql, los dos dicen lo mismo.
  @@index([institutionId, supervisorUserId, endsAt], map: "edu_supervisor_assignments_supervisor_idx")
  @@index([institutionId, studentId, endsAt], map: "edu_supervisor_assignments_student_idx")
  @@map("edu_supervisor_assignments")
}

// ═══════════════════════════════════════════════════════════════════════
// INSTITUCIONAL — Ola 2 · EL PISO CLÍNICO.
//
// Cinco tablas: el paciente de la escuela (EduPatient), la unidad dental
// (EduChair) con su horario (EduChairSchedule), EL CASO (EduCase) y la
// cita (EduAppointment).
//
// 🔴 institutionId está en las CINCO, igual que en la Ola 1A y por la
// misma razón: TODA consulta del vertical filtra por el institutionId de
// la SESIÓN, y un filtro que necesita un JOIN para existir es un filtro
// que alguien va a olvidar. Ojo Prisma: un institutionId undefined BORRA
// el filtro y una escuela ve los pacientes de otra.
//
// 🔴 QUIÉN VE QUÉ no se decide aquí ni en cada consulta suelta: hay UN
// helper, src/lib/edu/visibility.ts, y todas las lecturas de estas cinco
// tablas pasan por él. ALUMNO ve lo suyo; DOCENTE lo de los alumnos que
// supervisa CON ASIGNACIÓN VIGENTE; CAJA todos los pacientes y toda la
// agenda pero NINGÚN caso; DIRECCION todo.
//
// ⚠️ NADA de esto se BORRA desde el producto. Un paciente cambia de
// estado, un sillón se desactiva, un caso se cierra o se transfiere. Los
// onDelete son Cascade por la misma razón que en la Ola 1A: para que
// borrar un instituto entero (administración, no panel) no se atore en una
// llave — salvo los dos que apuntan a la cita/al caso, que van SetNull
// para no crear un ciclo de cascadas entre EduCase y EduAppointment.
//
// El .sql idempotente equivalente vive en sql/edu-ola-2.sql y hay que
// aplicarlo a mano en Supabase.
// ═══════════════════════════════════════════════════════════════════════

/// Estado del paciente DE LA ESCUELA. No es un diagnóstico: es en qué
/// punto del embudo está. Un paciente no se borra nunca — sus citas y sus
/// casos ocurrieron.
enum EduPatientStatus {
  /// Registrado en recepción. Todavía no pasa por tamizaje.
  NEW
  /// Tiene al menos un caso abierto: alguien lo está atendiendo.
  ACTIVE
  /// Terminó todos sus tratamientos.
  DISCHARGED
  /// Dejó de venir. No se borra: vuelve a ACTIVE si regresa.
  INACTIVE
}

/// Sexo del paciente, tal como se captura en la ficha. UNSPECIFIED existe
/// a propósito: obligar a elegir en recepción produce datos inventados.
enum EduSex {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

/// El ciclo de vida de un caso clínico dentro de la escuela.
///
/// SCREENING es el estado en que nace un caso abierto desde el tamizaje
/// cuando todavía no se decide el tratamiento; ASSIGNED es "ya tiene
/// alumno"; IN_TREATMENT es "ya se le está haciendo algo"; ON_HOLD es la
/// pausa (el paciente no vuelve, falta un estudio); COMPLETED, TRANSFERRED
/// (cambió de alumno o de especialidad) y ABANDONED son finales.
enum EduCaseStatus {
  SCREENING
  ASSIGNED
  IN_TREATMENT
  ON_HOLD
  COMPLETED
  TRANSFERRED
  ABANDONED
}

/// Para qué es la cita. TAMIZAJE es la valoración inicial que decide si el
/// paciente entra y a qué alumno se le asigna.
enum EduAppointmentType {
  TAMIZAJE
  TRATAMIENTO
  CONTROL
}

/// Dónde va la cita HOY. CHECKED_IN es "el paciente ya llegó a recepción",
/// IN_CHAIR es "ya está sentado en el sillón" e IN_PROGRESS es "ya se le
/// está trabajando". Son tres momentos distintos y la escuela los mide.
enum EduAppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_CHAIR
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// El paciente de la clínica de la escuela.
///
/// No es el `Patient` del dental y no comparte con él ni una columna: es
/// otro producto, con otro tenant y otro expediente.
///
/// ── EL ORIGEN, Y POR QUÉ SE GUARDA DESDE HOY ────────────────────────────
/// `referredByStudentId` dice CUÁL alumno trajo a este paciente. En la Ola
/// 5 ese dato decide el precio (el paciente que trae el alumno no paga lo
/// mismo que el que llega solo a la clínica), así que se captura desde ya:
/// reconstruirlo después, a mano y de memoria, no se puede.
///
/// Se guarda además QUIÉN lo marcó (`originSetById`) y CUÁNDO
/// (`originSetAt`), porque es un dato con consecuencia económica: si un día
/// no cuadra, hay que poder preguntar quién lo puso. Marcarlo exige el
/// permiso `pacientes.origen`, que por defecto solo tienen Caja y
/// Dirección — al alumno se le PINTA su origen, deshabilitado.
model EduPatient {
  id            String           @id @default(cuid())
  institutionId String
  /// Folio de la escuela. Único DENTRO del instituto y normalizado en
  /// MAYÚSCULAS por la aplicación (Postgres distingue: "p-01" y "P-01"
  /// serían dos pacientes con el mismo folio impreso en el expediente).
  folio         String           @db.VarChar(30)
  firstName     String           @db.VarChar(80)
  lastName      String           @db.VarChar(80)
  phone         String?          @db.VarChar(30)
  email         String?          @db.VarChar(160)
  /// Fecha de CALENDARIO: se guarda a medianoche UTC y se pinta en UTC.
  /// Formatearla en la zona local restaría horas y un nacimiento del 1 de
  /// enero saldría "31 de diciembre".
  birthDate     DateTime?
  sex           EduSex           @default(UNSPECIFIED)
  notes         String?          @db.VarChar(1000)
  status        EduPatientStatus @default(NEW)

  /// CUÁL alumno lo trajo. null = llegó solo a la clínica.
  referredByStudentId String?
  /// Quién marcó ese origen y cuándo. Se escriben juntos, siempre.
  originSetById       String?
  originSetAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution      EduInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  referredByStudent EduStudent?   @relation("EduPatientReferrer", fields: [referredByStudentId], references: [id], onDelete: SetNull)
  originSetBy       EduUser?      @relation("EduPatientOriginSetBy", fields: [originSetById], references: [id], onDelete: SetNull)
  cases        EduCase[]
  appointments EduAppointment[]
  /// Ola 3 · el expediente. El ODONTOGRAMA y los ESTUDIOS cuelgan del
  /// PACIENTE y no del caso: la boca es una sola y una tomografía sirve
  /// para la endodoncia y para la ortodoncia. Las NOTAS sí cuelgan del
  /// caso — son el registro de un acto clínico con un responsable.
  records    EduRecord[]
  odontogram EduOdontogramEntry[]
  studies    EduStudy[]

  @@unique([institutionId, folio])
  @@index([institutionId, status])
  @@index([institutionId, lastName])
  @@index([institutionId, referredByStudentId], map: "edu_patients_referrer_idx")
  @@map("edu_patients")
}

/// La unidad dental.
///
/// 🔴 CUÁNTAS HAY LO DECIDE CADA INSTITUTO. No hay un número en el código
/// ni un seed con doce sillones: una escuela tiene 40 y otra tiene 6, y el
/// producto no puede opinar. Se dan de alta desde /instituto/sillones.
model EduChair {
  id            String  @id @default(cuid())
  institutionId String
  name          String  @db.VarChar(60)
  /// El número que está pintado en la pared. Único dentro del instituto.
  number        Int
  isActive      Boolean @default(true)
  /// Orden en que se pintan las columnas de la agenda. Empata con `number`
  /// por defecto, pero se puede cambiar sin renumerar la clínica entera.
  orderIndex    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution  EduInstitution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  schedules    EduChairSchedule[]
  appointments EduAppointment[]

  @@unique([institutionId, number])
  @@index([institutionId, isActive, orderIndex], map: "edu_chairs_orden_idx")
  @@map("edu_chairs")
}

/// Horario de un sillón: qué días y en qué franja se puede agendar.
///
/// 🔴 SIN FILAS = SIEMPRE ABIERTO. Un sillón recién dado de alta no tiene
/// horario y acepta cualquier hora; en cuanto tiene UNA fila, solo acepta
/// lo que cae dentro de sus franjas. Esa asimetría es a propósito: obligar
/// a capturar un horario antes de poder agendar convertiría el alta de un
/// sillón en un trámite.
///
/// Las horas se guardan como MINUTOS DESDE LA MEDIANOCHE (480 = 08:00) y
/// en la hora de PARED del instituto, no como instantes: "el sillón 3 abre
/// a las 8" no cambia porque cambie el horario de verano. La conversión a
/// instante vive en src/lib/edu/agenda-core.ts y usa la zona horaria del
/// instituto.
model EduChairSchedule {
  id            String @id @default(cuid())
  institutionId String
  chairId       String
  /// 0 = domingo … 6 = sábado (igual que Date#getUTCDay, para no tener que
  /// traducir en ningún lado).
  weekday       Int
  /// Minutos desde la medianoche. startMinute < endMinute, siempre.
  startMinute   Int
  endMinute     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution EduInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  chair       EduChair       @relation(fields: [chairId], references: [id], onDelete: Cascade)

  @@index([institutionId, chairId, weekday], map: "edu_chair_schedules_chair_idx")
  @@map("edu_chair_schedules")
}

/// EL CASO: este paciente, con este alumno, en esta especialidad.
///
/// Un paciente puede tener VARIOS casos abiertos a la vez — uno por
/// especialidad. La señora que necesita endodoncia y ortodoncia es una
/// sola persona con dos casos, dos alumnos y dos docentes; meterlo todo en
/// un solo expediente "del paciente" es exactamente lo que hace que en una
/// escuela nadie sepa de quién es la responsabilidad.
///
/// `supervisorUserId` es OPCIONAL a propósito y no es un descuido:
///   · La visibilidad del DOCENTE NO se calcula con esta columna, sino con
///     la asignación VIGENTE alumno↔docente de la Ola 1A. Si se calculara
///     aquí, un docente que ya rotó seguiría viendo el caso para siempre.
///   · Exigirla haría que abrir un caso fallara cuando el alumno todavía
///     no tiene supervisor asignado, y el tamizaje se quedaría atorado por
///     un trámite del padrón.
/// Lo que sí hace el producto es rellenarla sola con el titular vigente del
/// alumno en el momento de abrir el caso: es el responsable EN ESE
/// MOMENTO, guardado para poder contestarlo dentro de un año.
model EduCase {
  id            String        @id @default(cuid())
  institutionId String
  patientId     String
  studentId     String
  /// La especialidad. Es el mismo EduProgram del padrón: un caso de
  /// Endodoncia y uno de Ortodoncia no son el mismo caso.
  programId     String
  supervisorUserId String?
  status        EduCaseStatus @default(SCREENING)
  openedAt      DateTime      @default(now())
  /// Se escribe cuando el caso llega a un estado final (COMPLETED,
  /// TRANSFERRED, ABANDONED). Se deriva del status: no se captura.
  closedAt      DateTime?
  notes         String?       @db.VarChar(1000)

  /// La cita de tamizaje que abrió este caso. Sin FK en cascada: es una
  /// referencia hacia atrás y borrar la cita no puede llevarse el caso.
  screeningAppointmentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution EduInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  patient     EduPatient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  student     EduStudent     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program     EduProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  supervisor  EduUser?       @relation("EduCaseSupervisor", fields: [supervisorUserId], references: [id], onDelete: SetNull)
  screeningAppointment EduAppointment? @relation("EduCaseScreening", fields: [screeningAppointmentId], references: [id], onDelete: SetNull)
  appointments EduAppointment[] @relation("EduCaseAppointments")
  /// Ola 3: las notas clínicas del caso y los estudios que se le engancharon.
  records EduRecord[]
  studies EduStudy[]

  @@index([institutionId, status], map: "edu_cases_status_idx")
  @@index([institutionId, studentId, status], map: "edu_cases_student_idx")
  @@index([institutionId, patientId], map: "edu_cases_patient_idx")
  @@index([institutionId, programId, status], map: "edu_cases_program_idx")
  @@map("edu_cases")
}

/// La cita en el sillón.
///
/// 🔴 startsAt/endsAt son INSTANTES (Timestamptz), no horas de pared. La
/// agenda se captura en la hora del instituto y se convierte a instante en
/// UN solo lugar (src/lib/edu/agenda-core.ts) usando
/// EduInstitution.timezone. Guardar horas de pared en una columna sin zona
/// es cómo se acaba con una cita que se mueve una hora sola en octubre.
///
/// `caseId` es opcional porque la cita de TAMIZAJE ocurre ANTES de que
/// exista el caso: primero se agenda la valoración, y es esa valoración la
/// que abre el caso y le engancha el `caseId` después.
model EduAppointment {
  id            String               @id @default(cuid())
  institutionId String
  patientId     String
  /// El alumno que atiende. Nunca es opcional: una cita sin dueño no la
  /// ve nadie (la visibilidad del ALUMNO y la del DOCENTE cuelgan de aquí).
  studentId     String
  chairId       String
  supervisorUserId String?
  caseId        String?
  startsAt      DateTime             @db.Timestamptz(3)
  endsAt        DateTime             @db.Timestamptz(3)
  type          EduAppointmentType   @default(TRATAMIENTO)
  status        EduAppointmentStatus @default(SCHEDULED)
  /// Los tres momentos que la escuela mide: llegó, se sentó, terminó.
  checkedInAt   DateTime?            @db.Timestamptz(3)
  startedAt     DateTime?            @db.Timestamptz(3)
  completedAt   DateTime?            @db.Timestamptz(3)
  notes         String?              @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution EduInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  patient     EduPatient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  student     EduStudent     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  chair       EduChair       @relation(fields: [chairId], references: [id], onDelete: Cascade)
  supervisor  EduUser?       @relation("EduApptSupervisor", fields: [supervisorUserId], references: [id], onDelete: SetNull)
  case        EduCase?       @relation("EduCaseAppointments", fields: [caseId], references: [id], onDelete: SetNull)
  screeningFor EduCase[]     @relation("EduCaseScreening")
  /// Ola 3: la nota de ESTA sesión. Es opcional en los dos sentidos — hay
  /// citas sin nota (la que se canceló) y notas sin cita (la corrección que
  /// se escribe al día siguiente).
  records      EduRecord[]

  // Los nombres van EXPLÍCITOS: el que Prisma generaría solo
  // (edu_appointments_institutionId_chairId_startsAt_idx y compañía) es
  // largo y frágil, y sql/edu-ola-2.sql tiene que poder decir lo mismo.
  //   · por sillón → la agenda del día, que es la consulta de cada mañana
  //   · por alumno → /mi-dia
  //   · por paciente → la ficha
  @@index([institutionId, startsAt], map: "edu_appointments_dia_idx")
  @@index([institutionId, chairId, startsAt], map: "edu_appointments_chair_idx")
  @@index([institutionId, studentId, startsAt], map: "edu_appointments_student_idx")
  @@index([institutionId, patientId, startsAt], map: "edu_appointments_patient_idx")
  @@index([institutionId, caseId], map: "edu_appointments_case_idx")
  @@map("edu_appointments")
}

// ═══════════════════════════════════════════════════════════════════════
// INSTITUCIONAL — Ola 3 · EL EXPEDIENTE CLÍNICO.
//
// Tres tablas: la NOTA (EduRecord), el ODONTOGRAMA por diente
// (EduOdontogramEntry) y el ARCHIVO del paciente (EduStudy).
//
// 🔴 institutionId está en las TRES, igual que en las olas anteriores y por
// la misma razón: TODA consulta del vertical filtra por el institutionId de
// la SESIÓN, y un filtro que necesita un JOIN para existir es un filtro que
// alguien va a olvidar. Ojo Prisma: un institutionId undefined BORRA el
// filtro y una escuela lee el expediente de otra.
//
// 🔴 QUIÉN VE ESTO — el expediente cuelga del recurso "cases" de
// src/lib/edu/visibility.ts, NO del recurso "patients". La diferencia es
// exactamente la línea del contrato que más fácil se rompe:
//   · "patients"  → CAJA ve a TODOS (recibe, agenda y cobra).
//   · "cases"     → CAJA no ve NINGUNO. Caja no abre expediente clínico.
// Si el expediente se colgara de "patients", caja leería las notas, el
// odontograma y las radiografías de toda la escuela — y el bug se vería
// exactamente igual que "funciona". Por eso las tres tablas se leen con el
// alcance de "cases" aunque dos de ellas cuelguen del PACIENTE.
//
// 🔴 NADA DE BYTES EN LA BASE. EduStudy guarda el PATH del objeto en
// Supabase Storage (bucket privado `edu-files`), nunca el binario ni una
// URL firmada — una URL firmada caduca y quedaría muerta en la columna. El
// navegador sube DIRECTO al bucket con una signed upload URL: una
// tomografía pesa cientos de MB y el cuerpo de una petición en Vercel se
// corta muy por debajo de eso.
//
// El .sql idempotente equivalente vive en sql/edu-ola-3.sql y hay que
// aplicarlo a mano en Supabase.
// ═══════════════════════════════════════════════════════════════════════

/// Dónde va una nota clínica.
///
/// 🔴 NOM-004: una nota FIRMADA no se edita ni se borra. Se corrige con una
/// nota NUEVA que referencia a la anterior (EduRecord.correctsId). Si se
/// pudiera reescribir, el expediente dejaría de ser un registro de lo que
/// pasó y pasaría a ser un registro de lo que alguien quiere que parezca
/// que pasó.
enum EduRecordStatus {
  /// La escribe el alumno y solo la ve quien puede ver el caso.
  BORRADOR
  /// Entregada para revisión del docente. Todavía se puede devolver.
  ENVIADA
  /// Cerrada. No se toca nunca más.
  FIRMADA
}

/// Qué es el archivo que se subió.
enum EduStudyKind {
  RADIOGRAFIA
  TOMOGRAFIA
  FOTO
  PDF
  OTRO
}

/// LA NOTA CLÍNICA (SOAP) de una sesión.
///
/// Cuelga del CASO —este paciente, con este alumno, en esta especialidad—
/// porque es el registro de un acto clínico y un acto clínico tiene un
/// responsable. Meterlas todas en un "expediente del paciente" es lo que
/// hace que en una escuela nadie sepa de quién era la responsabilidad.
///
/// ⚠️ DOS PERSONAS, DOS COLUMNAS, y no es una duplicación:
///   · `studentId`    → el alumno RESPONSABLE del caso. Sale del caso, no
///     del body: es de quién es el acto clínico.
///   · `authorUserId` → QUIÉN TECLEÓ la nota. Sale de la sesión. Cuando el
///     que escribe es el alumno, los dos apuntan a la misma persona; cuando
///     el docente escribe una adenda, no. Sin esta columna habría que
///     atribuirle al alumno una nota que no escribió, que es falsear la
///     autoría de un documento clínico.
model EduRecord {
  id            String @id @default(cuid())
  institutionId String
  caseId        String
  patientId     String
  studentId     String
  /// NOM-004: el autor SIEMPRE identificable. Nunca opcional.
  authorUserId  String
  /// La sesión que documenta. Opcional en los dos sentidos: hay citas sin
  /// nota y notas sin cita.
  appointmentId String?

  /// SOAP. Cuatro campos separados y no un textarea gigante: es el formato
  /// que la escuela enseña, y separarlos es lo que permite después leer
  /// "qué diagnosticó" sin leer la nota entera.
  subjetivo   String? @db.VarChar(4000)
  objetivo    String? @db.VarChar(4000)
  analisis    String? @db.VarChar(4000)
  plan        String? @db.VarChar(4000)
  diagnostico String? @db.VarChar(500)

  status EduRecordStatus @default(BORRADOR)
  /// Cuándo se entregó para revisión y cuándo se firmó. Se DERIVAN del
  /// status (no se capturan), igual que EduCase.closedAt: así no existe una
  /// nota "firmada" sin fecha de firma.
  submittedAt DateTime?
  signedAt    DateTime?
  /// Quién firmó. Puede no ser el autor — el docente firma lo que el alumno
  /// escribió, y ésa es justo la pregunta que se hace un año después.
  signedByUserId String?

  /// La nota a la que ésta CORRIGE. Una firmada no se edita: se corrige con
  /// una nueva que la referencia. SetNull y no Cascade: perder el enlace es
  /// aceptable, perder la corrección no.
  correctsId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution EduInstitution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  case        EduCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  patient     EduPatient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  student     EduStudent      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author      EduUser         @relation("EduRecordAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  signedBy    EduUser?        @relation("EduRecordSigner", fields: [signedByUserId], references: [id], onDelete: SetNull)
  appointment EduAppointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  corrects    EduRecord?      @relation("EduRecordCorrections", fields: [correctsId], references: [id], onDelete: SetNull)
  correctedBy EduRecord[]     @relation("EduRecordCorrections")

  // Los nombres van EXPLÍCITOS: el que Prisma generaría solo
  // (edu_records_institutionId_patientId_createdAt_idx) se acerca a los 63
  // caracteres que admite un identificador de Postgres, y sql/edu-ola-3.sql
  // tiene que poder decir exactamente lo mismo.
  @@index([institutionId, caseId, createdAt], map: "edu_records_case_idx")
  @@index([institutionId, patientId, createdAt], map: "edu_records_patient_idx")
  @@index([institutionId, studentId, status], map: "edu_records_student_idx")
  @@index([institutionId, appointmentId], map: "edu_records_appt_idx")
  @@map("edu_records")
}

/// UN HALLAZGO en UN diente (y opcionalmente en UNA cara).
///
/// El odontograma cuelga del PACIENTE y no del caso: la boca es una sola.
/// El alumno de endodoncia y el de ortodoncia miran el mismo diente 16.
///
/// 🔴 `surface` NO es NULLABLE, y no es un descuido. Postgres considera
/// DISTINTOS dos NULL en un índice único: con `surface` nullable, el mismo
/// hallazgo de diente completo se podría insertar dos, diez o mil veces y
/// el índice no diría nada. La cadena VACÍA ("") significa "el diente
/// entero" y sí la compara el índice.
///
/// `condition` es el id del catálogo compartido de hallazgos
/// (src/components/dashboard/odontogram-v2/data.ts — módulo PURO, sin
/// prisma ni fetch, que el vertical IMPORTA y no copia). El servidor
/// valida contra ese catálogo: sin eso, cualquiera escribe texto libre en
/// el odontograma. La única key que no está en el catálogo es la RESERVADA
/// "__nota__", que es como se guarda la nota por diente.
model EduOdontogramEntry {
  id            String @id @default(cuid())
  institutionId String
  patientId     String
  /// Número FDI del diente (11-18, 21-28, 31-38, 41-48 y los temporales
  /// 51-55, 61-65, 71-75, 81-85).
  tooth         Int
  /// Cara: O/I/M/D/V/L. "" = el diente entero. NUNCA null (ver arriba).
  surface       String  @default("") @db.VarChar(4)
  /// Id del hallazgo en el catálogo, o "__nota__" para la nota del diente.
  condition     String  @db.VarChar(40)
  notes         String? @db.VarChar(1000)

  /// Quién lo marcó y cuándo. El odontograma es parte del expediente: un
  /// hallazgo sin autor no sirve para contestar nada.
  recordedById String
  recordedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution EduInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  patient     EduPatient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy  EduUser        @relation("EduOdontogramRecorder", fields: [recordedById], references: [id], onDelete: Cascade)

  // El índice único COMPLETO: es el que hace posible un upsert y el que
  // impide que el mismo hallazgo entre dos veces por un doble clic.
  @@unique([institutionId, patientId, tooth, surface, condition], map: "edu_odontogram_hallazgo_key")
  @@index([institutionId, patientId, tooth], map: "edu_odontogram_patient_idx")
  @@map("edu_odontogram_entries")
}

/// UN ARCHIVO del expediente: radiografía, tomografía, foto o PDF.
///
/// 🔴 `storagePath` es el PATH INTERNO del bucket privado `edu-files`,
/// jamás una URL. Una URL firmada caduca —minutos— y guardarla dejaría la
/// columna con enlaces muertos; se firma on-demand al leer.
///
/// 🔴 `sizeBytes` es BigInt y NO Int: el tope de subida son 2 GB
/// (2 147 483 648) y un Int de Postgres llega a 2 147 483 647. Con Int, el
/// archivo más grande que el producto acepta desborda la columna por UN
/// byte — y falla al escribir, después de que el usuario esperó la subida
/// entera.
model EduStudy {
  id            String @id @default(cuid())
  institutionId String
  patientId     String
  /// El caso al que se enganchó, si se enganchó a alguno. Opcional: una
  /// panorámica de tamizaje existe antes que cualquier caso.
  caseId        String?

  kind        EduStudyKind @default(OTRO)
  /// El nombre ORIGINAL, tal como lo tenía el archivo. Es lo que se le
  /// enseña a la persona; el path lleva un nombre saneado aparte.
  name        String  @db.VarChar(160)
  storagePath String  @db.VarChar(400)
  mimeType    String  @db.VarChar(120)
  sizeBytes   BigInt
  notes       String? @db.VarChar(1000)

  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  institution EduInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  patient     EduPatient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  case        EduCase?       @relation(fields: [caseId], references: [id], onDelete: SetNull)
  uploadedBy  EduUser        @relation("EduStudyUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  // Un path solo puede estar registrado UNA vez. Es lo que hace idempotente
  // al /confirm: un reintento del cliente devuelve la fila que ya existe en
  // vez de duplicar el estudio.
  @@unique([institutionId, storagePath], map: "edu_studies_path_key")
  @@index([institutionId, patientId, createdAt], map: "edu_studies_patient_idx")
  @@index([institutionId, caseId], map: "edu_studies_case_idx")
  @@map("edu_studies")
}
