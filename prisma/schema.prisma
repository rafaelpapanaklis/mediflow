/// Saldo a favor (crédito) del paciente. v1 SIN consumo: el saldo a favor de un
/// paciente = SUM(amount) de sus filas. Lo alimenta el import de "Saldos"
/// (col tipo=favor) y, a futuro, sobrepagos / notas de crédito. Aislamiento por
/// clínica = Prisma-side (where clinicId), igual que el resto del modelo.
model PatientCredit {
  id          String   @id @default(cuid())
  clinicId    String
  patientId   String
  amount      Float // siempre > 0; el "a favor" lo expresa el modelo, no el signo
  description String?
  source      String   @default("migrated")
  creditDate  DateTime @default(now())
  createdAt   DateTime @default(now())

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId])
  @@map("patient_credits")
}

/// Estado por superficie del odontograma (32 dientes adultos / 5 superficies).
/// `surface` null = estado aplicado al diente completo (corona, ausente, etc).
model OdontogramEntry {
  id          String   @id @default(cuid())
  patientId   String
  toothNumber Int // FDI numbering (11-18, 21-28, 31-38, 41-48, etc.)
  surface     String? // M | D | V | L | O | null (diente completo)
  conditionId String // id del catálogo: caries | restoration | crown | rct | implant | missing | ext_done | ... (45 hallazgos) · "__note__" = nota por diente
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Varias condiciones por (diente, cara): la unique incluye conditionId.
  @@unique([patientId, toothNumber, surface, conditionId])
  @@index([patientId])
  @@map("odontogram_entries")
}

/// Snapshot inmutable del odontograma al cerrar una consulta. Permite
/// reconstruir el estado dental en cualquier punto en el tiempo y diff'ear
/// contra el snapshot anterior para detectar tratamientos hechos.
/// `entries` es JSON: [{ toothNumber, surface, conditionId, notes }, ...].
model OdontogramSnapshot {
  id            String   @id @default(cuid())
  patientId     String
  appointmentId String   @unique
  snapshotAt    DateTime @default(now())
  entries       Json

  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([patientId, snapshotAt])
  @@map("odontogram_snapshots")
}

