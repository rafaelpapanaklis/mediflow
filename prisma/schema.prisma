// ═══════════════════════════════════════════════════════════════════════
// FINANZAS — gastos operativos de la clínica (dirección financiera). La Caja
// NO se toca: Finanzas solo LEE payments/invoices y registra SUS gastos aquí.
// Mismo tipo de dinero que Payment.amount (Float). Ver sql/expenses.sql
// (aplicar en Supabase ANTES del merge — patrón sql/caja.sql).
// ═══════════════════════════════════════════════════════════════════════
model Expense {
  id          String   @id @default(cuid())
  clinicId    String
  date        DateTime @default(now())
  category    String // "Renta" | "Insumos" | "Nómina" | "Servicios" | "Marketing" | "Otro" | libre
  amount      Float
  note        String?
  createdById String // User.id que registró el gasto (sin relación — se resuelve al mostrar)
  createdAt   DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, date])
  @@map("expenses")
}

// ═══════════════════════════════════════════════════════════════════════
// CAJA / CORTE DE CAJA DIARIO (WS1-T2). La página general /dashboard/billing
// se reconvirtió en "Caja". La facturación POR PACIENTE no cambia: Caja solo
// LEE de invoices/payments. Ver sql/caja.sql (aplicar en Supabase ANTES del
// merge). Una caja OPEN por clínica a la vez (garantizado en la API).
// ═══════════════════════════════════════════════════════════════════════
enum CashStatus {
  OPEN
  CLOSED
}

/// Turno de caja. Mientras está OPEN los totales (ingresos/descuentos/IVA/
/// retiros) NO se guardan: se DERIVAN en vivo de payments/invoices en la
/// ventana [openedAt, closedAt ?? now]. Al CERRAR se CONGELAN en los campos
/// snapshot* para auditoría (no se recalculan después).
model CashRegister {
  id                    String     @id @default(cuid())
  clinicId              String
  operatorId            String // usuario que abrió la caja
  openedAt              DateTime   @default(now())
  openingBalance        Float
  closedAt              DateTime?
  countedClosingBalance Float? // efectivo físico contado al cierre
  closingNotes          String?
  status                CashStatus @default(OPEN)

  // Snapshot congelado al cierre — auditoría, NO recalcular.
  snapshotCashIncome   Float?
  snapshotOtherIncome  Float?
  snapshotDiscounts    Float?
  snapshotTax          Float?
  snapshotWithdrawals  Float?
  snapshotExpectedCash Float?
  snapshotVariance     Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic      Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  operator    User             @relation("CashRegisterOperator", fields: [operatorId], references: [id])
  withdrawals CashWithdrawal[]

  @@index([clinicId, status])
  @@map("cash_registers")
}

model CashWithdrawal {
  id             String   @id @default(cuid())
  cashRegisterId String
  amount         Float
  reason         String
  recordedBy     String // usuario que registró el retiro
  recordedAt     DateTime @default(now())

  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  recordedByUser User         @relation("CashWithdrawalRecordedBy", fields: [recordedBy], references: [id])

  @@index([cashRegisterId])
  @@map("cash_withdrawals")
}

model ClinicSchedule {
  id        String  @id @default(cuid())
  clinicId  String
  dayOfWeek Int
  enabled   Boolean @default(true)
  openTime  String  @default("09:00")
  closeTime String  @default("18:00")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, dayOfWeek])
  @@map("clinic_schedules")
}

model PatientFile {
  id          String       @id @default(cuid())
  patientId   String
  clinicId    String
  uploadedBy  String?
  name        String
  url         String
  size        Int?
  mimeType    String?
  category    FileCategory @default(OTHER)
  toothNumber Int?
  notes       String?
  takenAt     DateTime?
  createdAt   DateTime     @default(now())

  // Notas clínicas del doctor sobre este archivo (independientes de las notas de upload y del análisis IA)
  doctorNotes          String?   @db.Text
  doctorNotesUpdatedAt DateTime?

  // Anotaciones del visor (regla, ángulo, lápiz). Array de
  // { id, type: "ruler"|"angle"|"freehand", points: [{x,y}], label?, color? }
  // Las coordenadas son relativas (0..1) al rect natural de la imagen para
  // que el dibujo sea estable a cualquier zoom/tamaño de visor.
  annotations Json?

  // NOM-004 conservación / NOM-024 §7 — borrado LÓGICO (jamás hard-delete).
  // El blob en Storage se PRESERVA; deletedAt oculta el archivo de las vistas
  // activas (radiografías, modelos 3D, timeline, export) sin destruir el dato.
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?   @db.Text

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  xrayAnalysis XrayAnalysis?

  // Endodontics module — radiografías referenciadas como conductometría /
  // controles / intraoperatorio. SPEC §1.4 reutiliza PatientFile en lugar
  // de crear un modelo Radiography separado.
  conductometryRootCanals RootCanal[]          @relation("ConductometryFile")
  followUpsAsControl      EndodonticFollowUp[] @relation("FollowUpFile")
  apicalSurgeries         ApicalSurgery[]      @relation("ApicalSurgeryFile")

  // Periodontics module — fotos intraoperatorias y consentimientos firmados
  // de cirugías. SPEC §1.16 reutiliza PatientFile (no se crea modelo
  // Radiography). Spec §4.3.
  surgeryIntraOpFor PeriodontalSurgery[] @relation("SurgeryIntraOpFile")
  surgeryConsentFor PeriodontalSurgery[] @relation("SurgeryConsentFile")

  // Orthodontics module — 8 vistas del set fotográfico (extra+intra) más
  // consentimientos firmados de tratamiento/financiero/asentimiento + recibos
  // de pago. SPEC §1.20 reutiliza PatientFile (no se crea modelo separado).
  orthoPhotoFrontalFor               OrthoPhotoSet[]            @relation("OrthoPhotoFrontal")
  orthoPhotoProfileFor               OrthoPhotoSet[]            @relation("OrthoPhotoProfile")
  orthoPhotoSmileFor                 OrthoPhotoSet[]            @relation("OrthoPhotoSmile")
  orthoPhotoIntraFrontalFor          OrthoPhotoSet[]            @relation("OrthoPhotoIntraFrontal")
  orthoPhotoIntraLateralRFor         OrthoPhotoSet[]            @relation("OrthoPhotoIntraLateralR")
  orthoPhotoIntraLateralLFor         OrthoPhotoSet[]            @relation("OrthoPhotoIntraLateralL")
  orthoPhotoOcclusalUpperFor         OrthoPhotoSet[]            @relation("OrthoPhotoOcclusalUpper")
  orthoPhotoOcclusalLowerFor         OrthoPhotoSet[]            @relation("OrthoPhotoOcclusalLower")
  orthoPhotoFaceFrontFor             OrthoPhotoSet[]            @relation("OrthoPhotoFaceFront")
  orthoPhotoFaceSmileFor             OrthoPhotoSet[]            @relation("OrthoPhotoFaceSmile")
  orthoTreatmentConsentsSignedFile   OrthodonticTreatmentPlan[] @relation("OrthoTreatmentConsentSignedFile")
  orthoFinancialAgreementsSignedFile OrthoPaymentPlan[]         @relation("OrthoFinancialAgreementSignedFile")
  orthoInstallmentsReceipt           OrthoInstallment[]         @relation("OrthoInstallmentReceiptFile")
  orthoConsentsSignedFile            OrthodonticConsent[]       @relation("OrthoConsentSignedFile")
  orthoDigitalRecordsFile            OrthodonticDigitalRecord[] @relation("OrthoDigitalRecordFile")

  // Implants module — radiografías peri-implantarias, foto intraoperatoria
  // de la cirugía, foto del paciente para el carnet, PDF del carnet,
  // consentimientos firmados. Ver SPEC §8.5.
  implantSurgicalIntraoperative ImplantSurgicalRecord[] @relation("ImplantSurgicalIntraoperativePhoto")
  implantFollowUpsRadiograph    ImplantFollowUp[]       @relation("ImplantFollowUpRadiograph")
  implantPassportsPhoto         ImplantPassport[]       @relation("ImplantPassportPhoto")
  implantPassportsPdf           ImplantPassport[]       @relation("ImplantPassportPdf")
  implantConsentsSigned         ImplantConsent[]        @relation("ImplantConsentSigned")

  @@index([clinicId, patientId, createdAt(sort: Desc)])
  @@index([patientId, category])
  @@index([clinicId, deletedAt])
  @@map("patient_files")
}

// ── AI analysis of radiographs (cached per file) ──────────────────────
model XrayAnalysis {
  id        String      @id @default(cuid())
  fileId    String      @unique
  file      PatientFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  clinicId  String
  clinic    Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Modo de análisis. GENERAL es el default histórico (free-form findings).
  // PERIODONTAL_BONE_LOSS y PERIIMPLANT_BONE_LOSS son flujos dedicados con
  // mediciones por sitio/implante. A2 cross-módulos.
  // Un fileId tiene UN análisis: si el doctor cambia de modo y re-analiza,
  // el nuevo modo sobreescribe al anterior (upsert por fileId).
  mode XrayAnalysisMode @default(GENERAL)

  // Contenido del análisis
  summary         String @db.Text
  findings        Json // array con { id, title, description, tooth, severity, confidence }
  recommendations Json // string o array — el endpoint lo persiste tal cual

  // Mediciones específicas por modo (null para GENERAL):
  //   PERIODONTAL_BONE_LOSS: { sites: [{ toothFdi, position, lossMm, type: "horizontal"|"vertical", bopPresent }, ...] }
  //   PERIIMPLANT_BONE_LOSS: { implantFdi, mesialMm, distalMm, baselineDate?, comparisonNote? }
  measurements Json?

  // Top-level derivados (para queries/filtros sin parsear JSON)
  severity   String // max de findings: alta | media | baja | informativo
  confidence Float // avg de findings, 0-100

  // Metadata
  tokensUsed Int      @default(0)
  modelUsed  String   @default("claude-sonnet-4-6")
  createdAt  DateTime @default(now())
  createdBy  String? // userId del doctor que lo generó

  @@index([clinicId])
  @@index([patientId])
  @@index([severity])
  @@index([mode])
  @@map("xray_analyses")
}

enum XrayAnalysisMode {
  GENERAL
  PERIODONTAL_BONE_LOSS
  PERIIMPLANT_BONE_LOSS
}

enum FileCategory {
  XRAY_PERIAPICAL
  XRAY_PANORAMIC
  XRAY_BITEWING
  XRAY_OCCLUSAL
  XRAY_CBCT
  PHOTO_FRONTAL
  PHOTO_LATERAL
  PHOTO_OCCLUSAL_UPPER
  PHOTO_OCCLUSAL_LOWER
  PHOTO_INTRAORAL
  PHOTO_PATIENT
  CONSENT_FORM
  // Orthodontics module — set fotográfico T0/T1/T2 + controles + cefalo + STL.
  // SPEC §1.3 + §1.20: reuso de PatientFile con FileCategory tipado.
  ORTHO_PHOTO_T0
  ORTHO_PHOTO_T1
  ORTHO_PHOTO_T2
  ORTHO_PHOTO_CONTROL
  CEPH_ANALYSIS_PDF
  SCAN_STL
  OTHER
}

// ── Payment Plans ─────────────────────────────────────────────────────
model PaymentPlan {
