  ped_control_erupcion_anual
  ped_cumpleanos_paciente
  // Endodoncia
  endo_followup_3m
  endo_followup_6m
  endo_followup_1y
  // Periodoncia
  perio_maintenance_3m
  perio_maintenance_4m
  perio_maintenance_6m
  perio_reevaluation
  // Implantes — set v1 (pediatrics base)
  implant_followup_1m
  implant_followup_6m
  implant_followup_1y
  // Implantes — set v2 (granular spec implantes 4/5)
  implant_cicatrizacion_7d
  implant_retiro_sutura_10d
  implant_oseointegracion_4m
  implant_control_anual
  implant_peri_implantitis_6m
  // Ortodoncia
  ortho_control_30d
  ortho_retention_check
