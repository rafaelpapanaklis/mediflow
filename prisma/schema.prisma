generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Clinic {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  specialty       String // @deprecated — usar category en su lugar
  category        ClinicCategory @default(OTHER)
  country         String         @default("MX")
  locale          String         @default("es") // idioma del panel: "es" | "en"
  state           String? // MX state (e.g., "Ciudad de México", "Jalisco")
  city            String?
  address         String?
  mapsUrl         String?
  phone           String?
  clinicSize      String? // "1" | "2-5" | "6-15" | "16+" — captured at signup
  email           String?
  logoUrl         String?
  taxId           String?
  isPublic        Boolean        @default(false)
  // Seguridad: si true, TODO usuario de la clínica debe enrolar 2FA al entrar
  // al panel (enrolamiento forzado). Ver sql/sec-staff-2fa.sql.
  require2fa      Boolean        @default(false)
  description     String?
  plan            Plan           @default(PRO)
  // Trial — 14 días desde creación. trialStartedAt agregado en Sprint 1
  // marketplace; antes derivábamos de createdAt. trialEndsAt pasa a NOT NULL
  // tras backfill de la migración marketplace_foundation.
  trialStartedAt  DateTime       @default(now()) @map("trial_started_at")
  trialEndsAt     DateTime
  trialNotified7d Boolean        @default(false) @map("trial_notified_7d")
  trialNotified3d Boolean        @default(false) @map("trial_notified_3d")
  trialNotified1d Boolean        @default(false) @map("trial_notified_1d")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // WhatsApp (legacy Meta Cloud API)
  waPhoneNumberId  String? @unique
  waAccessToken    String?
  waBusinessAccountId String? // WhatsApp Business Account ID (coexistence)
  waConnMethod        String? // "manual" | "coexistence" | "embedded"
  waConnected      Boolean @default(false)
  waReminderActive Boolean @default(true)
  waReminder24h    Boolean @default(true)
  waReminder1h     Boolean @default(false)
  waReminderMsg    String?
  /// Plantillas aprobadas de ESTA clínica en Meta, por tipo de mensaje:
  /// { "reminder": { "name": "recordatorio_cita", "lang": "es_MX" }, … }.
  /// La clave es un WhatsAppSendKind (src/lib/whatsapp/system-message.ts).
  /// Sin plantilla para un tipo, ese aviso NO sale fuera de la ventana de 24 h.
  waTemplates      Json?
  /// La WABA de la clínica tiene método de pago válido. Meta le cobra a ELLA
  /// cada plantilla; sin tarjeta el envío falla con 131042. Se pone true al
  /// primer envío de plantilla aceptado y vuelve a false ante ese error.
  waBillingOk      Boolean @default(false)

  // Inbox unificado — Twilio Conversations + Postmark Inbound
  twilioAccountSid     String? // SID de la cuenta Twilio (admin la conecta en /settings/integrations)
  twilioAuthToken      String? // token (encrypted-at-rest en producción)
  twilioWhatsappNumber String? // E.164: "+5215512345678"
  postmarkInboundEmail String? // ej: clinica-abc@inbox.mediflow.app — único por clínica

  // Google Calendar — clinic-level shared calendar
  googleCalendarToken    String? // access token of the admin who connected
  googleRefreshToken     String? // refresh token
  googleCalendarEmail    String? // google account email
  googleCalendarEnabled  Boolean @default(false)
  googleClinicCalendarId String? // ID of the "clinic" calendar in Google

  // CFDI / Facturación SAT
  facturApiOrgId   String?
  rfcEmisor        String?
  regimenFiscal    String?
  cpEmisor         String?
  facturApiEnabled Boolean @default(false)
  csdUploaded      Boolean   @default(false) // CSD (Certificado de Sello Digital) cargado en Facturapi
  csdValidUntil    DateTime? // Vigencia del CSD (expires_at que reporta Facturapi)
  // Impuestos con los que se pre-llena el timbrado de esta clínica:
  // "exempt" = servicios médicos/dentales exentos (art. 15 LIVA, lo más común)
  // "iva16"  = IVA 16%. El modal de timbrado puede sobreescribirlo por factura.
  cfdiTaxMode      String    @default("exempt")
  // Live Secret Key de la organización en Facturapi. HAY que guardarla: la API
  // solo la devuelve completa al crearla (PUT /apikeys/live); el GET lista
  // metadatos (first_12), nunca la llave usable. Ese PUT no invalida las
  // anteriores, así que regenerar es seguro (ver getOrgApiKey en lib/facturapi.ts).
  // Cifrada con el envelope AES-256-GCM si DATA_ENCRYPTION_KEY está configurada;
  // en claro si no (con warning en el log). Jamás sale al cliente.
  facturApiLiveKey String?

  // Identificación NOM-024 — CLUES Sector Salud (Compliance Fase A)
  clues String? @db.VarChar(11)

  // Subscription / Billing
  subscriptionStatus     String? // active, trialing, past_due, cancelled
  subscriptionId         String? // legacy — Stripe/MP subscription ID
  nextBillingDate        DateTime?
  monthlyPrice           Float?    @default(0)
  // Stripe subscription billing
  stripeCustomerId       String? // Stripe Customer ID for the clinic owner
  stripeSubscriptionId   String? // Stripe Subscription ID (recurring)
  stripePaymentMethodId  String? // default payment method
  // PayPal
  paypalSubscriptionId   String? // PayPal subscription ID (recurring)
  paypalEmail            String? // PayPal email for manual payments
  // Payment preferences
  preferredPaymentMethod String? // stripe, paypal, transfer, oxxo
  // Signup payment method capture (UI-only until Stripe wired)
  paymentMethodCollected Boolean   @default(false)
  paymentMethodType      String? // "card" | "paypal" | "transfer"
  paymentMethodLast4     String? // last 4 digits (card only, for display)
  // Cancellation request (user-initiated from settings)
  cancelRequested        Boolean   @default(false)
  cancelRequestedAt      DateTime?
  // NOM-004 / NOM-024 §7 — archivado LÓGICO en vez de hard-delete. Eliminar una
  // clínica jamás debe cascada-destruir el expediente: se marca archivada (el
  // expediente se conserva) y se baja isPublic/landingActive. archivedAt != null
  // = clínica archivada.
  archivedAt             DateTime?
  archivedBy             String?
  archiveReason          String?   @db.Text
  recallMonths           Int       @default(6) // months before annual reminder
  recallActive           Boolean   @default(false)
  googlePlaceId          String? // Google Maps Place ID for fetching reviews

  // CRM — automatizaciones (mejoras CRM jun 2026). Default OFF: ningún cron
  // envía nada hasta que la clínica active el toggle desde Configuración.
  birthdayMsgActive      Boolean   @default(false) // mensaje de cumpleaños por WhatsApp
  postApptFollowupActive Boolean   @default(false) // seguimiento post-cita por WhatsApp
  noShowTaskActive       Boolean   @default(false) // tarea de staff por riesgo de no-show

  // Cambios de cita desde el portal del paciente (WS1-T5). Si autoApprove está
  // OFF, las solicitudes quedan PENDING hasta que la clínica las resuelva.
  patientChangesAutoApprove Boolean @default(false)
  patientChangesMinHours    Int     @default(24) // ventana mínima en horas

  // Landing page
  landingActive       Boolean  @default(false)
  landingThemeColor   String?  @default("#2563eb")
  landingCoverUrl     String?
  landingGallery      String[] @default([])
  landingTestimonials Json?
  landingFaqs         Json?
  landingServices     Json?
  landingHours        Json?
  landingWhatsapp     String?
  landingInstagram    String?
  landingFacebook     String?
  landingTiktok       String?
  landingMapEmbed     String?
  landingTagline      String?

  // Landing — selector de plantilla pública (T1 fundación)
  landingTemplate        String?  @default("classic")
  landingYearsExperience Int?
  landingPatients        String?

  // Landing v2 — el editor de Configuración se dibuja desde el manifiesto de
  // cada plantilla (src/app/[slug]/_shared/template-manifest.ts), no a mano.
  // Requiere sql/landing-v2.sql aplicado en Supabase.
  //   landingSections: [{ id, visible, orden, titulo, subtitulo }] — qué
  //     secciones se ven y en qué orden. contacto/reservar son obligatorias.
  //   landingPhotos:   { <idDeRanura>: url } — la foto de cada ranura con
  //     nombre que declara la plantilla ("portada", "equipo", "caso1_antes").
  //     NO reemplaza landingCoverUrl ni landingGallery: convive con ellas.
  //   landingMsiPlazos: meses sin intereses, p.ej. [3,6,12]. Vacío = ocultar.
  // La duración por servicio NO es columna: va como `durationMin` dentro de
  // cada elemento de landingServices.
  landingSections   Json?
  landingPhotos     Json?
  landingUrgentText String?
  landingMsiPlazos  Int[]  @default([])

  // Landing v3 — TODO el texto de la mini-web editable, no solo los títulos de
  // sección. Requiere sql/landing-copy.sql aplicado en Supabase.
  //   landingCopy: { <claveDeclarada>: texto } — mapa PLANO. Las claves las
  //     declara el manifiesto de cada plantilla (TemplateManifest.copia) y una
  //     clave que ningún manifiesto declara NO se guarda: nada de bolsa libre.
  //     Los textos por defecto de la plantilla nunca se materializan aquí —
  //     vaciar un campo borra su clave y vuelve a salir el literal real.
  landingCopy       Json?

  bookingRequests BookingRequest[]

  // AI Assistant usage tracking
  aiTokensUsed  Int      @default(0)
  aiTokensLimit Int      @default(50000)
  aiLastResetAt DateTime @default(now())

  // Telemedicine
  teleEnabled       Boolean @default(false)
  teleCommissionPct Float   @default(15)
  dailyApiKey       String?

  // Agenda config (Fase 4)
  defaultSlotMinutes Int    @default(15)
  agendaDayStart     Int    @default(8)
  agendaDayEnd       Int    @default(20)
  timezone           String @default("America/Mexico_City")

  // ── Mi Clínica Visual — vista pública en vivo ──
  // Cada clínica puede compartir su modo "En Vivo" para mostrar en TV de
  // sala de espera. URL pública: /live/<liveModeSlug>. Si liveModePassword
  // está set, los visitantes deben ingresar el password una vez (cookie
  // unlock 12h). showPatientNames=false → solo iniciales en halos (HIPAA).
  liveModeSlug             String? @unique
  liveModePassword         String? // bcrypt hash; null = sin protección
  liveModeEnabled          Boolean @default(false)
  liveModeShowPatientNames Boolean @default(false)

  // Recordatorios automáticos de citas — config JSON por clínica:
  // { enabled, offsets: [minutos antes], channel: "whatsapp"|"email"|"both", template }.
  // null = fallback a los campos legacy waReminderActive/waReminder24h/waReminder1h/waReminderMsg.
  reminderSettings Json?

  users                User[]
  patients             Patient[]
  appointments         Appointment[]
  appointmentChangeRequests AppointmentChangeRequest[]
  records              MedicalRecord[]
  invoices             Invoice[]
  cashRegisters        CashRegister[]
  schedules            ClinicSchedule[]
  inventory            InventoryItem[]
  reminders            WhatsAppReminder[]
  cfdis                CfdiRecord[]
  cfdiUsages           CfdiUsage[]
  treatments           TreatmentPlan[]
  paymentPlans         PaymentPlan[]
  patientCredits       PatientCredit[]
  patientNotifications PatientNotification[]
  consentForms         ConsentForm[]
  periodontalRecords   PeriodontalRecord[]
  subscriptionInvoices SubscriptionInvoice[]
  files                PatientFile[]
  auditLogs            AuditLog[]
  beforeAfterPhotos    BeforeAfterPhoto[]
  servicePackages      ServicePackage[]
  formulaRecords       FormulaRecord[]
  bodyMapAnnotations   BodyMapAnnotation[]
  walkInQueue          WalkInQueue[]
  resourceBookings     ResourceBooking[]
  procedureCatalog     ProcedureCatalog[]
  xrayAnalyses         XrayAnalysis[]
  adminNotes           AdminClinicNote[]
  prescriptions        Prescription[]
  resources            Resource[]
  waitlistEntries      WaitlistEntry[]
  inboxThreads         InboxThread[]
  whatsAppBotConfig    WhatsAppBotConfig?
  remindersList        Reminder[]
  clinicLayout         ClinicLayout?
  // Analytics (Push 1)
  weeklyInsights       WeeklyInsight[]
  tvDisplays           TVDisplay[]
  // Compliance Fase C
  referrals            Referral[]
  // Marketplace de módulos (Sprint 1) — 1:N con módulos comprados,
  // logs de uso, órdenes de checkout y 1:1 con carrito persistente.
  clinicModules        ClinicModule[]
  moduleUsageLogs      ModuleUsageLog[]
  orders               Order[]
  cart                 Cart?

  // Endodontics module — see docs/marketplace/research/endodoncia/SPEC.md §4
  endodonticDiagnoses  EndodonticDiagnosis[]
  vitalityTests        VitalityTest[]
  endodonticTreatments EndodonticTreatment[]

  // Periodontics module — see docs/marketplace/research/periodoncia/SPEC.md §4
  periodontalClassifications PeriodontalClassification[]
  gingivalRecessions         GingivalRecession[]
  periodontalPlans           PeriodontalTreatmentPlan[]
  srpSessions                SRPSession[]
  periodontalReevaluations   PeriodontalReevaluation[]
  periodontalRiskAssessments PeriodontalRiskAssessment[]
  periodontalSurgeries       PeriodontalSurgery[]
  periImplantAssessments     PeriImplantAssessment[]

  // Orthodontics module — see docs/marketplace/research/ortodoncia/SPEC.md §4
  orthodonticDiagnoses      OrthodonticDiagnosis[]
  orthodonticTreatmentPlans OrthodonticTreatmentPlan[]
  orthodonticPhases         OrthodonticPhase[]
  orthoPaymentPlans         OrthoPaymentPlan[]
  orthoInstallments         OrthoInstallment[]
  orthoPhotoSets            OrthoPhotoSet[]
  orthodonticControls       OrthodonticControlAppointment[]
  orthodonticDigitalRecords OrthodonticDigitalRecord[]
  orthodonticConsents       OrthodonticConsent[]

  // Orthodontics Fase 1 rediseño patient-detail (mayo 2026).
  orthoWireSteps          OrthoWireStep[]
  orthoTreatmentCards     OrthoTreatmentCard[]
  orthoCardElastics       OrthoCardElastic[]
  orthoCardIprPoints      OrthoCardIprPoint[]
  orthoCardBrokenBrackets OrthoCardBrokenBracket[]
  orthoTads               OrthoTAD[]
  orthoAuxMechanics       OrthoAuxMechanics[]
  orthoPhaseTransitions   OrthoPhaseTransition[]
  patientFlowEntries      PatientFlow[]

  // Orthodontics Fase 1.5 rediseño completo.
  orthoQuoteScenarios     OrthoQuoteScenario[]
  orthoSignAtHomePackages OrthoSignAtHomePackage[]
  // Presupuestos / cotizaciones genéricas del paciente (WS1-T1).
  quotes                  Quote[]
  orthoRetentionRegimens  OrthoRetentionRegimen[]
  orthoRetainerCheckups   OrthoRetainerCheckup[]
  orthoNpsSchedules       OrthoNpsSchedule[]
  orthoReferralCodes      OrthoReferralCode[]

  // Implants module — see docs/marketplace/research/implantologia/SPEC.md §4
  implants             Implant[]
  implantCatalogModels ImplantCatalogModel[]

  // Clinical-shared cross-cutting features
  clinicalPhotos             ClinicalPhoto[]
  clinicalEvolutionTemplates ClinicalEvolutionTemplate[]
  referralLetters            ReferralLetter[]
  doctorContacts             DoctorContact[]
  labOrders                  LabOrder[]
  labPartners                LabPartner[]
  clinicalReminders          ClinicalReminder[]
  patientShareLinks          PatientShareLink[]
  treatmentLinks             TreatmentLink[]

  // Proveedores / Compras (marketplace B2B) — el proveedor es global; la
  // clínica solo tiene carritos, pedidos y chats hacia proveedores.
  supplierCarts   SupplierCart[]
  supplierOrders  SupplierOrder[]
  supplierChats   SupplierChatThread[]
  supplierReviews   SupplierReview[]
  supplierFavorites SupplierFavorite[]
  dentalLabOrders DentalLabOrder[]
  dentalLabChats  DentalLabChatThread[]

  // Afiliados / Referidos — la clínica fue referida por un afiliado (opcional).
  // Se setea SOLO en el alta vía ?ref validado; nunca desde el cliente después.
  affiliateId String?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id])

  // Geolocalizacion del directorio publico (/descubre) — pin del mapa "cerca de
  // mi". Nullable: clinicas sin pin no salen en el mapa pero si en la lista.
  // WS2-T3. Requiere sql/mapa-directorio.sql aplicado en Supabase.
  latitude  Float?
  longitude Float?

  patientUploads PatientUpload[]

  // Finanzas — gastos operativos de la clínica (dirección financiera).
  expenses Expense[]

  // Multi-Clínica Fase 2 — sedes con las que ESTA comparte pacientes. El par se
  // guarda normalizado (menor→mayor por id), así que una misma sede aparece a
  // veces como A y a veces como B: para saber con quién comparte hay que mirar
  // las DOS relaciones. Ver getVisiblePatientClinicIds en @/lib/branches.
  patientLinksAsA ClinicPatientLink[] @relation("ClinicPatientLinkA")
  patientLinksAsB ClinicPatientLink[] @relation("ClinicPatientLinkB")

  // Desglose del cupo mensual de IA (aiTokensUsed) por tipo de función. Es la
  // MISMA bolsa que aiTokensUsed/aiTokensLimit, solo que con detalle por
  // feature. NO confundir con AiUsageEvent, que pertenece al monedero prepago
  // del bot de WhatsApp. Requiere sql/ai-quota-usage.sql aplicado en Supabase.
  aiQuotaUsage AiQuotaUsage[]

  // Manager de cuenta — la persona real de DaleControl que atiende a esta
  // clínica por WhatsApp (se asigna desde /admin/account-managers). Nullable:
  // sin manager la clínica solo tiene soporte por tickets. onDelete SetNull —
  // borrar un manager NUNCA borra clínicas, solo las deja sin asignar.
  // Requiere sql/account-managers.sql aplicado en Supabase.
  accountManagerId String?
  accountManager   AccountManager? @relation(fields: [accountManagerId], references: [id], onDelete: SetNull)

  @@index([accountManagerId])
  @@map("clinics")
}

// Manager de cuenta — persona de DaleControl que atiende clínicas por WhatsApp.
// Es un catálogo GLOBAL (no multi-tenant): lo administra el owner desde /admin.
// El panel de la clínica sólo ve el manager que tiene asignado, nunca el resto.
//
// Horario: `days` son días de la semana con 0=Domingo … 6=Sábado (mismo criterio
// que Date.getDay() y que getTzParts), Lun–Vie = [1,2,3,4,5]. `startMinutes` y
// `endMinutes` son minutos desde medianoche (9:00 = 540, 18:00 = 1080) y se
// evalúan SIEMPRE en `timezone`, no en la del visitante.
// Ver src/lib/account-manager/availability.ts.
model AccountManager {
  id              String   @id @default(cuid())
  name            String
  photoUrl        String?
  /// E.164 SIN el "+": "529992602093". Es lo que consume wa.me/<numero>.
  whatsappE164    String
  /// Formateado para leerse ("999 260 2093"). Si es null se deriva del E.164.
  whatsappDisplay String?
  days            Int[]    @default([1, 2, 3, 4, 5])
  startMinutes    Int      @default(540)
  endMinutes      Int      @default(1080)
  timezone        String   @default("America/Mexico_City")
  /// "active" | "paused". Un manager pausado nunca aparece "en línea".
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinics    Clinic[]
  affiliates Affiliate[]

  @@index([status])
  @@map("account_managers")
}

enum ClinicCategory {
  DENTAL
  MEDICINE
  NUTRITION
  PSYCHOLOGY
  DERMATOLOGY
  AESTHETIC_MEDICINE
  HAIR_RESTORATION
  BEAUTY_CENTER
  BROW_LASH
  MASSAGE
  LASER_HAIR_REMOVAL
  HAIR_SALON
  ALTERNATIVE_MEDICINE
  NAIL_SALON
  SPA
  PHYSIOTHERAPY
  PODIATRY
  OTHER
}

enum Plan {
  BASIC
  PRO
  CLINIC
}

// Idempotencia de los correos de ciclo de vida del plan (activado / renovado).
// Una fila por factura de Stripe: la unicidad de `invoiceId` evita el doble
// envío cuando Stripe dispara invoice.paid + invoice.payment_succeeded para la
// misma factura. Sin relación/FK a Clinic a propósito (log liviano que solo
// escribe/lee el webhook con service role). Ver sql/billing-email-log.sql.
model BillingEmailLog {
  id        String   @id @default(cuid())
  invoiceId String   @unique
  clinicId  String
  kind      String // "plan_activated" | "plan_renewed"
  email     String
  createdAt DateTime @default(now())

  @@index([clinicId])
  @@map("billing_email_logs")
}

// ═══════════════════════════════════════════════════════════════════════
// PROVEEDORES / COMPRAS — marketplace B2B. El proveedor es GLOBAL (sin
// clinicId): vende a cualquier clínica. Carrito, pedidos y chat son por
// (clinicId, supplierId). Contrato compartido: src/lib/suppliers/types.ts
// ═══════════════════════════════════════════════════════════════════════

enum SupplierStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SupplierUserRole {
  OWNER
  MANAGER
  STAFF
}

enum SupplierOrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum SupplierPaymentStatus {
  UNPAID
  PAID
}

enum SupplierChatSender {
  CLINIC
  SUPPLIER
}

model Supplier {
  id             String         @id @default(cuid())
  businessName   String
  slug           String         @unique
  rfc            String?        @db.VarChar(13)
  email          String
  phone          String?
  address        String?
  city           String?
  state          String?
  logoUrl        String?
  description    String?        @db.Text
  categories     String[]       @default([])
  paymentMethods String[]       @default([])
  payTransferEnabled    Boolean @default(false)
  payCashEnabled        Boolean @default(false)
  payMercadoPagoEnabled Boolean @default(false)
  mpAccessToken         String?
  status         SupplierStatus @default(PENDING)
  approvedAt     DateTime?
  rejectedReason String?

  // Perfil extendido + reputación (T1 mejoras proveedores)
  whatsapp       String?
  website        String?
  mapsUrl        String?
  minOrderAmount Int?
  shippingNote   String?
  rating         Float   @default(0)
  ratingCount    Int     @default(0)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  users    SupplierUser[]
  products SupplierProduct[]
  orders   SupplierOrder[]
  carts    SupplierCart[]
  chats    SupplierChatThread[]
  bankAccounts SupplierBankAccount[]
  reviews      SupplierReview[]
  favorites    SupplierFavorite[]

  @@index([status])
  @@map("suppliers")
}

model SupplierUser {
  id         String           @id @default(cuid())
  supplierId String
  supabaseId String
  email      String
  firstName  String
  lastName   String
  role       SupplierUserRole @default(OWNER)
  isActive   Boolean          @default(true)
  lastLogin  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supabaseId, supplierId])
  @@index([supabaseId])
  @@map("supplier_users")
}

model SupplierProduct {
  id          String   @id @default(cuid())
  supplierId  String
  name        String
  description String?  @db.Text
  category    String?
  sku         String?
  price       Float
  unit        String   @default("pza")
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier   Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  images     SupplierProductImage[]
  cartItems  SupplierCartItem[]
  orderItems SupplierOrderItem[]

  @@index([supplierId, isActive])
  @@map("supplier_products")
}

model SupplierProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product SupplierProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("supplier_product_images")
}

model SupplierCart {
  id         String   @id @default(cuid())
  clinicId   String
  supplierId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  clinic   Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  supplier Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items    SupplierCartItem[]

  @@unique([clinicId, supplierId])
  @@map("supplier_carts")
}

model SupplierCartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  cart    SupplierCart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product SupplierProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("supplier_cart_items")
}

model SupplierOrder {
  id            String                @id @default(cuid())
  orderNumber   String                @unique
  clinicId      String
  supplierId    String
  status        SupplierOrderStatus   @default(PENDING)
