  formula   Json
  notes     String?
  appliedAt DateTime @default(now())
  appliedBy String?
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, type])
  @@index([clinicId])
  @@map("formula_records")
}

model BodyMapAnnotation {
  id          String   @id @default(cuid())
  clinicId    String
  patientId   String
  recordId    String?
  mapType     String // "full_body", "face", "scalp", "feet_dorsal", "feet_plantar"
  annotations Json
  createdAt   DateTime @default(now())
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([clinicId])
  @@map("body_map_annotations")
}

model WalkInQueue {
  id          String    @id @default(cuid())
  clinicId    String
  patientId   String?
  patientName String
  service     String
  priority    Int       @default(0)
  status      String    @default("WAITING")
  assignedTo  String?
  joinedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, status])
  @@map("walk_in_queue")
}

model ResourceBooking {
  id            String   @id @default(cuid())
  clinicId      String
  appointmentId String?
  resourceType  String
  resourceName  String
  startTime     DateTime
  endTime       DateTime
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, resourceType, startTime])
  @@map("resource_bookings")
}

model ProcedureCatalog {
  id          String    @id @default(cuid())
  clinicId    String
  name        String
  code        String? // SAT code for CFDI
  /// NOM-024 — código clínico CIE-9-MC del procedimiento (separado del SAT)
  cieCode     String?   @db.VarChar(8)
  category    String // "general", "dental", "aesthetic", etc.
  basePrice   Float
  duration    Int? // minutes
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  cie9        Cie9Code? @relation(fields: [cieCode], references: [code])
  quoteItems  QuoteItem[]

  @@index([clinicId, isActive])
  @@index([cieCode])
  @@map("procedure_catalog")
}

/// Catálogo CIE-9-MC OMS. Tabla GLOBAL. Seed inicial vía
/// POST /api/admin/seed-cie9 con TOP ~100 procedimientos comunes.
model Cie9Code {
  code        String @id @db.VarChar(8)
  description String @db.VarChar(500)
  category    String @db.VarChar(120)

  procedures ProcedureCatalog[]

  @@index([category])
  @@map("cie9_codes")
}

// ── Super-admin internal notes per clinic ─────────────────────────────
model AdminClinicNote {
  id        String   @id @default(cuid())
  clinicId  String
  authorId  String? // null = super admin (sin User record)
  content   String   @db.Text
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id])

  @@index([clinicId])
  @@map("admin_clinic_notes")
}

// ── Global announcements shown inside the dashboard ───────────────────
model AdminAnnouncement {
  id        String    @id @default(cuid())
  message   String    @db.Text
  type      String    @default("info") // info | warning | success | maintenance
  active    Boolean   @default(true)
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("admin_announcements")
}

// ── Discount coupons applied to subscription payments ─────────────────
model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  type       String // percentage | fixed
  value      Float
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  maxUses    Int?
  usedCount  Int       @default(0)
  appliesTo  String    @default("all") // all | BASIC | PRO | CLINIC
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@map("coupons")
}

// ── Prescription (receta médica con QR verificable) ───────────────────
model Prescription {
  id               String    @id @default(cuid())
  // Nullable: una receta puede emitirse standalone (re-emisión, urgencia, follow-up
  // sin consulta formal). Si la consulta se elimina, la receta se conserva (SetNull).
  medicalRecordId  String?
  patientId        String
  doctorId         String
  clinicId         String
  medications      Json
  indications      String?   @db.Text
  // Diagnóstico opcional que el doctor decide incluir en la receta (PDF y
  // dashboard; NUNCA se muestra en la verificación pública).
  diagnosis        String?   @db.Text
  qrCode           String    @unique
  verifyUrl        String
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime?
  cofeprisGroup    String?
  cofeprisFolio    String?
  digitalSignature String?
  // Evidencia: resultado del chequeo IA de contraindicaciones al emitir la
  // receta (perMedication/interactions/summary + checkedAt). NUNCA se muestra
  // en la verificación pública — el endpoint /verify no lo selecciona.
  aiCheck          Json?

  // NOM-004 conservación / NOM-024 §7 — anulación LÓGICA (jamás hard-delete).
  // status: "ACTIVE" | "VOIDED". Una receta anulada se conserva en BD y el QR
  // público sigue resolviendo, pero la verificación pública muestra "ANULADA".
  status     String    @default("ACTIVE")
  voidedAt   DateTime?
  voidedBy   String?
  voidReason String?   @db.Text

  medicalRecord MedicalRecord?     @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)
  patient       Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        User               @relation(fields: [doctorId], references: [id])
  clinic        Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  // NOM-024 (Compliance Fase B) — items estructurados con FK a CUMS.
  // El JSON `medications` legacy queda intacto para datos históricos.
  items         PrescriptionItem[]

  @@index([clinicId])
  @@index([patientId])
  @@index([medicalRecordId])
  @@index([clinicId, issuedAt(sort: Desc)])
  @@map("prescriptions")
}

/// Catálogo CUMS (Cuadro Único de Medicamentos del Sector Salud).
/// Tabla GLOBAL (sin clinicId) — es estándar público SSA.
model CumsItem {
  clave             String  @id @db.VarChar(20)
  descripcion       String  @db.VarChar(500)
  presentacion      String  @db.VarChar(200)
  formaFarmaceutica String? @db.VarChar(100)
  grupoTerapeutico  String? @db.VarChar(200)
  cofeprisGroup     String? @db.VarChar(20)

  prescriptions PrescriptionItem[]

  @@index([cofeprisGroup])
  @@index([grupoTerapeutico])
  @@map("cums_items")
}

/// Item de receta — un medicamento con dosage/duration/quantity.
/// Multi-tenant via relation prescription.clinicId.
model PrescriptionItem {
  id             String   @id @default(cuid())
  prescriptionId String
  cumsKey        String   @db.VarChar(20)
  dosage         String   @db.VarChar(200)
  duration       String?  @db.VarChar(100)
  quantity       String?  @db.VarChar(50)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  cums         CumsItem     @relation(fields: [cumsKey], references: [clave])

  @@index([prescriptionId])
  @@map("prescription_items")
}

/// Cache de chequeos IA de contraindicaciones al recetar.
/// Keyed por SHA256(clinicId + patientId + contexto clínico normalizado +
/// lista de medicamentos). Si el mismo doctor revisa el mismo paciente con la
/// misma lista, se devuelve el resultado sin volver a cobrar tokens de IA
/// (mismo patrón de cache que xrayAnalysis). Multi-tenant por clinicId.
model PrescriptionAiCheck {
  hash      String   @id @db.VarChar(64)
  clinicId  String
  patientId String
  result    Json
  model     String   @db.VarChar(60)
  createdAt DateTime @default(now())

  @@index([clinicId])
  @@map("prescription_ai_checks")
}

// ═══════════════════════════════════════════════════════════
// Fase 4 — Agenda pro
// ═══════════════════════════════════════════════════════════

enum AppointmentSource {
  STAFF
  PATIENT_PORTAL
  WEBSITE
  WHATSAPP
}

/// Recurso reservable (silla/consultorio/sala/etc).
model Resource {
  id         String       @id @default(cuid())
  clinicId   String
  name       String       @db.VarChar(120)
  kind       ResourceKind @default(SILLA_DENTAL)
  color      String?      @db.VarChar(9)
  isActive   Boolean      @default(true)
  orderIndex Int          @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  clinic       Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  cost         ResourceCost?
  schedules    ResourceSchedule[]

  @@index([clinicId, isActive, orderIndex])
}

/// Tipos de recurso. Los tres primeros (CHAIR/ROOM/EQUIPMENT) son legacy:
/// se mantienen en el enum por compatibilidad con Postgres (no se pueden
/// quitar valores de un enum en PG ≤16 sin DROP TYPE). El backfill de la
/// migration 20260513120100 mapea filas existentes a los nuevos valores.
enum ResourceKind {
  CHAIR
  ROOM
  EQUIPMENT
  CONSULTORIO_DENTAL
  CONSULTORIO_GENERAL
  SILLA_DENTAL
  SALA_DE_ESPERA
  RADIOGRAFIA
  LABORATORIO
}

/// Horario semanal por Resource. Una row = una ventana (start–end) en un día.
/// Multi-ventana permitida (mañana/tarde = 2 rows con mismo (resourceId, dayOfWeek)).
/// Resource SIN rows = "siempre abierto" (backward-compat para Resources existentes).
///
/// dayOfWeek convention: 0=Monday, 1=Tuesday, ..., 6=Sunday (igual que ClinicSchedule).
/// startTime/endTime: "HH:MM" 24h, en la timezone del clinic.
model ResourceSchedule {
  id         String @id @default(cuid())
  resourceId String
  dayOfWeek  Int
  startTime  String @db.VarChar(5)
  endTime    String @db.VarChar(5)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, dayOfWeek])
  @@map("resource_schedules")
}

// ═══════════════════════════════════════════════════════════
// Mi Clínica Visual — layout isométrico 2.5D de la clínica
// ═══════════════════════════════════════════════════════════
//
// 1 layout por clínica. `elements` es un array JSON con:
//   { id: number, type: string, col: number, row: number, rotation: 0|90|180|270, resourceId?: string }
// Para tipos "chair" → resourceId apunta al Resource(kind=CHAIR) real;
// el editor solo coloca/posiciona el sillón existente, no crea uno nuevo.
// Para tipos non-chair (paredes, puertas, lavabos…) resourceId es null y el
// id es local al layout.
model ClinicLayout {
  id        String   @id @default(cuid())
  clinicId  String   @unique
  name      String   @default("Layout principal") @db.VarChar(120)
  elements  Json     @default("[]")
  metadata  Json? // { zoom, panOffset, lastEditAt, gridSize }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("clinic_layouts")
}

/// Lista de espera de pacientes que quieren adelantar su cita
/// si surge un hueco.
model WaitlistEntry {
  id                String           @id @default(cuid())
  clinicId          String
  patientId         String
  createdByUserId   String
  reason            String?          @db.VarChar(200)
  priority          WaitlistPriority @default(NORMAL)
  preferredDoctorId String?
  preferredWindow   String?          @db.VarChar(80)
  notes             String?          @db.VarChar(500)

  resolvedAt            DateTime? @db.Timestamptz(6)
  resolvedAppointmentId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  clinic          Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy       User    @relation("WaitlistCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  preferredDoctor User?   @relation("WaitlistPreferredDoctor", fields: [preferredDoctorId], references: [id], onDelete: SetNull)

  @@index([clinicId, resolvedAt])
  @@index([patientId])
}

enum WaitlistPriority {
  LOW
  NORMAL
  HIGH
}

// ═══════════════════════════════════════════════════════════
// Fase 6 — Inbox unificado (WhatsApp + Email + Form + Validation + Reminder)
// ═══════════════════════════════════════════════════════════

enum InboxChannel {
  WHATSAPP
  EMAIL
  PORTAL_FORM
  VALIDATION
  REMINDER
  /// Chat in-app del portal del paciente (WS2-T2). Sin entrega externa: la
  /// "entrega" es la propia DB (el paciente lo lee en /paciente/inbox).
  PORTAL
}

enum InboxStatus {
  UNREAD
  READ
  ARCHIVED
  SNOOZED
}

enum MessageDirection {
  IN
  OUT
}

model InboxThread {
  id            String       @id @default(cuid())
  clinicId      String
  channel       InboxChannel
  /// ID en el sistema externo: Twilio Conversation SID, Postmark Message-ID, etc.
  externalId    String?
  patientId     String?
  subject       String
  status        InboxStatus  @default(UNREAD)
  assignedToId  String?
  snoozedUntil  DateTime?
  lastMessageAt DateTime
  tags          String[]     @default([])
  /// Bot de WhatsApp: false = el staff tomó el control del hilo (el bot calla).
  botActive     Boolean      @default(true)
  /// Estado multi-turno del bot (p. ej. agendado en progreso). Null = sin estado.
  botState      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  clinic     Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient    Patient?       @relation(fields: [patientId], references: [id], onDelete: SetNull)
  assignedTo User?          @relation("InboxAssignee", fields: [assignedToId], references: [id])
  messages   InboxMessage[]
  reminders  Reminder[]

  @@unique([clinicId, channel, externalId])
  @@index([clinicId, status, lastMessageAt(sort: Desc)])
  @@index([clinicId, channel, lastMessageAt(sort: Desc)])
  @@index([assignedToId, status])
  @@index([snoozedUntil])
  @@map("inbox_threads")
}

model InboxMessage {
  id          String           @id @default(cuid())
  threadId    String
  direction   MessageDirection
  body        String           @db.Text
  attachments Json? // [{ name, url, mime, size }]
  sentAt      DateTime         @default(now())
  sentById    String?
  externalId  String?
  /// true = nota interna del staff (no se envía al canal externo).
  isInternal  Boolean          @default(false)

  /// Entrega REAL reportada por Meta en el webhook (`value.statuses[]`):
  /// SENT | DELIVERED | READ | FAILED. Null = Meta todavía no reporta nada
  /// (que NO es lo mismo que "no llegó"): la UI lo pinta como "enviado".
  deliveryStatus String?
  deliveredAt    DateTime? @db.Timestamptz(3)
  readAt         DateTime? @db.Timestamptz(3)
  /// Código y título CRUDOS del error de Meta (131047, 190, 131042…). El
  /// código se guarda aparte del texto porque Meta cambia la redacción y el
  /// idioma del mensaje, pero nunca el número.
  errorCode      Int?
  errorTitle     String?

  thread InboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sentBy User?       @relation(fields: [sentById], references: [id])

  @@unique([threadId, externalId])
  @@index([threadId, sentAt])
  /// Un status de Meta solo trae el wamid: el mensaje se busca por externalId
  /// a secas, y el @@unique de arriba no sirve (su columna guía es threadId).
  @@index([externalId])
  @@map("inbox_messages")
}

/// Configuración del bot de WhatsApp por clínica (multi-tenant: 1:1 con Clinic).
/// Cerebro híbrido: reglas/FAQ (motor en src/lib/whatsapp/bot/engine.ts) +
/// Claude (ai.ts, T3) + agenda (booking.ts, T4).
model WhatsAppBotConfig {
  id                  String   @id @default(cuid())
  clinicId            String   @unique
  enabled             Boolean  @default(false)
  botName             String   @default("Asistente")
  persona             String?  @db.Text
  greeting            String?  @db.Text
  /// Horario de atención del bot. Shape: { "0": { enabled, open, close }, … }
  /// con día 0=Lunes … 6=Domingo (igual que ClinicSchedule); open/close "HH:MM".
  businessHours       Json?
  afterHoursMsg       String?  @db.Text
  canAnswerFaq        Boolean  @default(true)
  canBookAppointments Boolean  @default(false)
  fallbackToHuman     Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  clinic Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  faqs   WhatsAppBotFaq[]

  @@map("whatsapp_bot_configs")
}

/// Pregunta/respuesta frecuente que el bot responde por reglas (match de texto).
model WhatsAppBotFaq {
  id        String   @id @default(cuid())
  clinicId  String
  configId  String
  question  String   @db.Text
  answer    String   @db.Text
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  config WhatsAppBotConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([configId, enabled, order])
  @@map("whatsapp_bot_faqs")
}

enum ReminderStatus {
  PENDING
  DONE
  DISMISSED
}

model Reminder {
  id            String         @id @default(cuid())
  clinicId      String
  createdById   String
  assignedToId  String
  patientId     String?
  threadId      String?
  title         String
  body          String?        @db.Text
  dueAt         DateTime
  status        ReminderStatus @default(PENDING)
  completedAt   DateTime?
  completedById String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  clinic     Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdBy  User         @relation("ReminderCreator", fields: [createdById], references: [id])
  assignedTo User         @relation("ReminderAssignee", fields: [assignedToId], references: [id])
  patient    Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  thread     InboxThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@index([clinicId, status, dueAt])
  @@index([assignedToId, status, dueAt])
  @@index([dueAt])
  @@map("reminders")
}

// ═══════════════════════════════════════════════════════════════════
// Analytics & Insights — Push 1
// ═══════════════════════════════════════════════════════════════════

/// Línea de tiempo operativa de una cita. Capturamos timestamps en cada
/// transición de status (CHECKED_IN → IN_CHAIR → IN_PROGRESS → COMPLETED →
/// CHECKED_OUT) para alimentar reportes de ocupación, espera y journey.
/// totalWaitMin = inChairAt - arrivedAt; totalConsultMin = consultEndAt -
/// consultStartAt. Calculados en el endpoint que upserts el timeline.
model AppointmentTimeline {
  id              String    @id @default(cuid())
  appointmentId   String    @unique
  arrivedAt       DateTime? @db.Timestamptz(6)
  inChairAt       DateTime? @db.Timestamptz(6)
  consultStartAt  DateTime? @db.Timestamptz(6)
  consultEndAt    DateTime? @db.Timestamptz(6)
  checkoutAt      DateTime? @db.Timestamptz(6)
  totalWaitMin    Int?
  totalConsultMin Int?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_timelines")
}

/// Costos mensuales por sillón/recurso para calcular margen real
/// (renta + operativos vs ingresos generados por citas en ese sillón).
/// Editado por admin desde el form en /dashboard/analytics → Costos.
model ResourceCost {
  id          String   @id @default(cuid())
  resourceId  String   @unique
  monthlyRent Decimal  @default(0) @db.Decimal(10, 2)
  monthlyOps  Decimal  @default(0) @db.Decimal(10, 2)
  notes       String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@map("resource_costs")
}

/// Predicción de no-show generada por IA (Claude) basada en factores:
/// historial del paciente, día/hora, tipo procedimiento, tiempo desde
/// última cita. Persistimos para que el badge de la agenda no recalcule
/// cada render. Refresh manual o vía cron al crear cita.
model NoShowPrediction {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  probability   Float /// 0.0 a 1.0
  factors       Json /// Array de { label: string, weight: number, reason: string }
  predictedAt   DateTime @default(now()) @db.Timestamptz(6)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([predictedAt])
  @@map("no_show_predictions")
}

/// Resumen semanal generado por IA cada domingo 22:00 (cron). Bullets
/// accionables comparando esta semana vs anterior. Notificación in-app
/// (NO email). El usuario marca read=true al abrir el insight.
model WeeklyInsight {
  id        String   @id @default(cuid())
  clinicId  String
  weekStart DateTime @db.Timestamptz(6)
  weekEnd   DateTime @db.Timestamptz(6)
  summary   String   @db.VarChar(500) /// 1-2 oraciones top-line
  insights  Json /// Array de { tone, title, detail }
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, weekStart])
  @@map("weekly_insights")
}

/// NPS post-cita 1-5. Capturado vía portal del paciente o link en
/// recordatorio WA. Alimenta el promedio de satisfacción del doctor.
model PatientSatisfaction {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  score         Int /// 1-5
  comment       String?  @db.VarChar(1000)
  submittedAt   DateTime @default(now()) @db.Timestamptz(6)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([submittedAt])
  @@map("patient_satisfactions")
}

/// Pantalla TV configurable. Cada clínica puede tener N pantallas
/// con modos OPERATIONAL (halos), MARKETING (carousel + testimonios)
/// o HYBRID (split). publicSlug es la URL pública que se carga en la TV.
model TVDisplay {
  id         String   @id @default(cuid())
  clinicId   String
  name       String   @db.VarChar(120)
  mode       String   @db.VarChar(20) /// OPERATIONAL | MARKETING | HYBRID
  config     Json /// promociones, testimonios, branding, etc.
  publicSlug String   @unique @db.VarChar(80)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, active])
  @@map("tv_displays")
}

// ═══════════════════════════════════════════════════════════════════
// Bug Audit — registros de auditoría de seguridad/perf/calidad.
// Tabla global (no multi-tenant), solo SUPER_ADMIN puede invocarla
// desde /dashboard/admin/bug-audit. RLS habilitada en SQL para
// bloquear acceso directo a la DB sin service role.
// ═══════════════════════════════════════════════════════════════════

model BugAuditRun {
