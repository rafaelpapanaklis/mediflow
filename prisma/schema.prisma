model WhatsAppReminder {
  id            String                 @id @default(cuid())
  clinicId      String
  appointmentId String? // null for non-appointment reminders (recalls)
  patientPhone  String? // for recall reminders without appointment
  message       String? // message sent (legacy text) o template key con prefijo (ENDO_/PERIO_/ORTHO_/IMPLANT_<KEY>)
  // Argumentos dinámicos del template — el worker los pasa al renderer del
  // diccionario correspondiente. Ej: { installmentNumber, daysOverdue, … }.
  // Null para mensajes legacy o templates sin argumentos.
  payload       Json?
  type          String                 @default("APPOINTMENT") // APPOINTMENT | RECALL | ENDO | PERIO | ORTHO | IMPLANT
  status        String                 @default("PENDING") // PENDING | SENT | FAILED | CANCELLED — TEXT en prod (el type Postgres nunca existió); filas legacy con 'ACTIVE' = pendiente
  sentAt        DateTime?
  errorMsg      String?
  scheduledFor  DateTime               @default(now())
  patientReply  String?
  repliedAt     DateTime?
  createdAt     DateTime               @default(now())

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([clinicId, status, sentAt])
  @@index([clinicId, type, createdAt])
  @@map("whatsapp_reminders")
}

// ── Multi-category models ─────────────────────────────────────────────────────

