/// Catálogo de marcas/modelos de implantes que la clínica usa habitualmente.
/// Sirve como selector al crear un Implant (en lugar de typear modelName libre).
/// Cada entrada cubre una combinación marca+modelo con sus dimensiones
/// estándar (diámetros y longitudes disponibles) y plataformas (Bone Level,
/// Tissue Level, RP, NP, etc.).
model ImplantCatalogModel {
  id               String                   @id @default(cuid())
  clinicId         String
  brand            ImplantBrand
  /// Si brand=OTRO, nombre comercial libre.
  brandCustomName  String?
  modelName        String
  /// Lista de plataformas disponibles para este modelo (ej. ["RC","NC"]).
  platforms        String[]                 @default([])
  /// Diámetros disponibles en mm (ej. [3.3, 4.1, 4.8]).
  diametersMm      Decimal[]                @db.Decimal(3, 1)
  /// Longitudes disponibles en mm (ej. [8, 10, 12]).
  lengthsMm        Decimal[]                @db.Decimal(4, 1)
  surfaceTreatment ImplantSurfaceTreatment?
  connectionType   ImplantConnectionType?
  notes            String?
  isActive         Boolean                  @default(true)
  createdBy        String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  deletedAt        DateTime?

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, brand, modelName])
  @@index([clinicId, isActive])
  @@map("implant_catalog_models")
}

// ─── Clinical-shared cross-cutting (Sprint cierre dental) ────────────────────
//
// 8 modelos compartidos por los 5 módulos dentales: pediatrics, endodontics,
// periodontics, implants, orthodontics. Proveen capacidades transversales
// (fotos clínicas, plantillas SOAP, hojas de referencia, órdenes de lab,
// links a plan de tratamiento, exportación PDF, share con paciente,
// recordatorios clínicos) sin duplicar lógica por módulo.

enum ClinicalModule {
  pediatrics
  endodontics
  periodontics
  implants
  orthodontics
  // Fotos clínicas de la ficha del paciente (tab "Fotos clínicas"),
  // sin especialidad — extraorales/intraorales por etapa.
  general
}

enum ClinicalPhotoStage {
  pre
  during
  post
  control
}

enum ClinicalPhotoType {
  // Pediátrico
  oral_general
  eruption_check
  sealant_pre
  sealant_post
  fluoride_app
  behavior_documentation
  // Endodoncia
  endo_access
  endo_working_length
  endo_obturation
  // Periodoncia
  perio_initial
  perio_postsrp
  perio_surgery
  perio_pre_srp
  perio_pre_surgery
  perio_post_surgery
  perio_suture_removal
  perio_maintenance_check
  perio_recession_baseline
  // Implantes — set v1 (pediatrics base)
  implant_site_pre
  implant_placement
  implant_healing
  implant_prosthetic
  // Implantes — set v2 (fases granulares spec implantes 4/5)
  pre_surgical
  surgical_phase
  second_stage
  prosthetic_placement
  follow_up_radiograph
  peri_implant_check
  // Cross genéricos
  pre_treatment
  post_treatment
  // Ortodoncia
  ortho_extraoral_front
  ortho_extraoral_profile
  ortho_intraoral
  ortho_progress
  // Fotos clínicas generales (módulo `general` — ficha del paciente)
  extraoral_front
  extraoral_smile
  extraoral_profile_right
  extraoral_profile_left
  intraoral_front
  intraoral_lateral_right
  intraoral_lateral_left
  occlusal_upper
  occlusal_lower
  // Cross
  other
}

enum ReferralLetterStatus {
  draft
  sent
  acknowledged
  completed
}

enum ReferralLetterChannel {
  whatsapp
  email
  print
}

enum LabOrderStatus {
  draft
  sent
  in_progress
  received
  cancelled
}

enum LabOrderType {
  // Endodoncia / Restauración
  post_core
  // Periodoncia / Implantes
  surgical_guide
  custom_abutment
  crown
  // Ortodoncia
  ortho_appliance
  retainer
  // Pediatría — instalada para v1.1
  ped_space_maintainer_lab
  // Periodoncia
  perio_splint
  perio_custom_graft
  perio_maintenance_tray
  // Cross
