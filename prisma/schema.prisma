// ═══════════════════════════════════════════════════════════════════
// Marketplace de módulos (Sprint 1)
//
// Modelo de monetización por módulo: cada clínica activa N módulos a
// $229–$399/mes. Trial de 14 días desbloquea TODO; post-trial sólo los
// módulos con ClinicModule.status='active' y currentPeriodEnd futuro.
// La tabla Order es de marketplace (compras de módulos), distinta de
// SubscriptionInvoice (billing anual de la clínica completa).
// ═══════════════════════════════════════════════════════════════════

/// Catálogo de módulos disponibles para venta. Tabla GLOBAL (sin
/// clinicId). Seed canónico en prisma/seed.ts. iconKey es el nombre
/// del icono de lucide-react que usa la UI del marketplace.
model Module {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  category        String
  description     String   @db.Text
  iconKey         String   @map("icon_key")
  iconBg          String   @map("icon_bg")
  iconColor       String   @map("icon_color")
  features        String[]
  priceMxnMonthly Int      @map("price_mxn_monthly")
  isCore          Boolean  @default(false) @map("is_core")
  dependsOn       String[] @map("depends_on")
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")

  clinicModules ClinicModule[]

  @@map("modules")
}

/// Relación clínica-módulo activo. Un Stripe Subscription por módulo
/// (decisión de Sprint 1: 1:1 con stripeSubscriptionId). Estados:
///   active — pagado y vigente
///   trial — periodo de prueba post-compra individual (futuro, ignorar)
///   paused — pago falló, pendiente de retry
///   cancelled — cancelado por el usuario o admin
model ClinicModule {
  id                   String    @id @default(cuid())
  clinicId             String    @map("clinic_id")
  moduleId             String    @map("module_id")
  status               String
  billingCycle         String    @map("billing_cycle")
  activatedAt          DateTime  @default(now()) @map("activated_at")
  currentPeriodStart   DateTime  @map("current_period_start")
  currentPeriodEnd     DateTime  @map("current_period_end")
  cancelledAt          DateTime? @map("cancelled_at")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  paypalSubscriptionId String?   @unique @map("paypal_subscription_id")
  paymentMethod        String    @map("payment_method")
  pricePaidMxn         Int       @map("price_paid_mxn")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id])

  @@unique([clinicId, moduleId])
  @@index([clinicId])
  @@index([currentPeriodEnd])
  @@map("clinic_modules")
}

/// Log de uso por módulo — alimenta sugerencias post-trial.
model ModuleUsageLog {
  id        String   @id @default(cuid())
  clinicId  String   @map("clinic_id")
  moduleKey String   @map("module_key")
  action    String
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, moduleKey])
  @@index([createdAt])
  @@map("module_usage_logs")
}

/// Orden de checkout. Una orden puede contener N módulos. Snapshot de
/// montos al momento de la compra (no se recalcula). cfdiId/cfdiUuid se
/// llenan tras emisión vía FacturAPI en el webhook del pago.
model Order {
  id                  String    @id @default(cuid())
  clinicId            String    @map("clinic_id")
  status              String
  paymentMethod       String    @map("payment_method")
  billingCycle        String    @map("billing_cycle")
  moduleIds           String[]  @map("module_ids")
  subtotalMxn         Int       @map("subtotal_mxn")
  annualBonusMxn      Int       @default(0) @map("annual_bonus_mxn")
  volumeDiscountPct   Int       @default(0) @map("volume_discount_pct")
  volumeDiscountMxn   Int       @default(0) @map("volume_discount_mxn")
  taxMxn              Int       @map("tax_mxn")
  totalMxn            Int       @map("total_mxn")
  speiReference       String?   @unique @map("spei_reference")
  stripePaymentIntent String?   @map("stripe_payment_intent")
  paypalOrderId       String?   @map("paypal_order_id")
  cfdiId              String?   @map("cfdi_id")
  cfdiUuid            String?   @map("cfdi_uuid")
  createdAt           DateTime  @default(now()) @map("created_at")
  paidAt              DateTime? @map("paid_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([status])
  @@map("orders")
}

/// Carrito persistente — opción B del brief. Una clínica = un carrito.
/// moduleIds es array de Module.id; el cliente decide billingCycle al
/// hacer checkout (no se persiste aquí).
model Cart {
  clinicId  String   @id @map("clinic_id")
  moduleIds String[] @map("module_ids")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("carts")
}

// ═══════════════════════════════════════════════════════════════════
// Afiliados / Referidos — actor externo (espejo del patrón DentalLab).
// Modelo afiliado-referido con comisión RECURRENTE: el afiliado refiere
// clínicas vía ?ref=<referralCode> y gana un % de cada factura pagada
// (invoice.paid de Stripe) mientras la suscripción siga activa. Tablas
// GLOBALES (sin clinicId) — un afiliado refiere a muchas clínicas.
// Solo fundación: sin panel de afiliado todavía.
// ═══════════════════════════════════════════════════════════════════
enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Affiliate {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  email         String          @unique
  status        AffiliateStatus @default(PENDING)
  approvedAt    DateTime?
  referralCode  String          @unique
  commissionPct Float           @default(20)
  /// Modalidad de pago para sus PRÓXIMOS referidos: "recurring" | "onetime".
  /// Se CONGELA por clínica en AffiliateClinicTerms al atribuirse el alta, así
  /// que cambiarla nunca afecta a las clínicas ya referidas.
  payoutMode    String          @default("recurring")
  payoutMethod  String?
  payoutDetails String?
  /// Manager de cuenta asignado (sql/afiliados-atribucion-soporte.sql). null =
  /// sin manager: la pantalla de soporte cae al canal general, nunca a una
  /// tarjeta vacía. Mismo catálogo global que usan las clínicas.
  accountManagerId String?
  /// Quién lo invitó al programa, vía su link de invitación
  /// (/afiliados/registro?inv=<referralCode>). null = se registró directo.
  ///
  /// PERMANENTE Y DE UN SOLO NIVEL. Se escribe UNA vez, al crear la cuenta, y
  /// no hay ninguna superficie —panel, admin o API— que lo cambie o lo borre:
  /// si se pudiera romper, cualquiera se desvincularía justo antes de que su
  /// invitador cobrara un bono por red.
  ///
  /// El invitado es un afiliado NORMAL: misma comisión por plan, elige su
  /// propia modalidad y gana sus propios bonos. Su invitador NO cobra un peso
  /// por las clínicas del invitado; su premio son los bonos por red
  /// (AffiliateNetworkBonusAward), que cuentan las clínicas activas de sus
  /// invitados DIRECTOS y nunca acumulan hacia arriba más de un nivel.
  invitedByAffiliateId String?

  /// ── Página pública personalizada (/socio/<slug>) ─────────────────────
  /// sql/afiliados-pagina-personal.sql.
  ///
  /// DOS JUEGOS DE CAMPOS A PROPÓSITO. Estos tres son lo PUBLICADO: lo único
  /// que lee /socio/<slug>, y solo los escribe la aprobación del admin. Los
  /// `*Pending` de abajo son el borrador del socio.
  ///
  /// Los tres en null = este socio no personalizó nada, y su página se ve
  /// EXACTAMENTE como antes de que esto existiera. Ese es el caso por defecto
  /// y el que no se puede romper.
  photoUrl      String?
  /// Presentación del socio con su voz. Se guarda y se pinta como TEXTO
  /// PLANO: es contenido de un tercero en nuestro dominio, nada de HTML ni
  /// markdown. El tope de longitud lo pone el código (page-config.ts).
  bio           String?
  /// [{ id, visible, orden }] — QUÉ secciones se ven y en qué orden. El
  /// contenido de cada sección sigue siendo el del home; esto no lo edita.
  /// Las secciones con el CTA de registro no son apagables (lo impone el
  /// código): son las que sostienen la atribución del socio.
  sectionsConfig Json?

  /// 'draft' | 'pending' | 'approved' | 'rejected'. Los valores válidos los
  /// define src/lib/affiliates/page-config.ts, no un enum de Postgres —
  /// mismo criterio que AffiliateSupportTicket.status.
  pageStatus       String    @default("draft")
  /// Motivo del rechazo tal cual lo escribe el admin. El afiliado LO VE: es
  /// lo que le dice qué corregir antes de reenviar.
  pageRejectReason String?
  pageSubmittedAt  DateTime? @db.Timestamptz(6)
  pageReviewedAt   DateTime? @db.Timestamptz(6)

  /// El BORRADOR que espera revisión. Lo escribe el afiliado desde su panel y
  /// NUNCA lo ve el público. Se limpia al aprobar (su contenido ya pasó a las
  /// columnas publicadas) y se CONSERVA al rechazar, para que pueda corregir
  /// lo que escribió en vez de volver a escribirlo.
  photoUrlPending       String?
  bioPending            String?
  sectionsConfigPending Json?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  clinics     Clinic[]
  commissions AffiliateCommission[]
  users       AffiliateUser[]
  links           AffiliateLink[]
  conversions     AffiliateConversion[]
  affiliateCoupons AffiliateCoupon[]
  supportTickets   AffiliateSupportTicket[]
  accountManager   AccountManager? @relation(fields: [accountManagerId], references: [id])
  invitedBy        Affiliate?      @relation("AffiliateInvites", fields: [invitedByAffiliateId], references: [id])
  invited          Affiliate[]     @relation("AffiliateInvites")

  @@index([status])
  @@index([accountManagerId])
  @@index([invitedByAffiliateId])
  /// Cola de moderación del admin: WHERE pageStatus='pending' ORDER BY pageSubmittedAt.
  @@index([pageStatus, pageSubmittedAt])
  @@map("affiliates")
}

model AffiliateCommission {
  id              String    @id @default(cuid())
  affiliateId     String
  clinicId        String
  stripeInvoiceId String    @unique
  amountMxn       Float
  commissionMxn   Float
  /// Cómo se calculó: "pct" (% del nivel) | "recurring" (fijo por plan y mes)
  /// | "onetime" (pago único de la clínica). Ver @/lib/affiliates/payout-core.
  kind            String    @default("pct")
  /// Meses que cubre la factura (anual = 12). Multiplica el fijo recurrente.
  monthsCovered   Int       @default(1)
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  paidAt          DateTime?

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId, status])
  @@map("affiliate_commissions")
}

