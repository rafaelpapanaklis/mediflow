  userId      String?
  runAt       DateTime @default(now()) @db.Timestamptz(6)
  triggeredBy String
  status      String   @default("completed")
  durationMs  Int      @default(0)
  summary     Json
  items       Json     @default("[]")

  @@index([runAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([clinicId])
