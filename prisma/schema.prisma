  other
}

enum ClinicalReminderStatus {
  pending
  sent
  completed
  cancelled
}

// ── ClinicalPhoto ───────────────────────────────────────────────────────────
//
// Foto clínica unificada para los 5 módulos. Almacena URL pública en
// Supabase storage bucket `clinical-photos` (RLS por clinicId). Soporta
// thumbnail aparte para grids ligeros y soft-delete (deletedAt).
model ClinicalPhoto {
  id           String             @id @default(cuid())
  clinicId     String
  patientId    String
  module       ClinicalModule
  toothFdi     Int? // 11–48 (permanente) o 51–85 (temporal)
  photoType    ClinicalPhotoType
  stage        ClinicalPhotoStage
  capturedAt   DateTime           @default(now())
  capturedBy   String
  blobUrl      String
  thumbnailUrl String?
  // Bytes del binario principal ALMACENADO (post-compresión). Nullable:
  // fotos previas a la ficha v3 no lo registran y no suman a la cuota.
  sizeBytes    Int?
  notes        String?
  // Anotaciones libres sobre la foto (eg. "diente 51 erupcionando").
  annotations  Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  clinic         Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient        Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  capturedByUser User    @relation("ClinicalPhotoCapturedBy", fields: [capturedBy], references: [id])

  @@index([clinicId, patientId, module])
  @@index([clinicId, patientId, photoType])
  @@index([patientId, capturedAt(sort: Desc)])
  @@index([clinicId, deletedAt])
  @@map("clinical_photos")
}

// ── ClinicalEvolutionTemplate ───────────────────────────────────────────────
//
// Plantilla SOAP por módulo + clínica. soapTemplate guarda 4 strings con
// placeholders {{patient.firstName}} etc. proceduresPrefilled: lista de
// IDs de ProcedureCatalog. materialsPrefilled: lista de InventoryItem IDs.
model ClinicalEvolutionTemplate {
  id                  String         @id @default(cuid())
  clinicId            String
  module              ClinicalModule
  name                String
  soapTemplate        Json // { S: string; O: string; A: string; P: string }
  proceduresPrefilled String[]       @default([])
  materialsPrefilled  String[]       @default([])
  isDefault           Boolean        @default(false)
  createdBy           String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  clinic        Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdByUser User   @relation("EvolutionTemplateCreatedBy", fields: [createdBy], references: [id])

  @@unique([clinicId, module, name])
  @@index([clinicId, module, isDefault])
  @@map("clinical_evolution_templates")
}

// ── DoctorContact ───────────────────────────────────────────────────────────
//
// Contactos de doctores externos para hojas de referencia. La cédula
// profesional es opcional pero recomendada para que aparezca en el PDF.
model DoctorContact {
  id         String    @id @default(cuid())
  clinicId   String
  fullName   String
  specialty  String?
  cedula     String?
  phone      String?
  email      String?
  clinicName String?
  address    String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  clinic          Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  referralLetters ReferralLetter[]

  @@index([clinicId, fullName])
  @@map("doctor_contacts")
}

// ── ReferralLetter ──────────────────────────────────────────────────────────
//
// Hoja de referencia/interconsulta. summary se pre-llena desde el módulo
// origen (edad, dx, hábitos, alergias). pdfUrl apunta al PDF generado y
// guardado en PatientFile. status trackea ciclo: draft → sent → completed.
model ReferralLetter {
  id             String                 @id @default(cuid())
  clinicId       String
  patientId      String
  module         ClinicalModule
  contactId      String?
  authorId       String
  reason         String
  summary        String                 @db.Text
  pdfUrl         String?
  status         ReferralLetterStatus   @default(draft)
  sentAt         DateTime?
  sentChannel    ReferralLetterChannel?
  acknowledgedAt DateTime?
  completedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?

  clinic  Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  author  User           @relation("ReferralLetterAuthor", fields: [authorId], references: [id])
  contact DoctorContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([clinicId, patientId, module])
  @@index([clinicId, status])
  @@map("referral_letters")
}

// ── LabPartner ──────────────────────────────────────────────────────────────
//
// Laboratorio externo asociado a la clínica. Se reutiliza por todas las
// LabOrder del clinicId.
model LabPartner {
  id          String    @id @default(cuid())
  clinicId    String
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  clinic    Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  labOrders LabOrder[]

  @@index([clinicId, isActive])
  @@map("lab_partners")
}

// ── LabOrder ────────────────────────────────────────────────────────────────
//
// Orden de laboratorio polimórfica por módulo. spec guarda detalles
// específicos por orderType (Json libre). pdfUrl apunta al PDF generado.
model LabOrder {
  id         String         @id @default(cuid())
  clinicId   String
  patientId  String
  module     ClinicalModule
  partnerId  String?
  authorId   String
  orderType  LabOrderType
  spec       Json
  toothFdi   Int?
  shadeGuide String?
  dueDate    DateTime?
  pdfUrl     String?
  status     LabOrderStatus @default(draft)
  sentAt     DateTime?
  receivedAt DateTime?
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  clinic  Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  author  User        @relation("LabOrderAuthor", fields: [authorId], references: [id])
  partner LabPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([clinicId, patientId, module])
  @@index([clinicId, status])
  @@map("lab_orders")
}

// ── TreatmentLink ───────────────────────────────────────────────────────────
//
// Une una sesión específica de un módulo (eg. un Sealant aplicado, una
// FluorideApplication, un EndodonticTreatment) con una TreatmentSession
// del plan general (TreatmentPlan). Cuando se crea, marca la
// TreatmentSession como completada (completedAt = now()).
//
// moduleEntityType es el nombre lógico (eg. "ped-sealant", "endo-treatment").
// moduleSessionId es el id del registro del módulo. Tabla polimórfica:
// no hay FK al moduleSessionId — la consistencia se garantiza por las
// server actions que crean los links.
model TreatmentLink {
  id                 String         @id @default(cuid())
  clinicId           String
  module             ClinicalModule
  moduleEntityType   String
  moduleSessionId    String
  treatmentSessionId String
  linkedBy           String
  notes              String?
  createdAt          DateTime       @default(now())
  deletedAt          DateTime?

  clinic           Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  treatmentSession TreatmentSession @relation(fields: [treatmentSessionId], references: [id], onDelete: Cascade)
  author           User             @relation("TreatmentLinkAuthor", fields: [linkedBy], references: [id])

  @@unique([moduleEntityType, moduleSessionId, treatmentSessionId])
  @@index([clinicId, treatmentSessionId])
  @@index([clinicId, module])
  @@map("treatment_links")
}

// ── PatientShareLink ────────────────────────────────────────────────────────
//
// Token público con expiración (default 30d) para que el paciente vea un
// resumen del módulo en /share/p/[token]. revokedAt opcional para invalidar.
model PatientShareLink {
  id         String         @id @default(cuid())
  clinicId   String
  patientId  String
  module     ClinicalModule
  token      String         @unique
  expiresAt  DateTime
  createdBy  String
  viewCount  Int            @default(0)
  lastViewed DateTime?
  revokedAt  DateTime?
  createdAt  DateTime       @default(now())

  clinic        Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdByUser User    @relation("PatientShareLinkCreator", fields: [createdBy], references: [id])

  @@index([clinicId, patientId, module])
  @@index([expiresAt])
  @@map("patient_share_links")
}

// ── ClinicalReminder ────────────────────────────────────────────────────────
//
// Recordatorio clínico programado (no es lo mismo que Reminder existente
// que es manual). Cada recordatorio representa una tarea recurrente o
// puntual: control de erupción anual, profilaxis 6m, cumpleaños, etc.
// El cron diario (06:00 MX) detecta los con dueDate <= today + 7 y crea
// WhatsAppReminder con la plantilla correspondiente.
model ClinicalReminder {
  id                 String                 @id @default(cuid())
  clinicId           String
  patientId          String
  module             ClinicalModule
  reminderType       ClinicalReminderType
  dueDate            DateTime
  status             ClinicalReminderStatus @default(pending)
  message            String?
  payload            Json?
  whatsappReminderId String?
  triggeredAt        DateTime?
  completedAt        DateTime?
  createdBy          String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?

  clinic        Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdByUser User    @relation("ClinicalReminderCreator", fields: [createdBy], references: [id])

  @@index([clinicId, patientId, module])
  @@index([status, dueDate])
  @@index([reminderType, status])
  @@map("clinical_reminders")
}

// ─────────────────────────────────────────────────────────────────────────
// AFFILIATE USERS (Fase 2)
// Usuario de un Afiliado/Referido. El afiliado es un actor EXTERNO global
// (sin clinicId) que autentica vía Supabase Auth, igual que DentalLabUser.
// affiliateId SIEMPRE sale de la sesión (getAffiliateContext), nunca del body.
// Ubicado al final del schema a propósito, para no chocar con ramas paralelas.
// ─────────────────────────────────────────────────────────────────────────
model AffiliateUser {
  id          String   @id @default(cuid())
  supabaseId  String   @unique
  affiliateId String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@map("affiliate_users")
}

// ─────────────────────────────────────────────────────────────────────────
// AI TOKEN BILLING (Fase 1 — fundación, T1)
// Cobro a cada clínica del consumo de IA del BOT DE WHATSAPP. MediFlow paga
// Anthropic central (USD) y cobra a la clínica en MXN con un fee OCULTO (+8%).
// Dinero SIEMPRE en centavos enteros (Int), NUNCA Float. Multi-tenant por
// clinicId, SIN relación Prisma a Clinic (como AffiliateCommission); la FK vive
// en sql/ai-billing.sql. NO confundir con el cupo Clinic.aiTokensUsed/Limit
// (otro concepto: asistente / rayos X).
// ─────────────────────────────────────────────────────────────────────────

enum AiWalletStatus {
  ACTIVE
  PAUSED
}

enum AiWalletTxType {
  TOPUP
  CHARGE
  REFUND
  ADJUSTMENT
}

enum AiWalletTxSource {
  STRIPE
  MERCADOPAGO
  SPEI
  USAGE
  ADMIN
}

enum AiTopupMethod {
  STRIPE
  MERCADOPAGO
  SPEI
}

enum AiTopupStatus {
  PENDING
  PAID
  FAILED
  REJECTED
}

/// Monedero de IA por clínica (1:1 con Clinic). Saldo prepago en MXN (centavos).
model AiWallet {
  id                         String         @id @default(cuid())
  clinicId                   String         @unique
  balanceCents               Int            @default(0)
  autoRecharge               Boolean        @default(false)
  autoRechargeThresholdCents Int            @default(0)
  autoRechargeAmountCents    Int            @default(0)
  stripePaymentMethodId      String?
  status                     AiWalletStatus @default(ACTIVE)
  lowBalanceNotifiedAt       DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  @@map("ai_wallets")
}

/// Evento de consumo de IA (1 por llamada facturable a Claude). Guarda el costo
/// real de Anthropic en micro-USD y el cobro final en MXN (billedCents ya
/// incluye fx + fee oculto).
model AiUsageEvent {
  id            String   @id @default(cuid())
  clinicId      String
  feature       String   @default("whatsapp_bot")
  model         String
  inputTokens   Int
  outputTokens  Int
  cacheTokens   Int      @default(0)
  costUsdMicros Int
  fxRate        Float
  feePct        Float
  billedCents   Int
  threadId      String?
  createdAt     DateTime @default(now())

  @@index([clinicId, createdAt])
  @@map("ai_usage_events")
}

/// Libro mayor del monedero: cada movimiento (+/-) con el saldo resultante.
model AiWalletTransaction {
  id                String           @id @default(cuid())
  clinicId          String
  type              AiWalletTxType
  amountCents       Int
  balanceAfterCents Int
  source            AiWalletTxSource
  reference         String?
  note              String?
  createdAt         DateTime         @default(now())

  @@index([clinicId, createdAt])
  @@map("ai_wallet_transactions")
}

/// Recarga de saldo de una clínica. El cobro real (Stripe/MP/SPEI) lo
/// implementan T3/T4/T5; aquí solo el registro + estado.
model AiTopup {
  id          String        @id @default(cuid())
  clinicId    String
  amountCents Int
  method      AiTopupMethod
  status      AiTopupStatus @default(PENDING)
  gatewayRef  String?
  proofUrl    String?
  confirmedBy String?
  createdAt   DateTime      @default(now())
  paidAt      DateTime?

  @@index([clinicId])
  @@index([gatewayRef])
  @@map("ai_topups")
}

/// Configuración GLOBAL de precios (una sola fila id="default"). Precios de
/// Anthropic en USD/Mtok, tipo de cambio y fee OCULTO. La clínica nunca lo ve.
model AiPricingConfig {
  id                   String   @id @default("default")
  inputUsdPerMtok      Float    @default(3)
  outputUsdPerMtok     Float    @default(15)
  cacheWriteUsdPerMtok Float    @default(3.75)
  cacheReadUsdPerMtok  Float    @default(0.3)
  usdToMxnRate         Float    @default(19.5)
  feePct               Float    @default(8)
  updatedAt            DateTime @updatedAt

  @@map("ai_pricing_configs")
}

/// Config editable de cada plan de la plataforma (uno por planId: BASIC/PRO/
/// CLINIC). Fuente única de precio/límites/permisos por módulo, editable desde
/// /admin/settings → Planes SIN redeploy. La lee `src/lib/plans.ts` (cacheada).
/// storageBytes es BigInt (100GB ≈ 1.07e11 no cabe en Int). maxPatients/maxUsers
/// null = ilimitado. features = mapa { moduleKey: boolean } (casillas del panel).
model PlanConfig {
  planId          String   @id
  label           String
  priceMxnMonthly Int
  priceMxnAnnual  Int
  storageBytes    BigInt
  aiTokensDefault Int
  whatsappMonthly Int
  // Facturas CFDI (timbres) incluidas por MES CALENDARIO y precio del excedente.
  // Seed: incluidas BASIC=25 (provisional) / PRO=50 / CLINIC=150; excedente por
  // timbre (centavos MXN) BASIC=200 / PRO=200 / CLINIC=125. Jamás bloquea el
  // timbrado; el excedente se cobra a fin de mes (ver CfdiUsage + cron). Requiere
  // sql/cfdi-quotas.sql APLICADO antes de deployar.
  cfdiMonthly      Int      @default(50)
  cfdiOverageCents Int      @default(200)
  maxPatients     Int?
  maxUsers        Int?
  // Máximo de sucursales (clínicas) que el dueño puede tener con este plan.
  // NULL = ilimitado. Seed: BASIC=1, PRO=1, CLINIC=3. Requiere
  // sql/plan_configs_max_clinics.sql APLICADO antes de deployar.
  maxClinics      Int?
  features        Json
  updatedAt       DateTime @updatedAt

  @@map("plan_configs")
}

/// Saldo central que Rafael carga en Anthropic (USD, centavos). El dashboard de
/// tesorería calcula consumido (sum costUsdMicros) vs cargado.
model AnthropicRecharge {
  id             String   @id @default(cuid())
  amountUsdCents Int
  note           String?
  createdAt      DateTime @default(now())

  @@map("anthropic_recharges")
}

// ═══════════════════════════════════════════════════════════════════════════
// Portal del paciente — cuentas reales (jun 2026). PatientAccount es GLOBAL
// (sin clinicId): una persona puede tener expedientes en varias clínicas.
// PatientAccountLink une cuenta ↔ Patient(clinicId). La sesión vive en
// patient_account_sessions: la cookie httpOnly `patient_session` guarda el
// token plano y en DB solo se persiste sha256(token).
// Vinculación SOLO por email verificado o por reserva con sesión iniciada —
// NUNCA por teléfono solo (robo de expediente).
// ═══════════════════════════════════════════════════════════════════════════

model PatientAccount {
  id            String  @id @default(cuid())
  email         String  @unique // siempre lowercase
  emailVerified Boolean @default(false)
  name          String
  phone         String?
  // null = cuenta INVITADA por la clínica que aún no fija su contraseña. El
  // paciente la define desde el correo de invitación (reusa /paciente/recuperar).
  // login rechaza null con mensaje de activación; reset la setea + verifica email.
  passwordHash  String?

  // Invitación al portal desde la ficha (staff). invitedAt/invitedByUserId solo
  // se pueblan mientras la cuenta está pendiente de activar; el reset las limpia.
  invitedByUserId String?
  invitedAt       DateTime?

  // Verificación de email por código de 6 dígitos (se guarda sha256 del código)
  verifyCodeHash   String?
  verifyCodeExpiry DateTime?
  verifyAttempts   Int       @default(0)

  // Recuperación de contraseña (se guarda sha256 del token)
  resetTokenHash   String?
  resetTokenExpiry DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Preferencias de notificación del paciente (canal + anticipación). null =
  // usar la configuración de recordatorios de la clínica (sin override). El
  // cron de recordatorios las respeta. Ver src/lib/patient-notifications.
  notifPrefs Json?

  links         PatientAccountLink[]
  sessions      PatientAccountSession[]
  uploads       PatientUpload[]
  notifications PatientNotification[]

  @@map("patient_accounts")
}

/// Centro de notificaciones del paciente (portal): recordatorios de cita,
/// resoluciones de cambios de cita y, a futuro, mensajes. Multi-tenant por
/// clinicId+patientId (el portal filtra por los patientId de PatientAccountLink
/// de la sesión). dedupeKey da idempotencia al cron de recordatorios (una por
/// cita+momento "<appointmentId>:<offsetMin>"); null en eventos únicos.
/// SQL a mano: sql/patient-notifications.sql.
model PatientNotification {
  id        String    @id @default(cuid())
  clinicId  String
  patientId String
  accountId String?
  type      String // "APPOINTMENT_REMINDER" | "APPOINTMENT_CHANGE" | "MESSAGE"
  title     String
  body      String    @db.Text
  dedupeKey String? // cron: "<appointmentId>:<offsetMin>"; null = evento único
  readAt    DateTime?
  createdAt DateTime  @default(now())

  clinic  Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  account PatientAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([patientId, dedupeKey])
  @@index([patientId, createdAt(sort: Desc)])
  @@index([accountId, readAt])
  @@map("patient_notifications")
}

model PatientAccountLink {
  id        String   @id @default(cuid())
  accountId String
  patientId String
  clinicId  String // denormalizado del Patient para filtrar por clínica sin join
  createdAt DateTime @default(now())

  account PatientAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  patient Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([accountId, patientId])
  @@index([accountId, clinicId])
  @@index([patientId])
  @@map("patient_account_links")
}

model PatientAccountSession {
  id        String   @id @default(cuid())
  accountId String
  tokenHash String   @unique // sha256 del token de la cookie
  expiresAt DateTime
  createdAt DateTime @default(now())

  account PatientAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("patient_account_sessions")
}

// ─────────────────────────────────────────────────────────────────────────
// PORTAL DEL PACIENTE — ARCHIVOS SUBIDOS POR EL PACIENTE (WS1-T8)
// El paciente sube estudios / identificación / otros desde /paciente/documentos.
// clinicId/patientId SIEMPRE derivados del link de la sesión (ctx.links), nunca
// del cliente. El binario vive en el bucket privado patient-files; `storageKey`
// es el path interno (se firma on-demand, jamás público). La clínica los ve en
// el expediente. Requiere sql/paciente-uploads.sql aplicado a mano en Supabase.
enum PatientUploadKind {
  ESTUDIO
  IDENTIFICACION
  OTRO
}

model PatientUpload {
  id         String            @id @default(cuid())
  clinicId   String
  patientId  String
  accountId  String
  fileName   String
  fileType   String
  storageKey String
  sizeBytes  Int
  kind       PatientUploadKind @default(OTRO)
  createdAt  DateTime          @default(now())

  clinic  Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  account PatientAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId, createdAt(sort: Desc)])
  @@index([accountId])
  @@map("patient_uploads")
}

// ─────────────────────────────────────────────────────────────────────────
// AFILIADOS — ESTADÍSTICAS Y REPORTES
// Tracking de clicks del funnel (click → registro → activa → pagando) y
// preferencias de notificación por email del afiliado.
// SIN relación Prisma a Affiliate (mismo patrón que AI billing): las FKs
// viven en sql/afiliados-stats.sql. Así NO se toca el modelo Affiliate y un
// deploy sin el SQL aplicado solo afecta a las features nuevas (cero drift
// en los SELECT existentes — ver lesson_ortho_schema_drift).
// Privacidad: ipHash = sha256(salt+ip) truncado; NUNCA la IP cruda.
// ─────────────────────────────────────────────────────────────────────────

model AffiliateClick {
  id          String   @id @default(cuid())
  affiliateId String
  ref         String // referralCode o slug usado en el enlace
  campaign    String? // ?c= / utm_campaign (opcional, tolerante)
  landingPage String? // path de aterrizaje, sin querystring
  ipHash      String? // sha256 truncado con salt — jamás IP cruda
  userAgent   String? // resumido (máx 160 chars)
  // Cookie dc_vid: id aleatorio opaco del NAVEGADOR (visitor-cookie.ts). Es
  // con lo que se deduplica; la IP ya no sirve (CGNAT móvil = miles de
  // teléfonos por IP). Nullable: filas viejas y clics guardados antes de
  // aplicar sql/affiliate-click-vid.sql.
  vid         String?
  createdAt   DateTime @default(now())

  @@index([affiliateId, createdAt])
  @@index([ref, createdAt])
  @@map("affiliate_clicks")
}

model AffiliatePrefs {
  affiliateId      String   @id
  notifySignup     Boolean  @default(true) // email al registrarse una clínica con su ref
  notifyConversion Boolean  @default(true) // email cuando un referido paga su primera factura
  notifyPayout     Boolean  @default(true) // email cuando el admin marca comisiones pagadas
  updatedAt        DateTime @default(now()) @updatedAt

  @@map("affiliate_prefs")
}

// ═══════════════════════════════════════════════════════════════════════════
// Soporte Técnico — tickets de clínicas hacia DaleControl (jun 2026).
// Sin relación a Clinic/User a propósito (mismo patrón que AiTopup): Strings
// planos + aislamiento por clinicId en src/lib/support/service.ts. `externalId`
// queda reservado para el id del ticket en Zendesk cuando se active la
// integración (src/lib/support/zendesk-adapter.ts + docs/SOPORTE_ZENDESK.md).
// Estados/categorías/prioridades son String; los valores válidos los define
// src/lib/support/types.ts (evita enums Postgres en el SQL manual).
// ═══════════════════════════════════════════════════════════════════════════

model SupportTicket {
  id            String  @id @default(cuid())
  folio         Int     @unique @default(autoincrement()) // se muestra como #DC-0001
  clinicId      String
  createdById   String
  createdByName String?
  subject       String
  category      String  @default("DUDA") // BUG | DUDA | FACTURACION | SUGERENCIA
  priority      String  @default("NORMAL") // BAJA | NORMAL | ALTA | URGENTE
  status        String  @default("ABIERTO") // ABIERTO | EN_PROGRESO | ESPERANDO_RESPUESTA | RESUELTO | CERRADO
  rating        Int? // 1-5, opcional al cerrar
  externalId    String? // id del ticket en Zendesk (integración futura)

  // Campos de métricas/badges, mantenidos por el service en cada transición.
  firstResponseAt      DateTime? // primera respuesta pública de soporte
  lastClinicMessageAt  DateTime?
  lastSupportMessageAt DateTime?
  clinicUnread         Boolean   @default(false) // hay novedades que la clínica no ha visto

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages SupportMessage[]

  @@index([clinicId, status])
  @@index([status, updatedAt])
  @@map("support_tickets")
}

model SupportMessage {
  id           String   @id @default(cuid())
  ticketId     String
  authorType   String // clinic | support | system
  authorId     String?
  authorName   String?
  body         String
  attachments  Json? // SupportAttachment[]: [{ path, name, size, type }]
  internalNote Boolean  @default(false) // nota interna de soporte; la clínica NUNCA la ve
  createdAt    DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// ═══════════════════════════════════════════════════════════════════════════
// AFILIADOS — HERRAMIENTAS DE VENTA (jun 2026, WS3-T3)
// Multi-links con campaña, cupón propio del afiliado (integrado al sistema
// existente de admin/coupons vía tabla puente) y niveles bronce/plata/oro.
// A PROPÓSITO sin tocar columnas de tablas existentes (clinics/coupons/
// affiliate_commissions): solo tablas nuevas → si el SQL no se ha corrido,
// nada existente se rompe (lesson_ortho_schema_drift).
// SQL espejo: sql/afiliados-ventas.sql. Al final del schema para no chocar
// con ramas paralelas.
// ═══════════════════════════════════════════════════════════════════════════

/// Link nombrado del afiliado ("Facebook", "Expo dental"). URL pública corta:
/// /r/<publicCode>. El click suma al contador en /r y la campaña viaja al
/// registro (AffiliateConversion.campaign) vía la cookie de atribución.
/// La URL histórica /socio/<slug>?c=<campaign> sigue funcionando igual.
model AffiliateLink {
  id          String   @id @default(cuid())
  affiliateId String
  sellerId    String? // vendedor dueño del link (equipo). null = link del propio afiliado. FK en SQL.
  name        String
  campaign    String // slug corto [a-z0-9-], inmutable (estabilidad de URL/QR)
  /// Código opaco de 8 chars [a-z0-9] para la URL corta /r/<publicCode>.
  /// Opcional: los links creados ANTES de sql/afiliados-atribucion-soporte.sql
  /// lo tienen null y siguen usando /socio/<slug>?c=<campaign>.
  /// Es opaco a propósito: un ?c=facebook adivinable dejaría manipular las
  /// campañas de otro afiliado.
  publicCode  String?  @unique
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@unique([affiliateId, campaign])
  @@index([affiliateId])
  @@index([sellerId])
  @@map("affiliate_links")
}

/// Conversión atribuida (sidecar de analytics): qué clínica llegó por qué
/// campaña o cupón. La atribución REAL para comisiones sigue siendo
/// clinics.affiliateId (no cambia). Sin relación Prisma a Clinic a propósito
/// (FK en el SQL; mismo patrón que AffiliateCommission). El panel del
/// afiliado solo ve CONTEOS de esta tabla, nunca datos de la clínica.
model AffiliateConversion {
  id          String   @id @default(cuid())
  affiliateId String
  clinicId    String   @unique // 1 conversión por clínica
  campaign    String? // campaña del link (?c=) si la hubo
  source      String   @default("link") // link | coupon
  couponId    String?
  createdAt   DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, campaign])
  @@map("affiliate_conversions")
}

/// Une un cupón del sistema EXISTENTE (admin/coupons) con su afiliado dueño.
/// Tabla puente a propósito (no columna en coupons) para no romper las
/// queries existentes de Coupon antes de correr el SQL. couponId sin relación
/// Prisma (FK con ON DELETE CASCADE en el SQL).
model AffiliateCoupon {
  id          String   @id @default(cuid())
  affiliateId String
  sellerId    String? // vendedor dueño del cupón (equipo). null = cupón del propio afiliado. FK en SQL.
  couponId    String   @unique
  createdAt   DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([sellerId])
  @@map("affiliate_coupons")
}

/// Config GLOBAL del programa (una sola fila id=1): % de comisión por nivel
/// y umbrales de clínicas ACTIVAS referidas. Si la tabla aún no existe, el
/// código cae a modo legacy (Affiliate.commissionPct) y nada se rompe.
/// El % del nivel se usa al GENERARSE la comisión (no retroactivo).
model AffiliateProgramConfig {
  id              Int      @id @default(1)
  bronzePct       Float    @default(10)
  silverPct       Float    @default(12)
  goldPct         Float    @default(15)
  silverMinActive Int      @default(3)
  goldMinActive   Int      @default(10)
  updatedAt       DateTime @updatedAt

  @@map("affiliate_program_config")
}

// ═══════════════════════════════════════════════════════════════════════════
// ⚠️ DEUDA — TABLAS MUERTAS (ago 2026). El segundo nivel del programa se
// rehízo: ya no hay "vendedores", hay AFILIADOS INVITADOS
// (Affiliate.invitedByAffiliateId), que son afiliados normales e idénticos a
// quien los invitó. Los tres modelos de abajo —AffiliateSeller,
// AffiliateSellerAttribution, AffiliateSellerCommission— y las columnas
// affiliate_links.sellerId / affiliate_coupons.sellerId ya NO los lee ni los
// escribe ninguna línea de código. Se conservan porque dropear tablas es
// destructivo; estaban en 0 filas al retirarse (0 vendedores, 0 atribuciones),
// así que no hay nada que migrar. Limpieza pendiente: ver ORQUESTA.md.
//
// Modelo histórico (ya NO vigente):
// AFILIADOS — EQUIPOS DE VENDEDORES (jun 2026, WS3 · feat/afiliados-equipo)
// Un AFILIADO (padre) registra manualmente a sus VENDEDORES. El vendedor gana
// comisión por las clínicas que trae y el padre un OVERRIDE; juntos suman la
// comisión COMPLETA del padre — la plataforma NO paga de más. Máximo 2 niveles:
// el vendedor jamás registra gente ni tiene equipo propio.
//
// SIN relación Prisma a Affiliate/Clinic (mismo patrón que AffiliateCommission
// / AffiliateClick): las FKs viven en sql/afiliados-equipo.sql. Así no se toca
// el modelo Affiliate y un deploy sin el SQL solo afecta a las features nuevas
// (cero drift — ver lesson_ortho_schema_drift). Único ALTER a tablas
// existentes: columna nullable sellerId en affiliate_links / affiliate_coupons.
// Al FINAL del schema para no chocar con ramas paralelas de la ola.
// ═══════════════════════════════════════════════════════════════════════════

/// Vendedor de un afiliado. Login propio vía Supabase (supabaseId), igual que
/// AffiliateUser pero sin tabla puente: el mapeo supabaseId→vendedor vive aquí.
/// commissionPct = qué PORCENTAJE DE LA COMISIÓN DEL PADRE le asigna éste
/// (0..100, ver @/lib/affiliates/team-split); se CONGELA en cada conversión
/// nueva (no retroactivo). El nivel del padre NO lo topa. Datos de pago propios:
/// DaleControl le paga directo con el mismo flujo (mismo mínimo) del afiliado.
model AffiliateSeller {
  id            String   @id @default(cuid())
  affiliateId   String // padre (sin relación Prisma; FK en SQL)
  supabaseId    String?  @unique // login del vendedor (null hasta primer acceso)
  name          String
  email         String // lowercase; único por afiliado (Supabase lo hace único global)
  phone         String?
  commissionPct Float    @default(0) // % de la comisión del padre (0..100)
  isActive      Boolean  @default(true)
  payoutMethod  String? // SPEI | PAYPAL | OTHER
  payoutDetails String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([affiliateId, email])
  @@index([affiliateId])
  @@map("affiliate_sellers")
}

/// Atribución clínica → vendedor (1 por clínica). Congela el % del vendedor al
/// alta. La clínica sigue ligada al PADRE por clinics.affiliateId (cuenta para
/// el nivel del padre); esto solo dice "qué vendedor la trajo y con qué %".
model AffiliateSellerAttribution {
  id          String   @id @default(cuid())
  clinicId    String   @unique
  sellerId    String
  affiliateId String // padre (denormalizado para reportes/limpieza)
  sellerPct   Float // % de la comisión del padre (0..100) CONGELADO al alta
  createdAt   DateTime @default(now())

  @@index([sellerId])
  @@index([affiliateId])
  @@map("affiliate_seller_attributions")
}

/// Porción del VENDEDOR por factura pagada (sidecar de affiliate_commissions).
/// El override del padre queda en affiliate_commissions.commissionMxn (reducido
/// al override cuando hay vendedor); aquí va SOLO la parte del vendedor. La
/// suma de ambos = comisión total del padre (la plataforma no paga de más).
/// Idempotente por stripeInvoiceId (igual que affiliate_commissions).
model AffiliateSellerCommission {
  id              String    @id @default(cuid())
  sellerId        String
  affiliateId     String // padre
  clinicId        String
  stripeInvoiceId String    @unique
  amountMxn       Float // factura pagada (igual que la del padre)
  commissionMxn   Float // porción del VENDEDOR (comisión del padre × %congelado)
  kind            String    @default("pct") // pct | recurring | onetime (espejo del padre)
  status          String    @default("pending") // pending | paid
  createdAt       DateTime  @default(now())
  paidAt          DateTime?

  @@index([sellerId, status])
  @@index([affiliateId])
  @@map("affiliate_seller_commissions")
}

// ═══════════════════════════════════════════════════════════════════
// Reseñas verificadas del directorio público (WS2-T2 perfil-resenas).
// Una reseña por cita COMPLETADA (appointmentId @unique). Se invita por link
// tokenizado de un solo uso (expira 30 días); el paciente envía rating 1-5 +
// comentario sin login. La clínica responde (una vez); el admin oculta las
// reportadas. SIN relaciones Prisma hacia Clinic/Patient/Appointment a
// propósito: las FKs viven en sql/resenas.sql para NO editar esos modelos y
// evitar colisiones con otras terminales que también tocan el schema. RLS
// deny-all en sql/resenas.sql (patrón rls-deny-all-policies). authorName se
// congela al invitar (nombre + inicial) para mostrar sin join.
// ═══════════════════════════════════════════════════════════════════
model ClinicReview {
  id            String  @id @default(cuid())
  clinicId      String
  patientId     String
  appointmentId String  @unique
  authorName    String
  rating        Int? // 1-5; null hasta que el paciente envía
  comment       String? // texto plano sanitizado server-side
  status        String  @default("pending") // pending | published | hidden

  // Respuesta de la clínica (una sola).
  response      String?
  respondedAt   DateTime?
  respondedById String?

  // Moderación: cualquiera puede reportar; el admin oculta.
  reported       Boolean   @default(false)
  reportedReason String?
  reportedAt     DateTime?

  // Invitación tokenizada de un solo uso.
  token           String   @unique
  tokenExpiresAt  DateTime
  submittedAt     DateTime?
  invitedChannels String[] @default([]) // ["whatsapp","email"] enviados

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId, status, createdAt])
  @@index([clinicId, reported])
  @@map("clinic_reviews")
}

// ═══════════════════════════════════════════════════════════════════
// Cuestionario de salud / anamnesis dental (WS1-T2 anamnesis-vitales).
// Versionado simple: una fila por llenado; el VIGENTE es el más reciente
// por (clinicId, patientId, filledAt). Los anteriores se conservan como
// historial. SIN relaciones Prisma hacia Clinic/Patient/User a propósito
// (mismo patrón que ClinicReview): las FKs viven en
// sql/health-questionnaire.sql para NO editar esos modelos y evitar
// colisiones con otras terminales que también tocan el schema. RLS
// deny-all en el SQL. `answers` = respuestas crudas del formulario;
// `riskFlags` = banderas calculadas server-side al guardar (chips rojos).
// ═══════════════════════════════════════════════════════════════════
model HealthQuestionnaire {
  id         String   @id @default(cuid())
  clinicId   String
  patientId  String
  filledAt   DateTime @default(now())
  filledById String? // User staff que capturó (null = portal/sin sesión)
  answers    Json
  riskFlags  String[] @default([])
  notes      String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId, patientId, filledAt(sort: Desc)])
  @@map("health_questionnaires")
}

// ============================================================================
// PRESUPUESTOS / COTIZACIONES GENÉRICAS PARA EL PACIENTE (WS1-T1)
// Cotización multi-ítem (tarifario), descuento por línea y global, vigencia,
// aceptación pública con firma. Status como String (NO enum: los enums nuevos
// han causado drift en este repo). Money en Decimal(10,2).
// ============================================================================

model Quote {
  id          String @id @default(cuid())
  clinicId    String
  patientId   String
  createdById String?

  /// Folio corto legible por clínica, ej. "P-0001". Único dentro de la clínica.
  folio  String
  title  String
  /// DRAFT | PRESENTED | ACCEPTED | REJECTED | EXPIRED
  status String @default("DRAFT")

  validUntil DateTime?

  subtotal       Decimal  @default(0) @db.Decimal(10, 2)
  /// Porcentaje de descuento global (0-100). Si se fija, manda sobre discountAmount al recalcular.
  discountPct    Decimal? @db.Decimal(5, 2)
  discountAmount Decimal  @default(0) @db.Decimal(10, 2)
  total          Decimal  @default(0) @db.Decimal(10, 2)

  notes String? @db.Text

  /// Token público de aceptación (sólo presente cuando el presupuesto se presentó).
  acceptToken  String?   @unique
  presentedAt  DateTime?
  acceptedAt   DateTime?
  rejectedAt   DateTime?
  /// Path interno en Supabase Storage (bucket patient-files) de la firma del paciente.
  signatureUrl String?

  /// Generación idempotente aguas abajo cuando el presupuesto queda ACCEPTED.
  invoiceId       String?
  treatmentPlanId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic    Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient   Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy User?       @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     QuoteItem[]

  @@unique([clinicId, folio])
  @@index([clinicId, patientId, status])
  @@index([clinicId, status])
  @@index([patientId])
  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  /// FK opcional al tarifario; SetNull para no romper la cotización si se borra el procedimiento.
  procedureId String?
  /// Copia del nombre al momento de cotizar (el tarifario puede cambiar después).
  name        String
  /// CSV de dientes FDI involucrados, ej. "11,12,21". Opcional.
  toothFdi    String?
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  lineTotal   Decimal @db.Decimal(10, 2)
  /// Fase de tratamiento 1..n para agrupar en el PDF. Opcional.
  phase       Int?
  notes       String?
  sortOrder   Int     @default(0)

  quote     Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  procedure ProcedureCatalog? @relation(fields: [procedureId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("quote_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Analítica de primera parte (self-hosted). Panel privado del owner en
// /admin/analytics. Sin FKs a clinics/users a propósito: la ingesta (/api/track)
// debe ser robusta aunque el clinicId/userId venga de una cookie stale; el panel
// hace el join manualmente. Los ids identificados se guardan denormalizados.
// SQL espejo en sql/analytics.sql. RLS deny-all (Prisma service-role bypasa).
// ─────────────────────────────────────────────────────────────────────────────

model AnalyticsSession {
  id               String   @id // uuid generado en el cliente (== sid)
  visitorId        String
  surface          String   @default("public") // public|dashboard|portal|affiliate|supplier|lab

  // Identidad resuelta desde cookies en el servidor (anonymous|staff|patient|admin)
  identityType     String   @default("anonymous")
  clinicId         String?
  userId           String?
  patientAccountId String?
  email            String?
  displayName      String?
  role             String?
  plan             String?

  // Navegación / atribución
  entryPath        String?
  exitPath         String?
  referrer         String?
  referrerHost     String?
  referrerType     String?  // direct|search|social|ads|referral|internal
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmTerm          String?
  utmContent       String?
  gclid            String?

  // Geo (headers de Vercel)
  country          String?
  region           String?
  city             String?
  latitude         Float?
  longitude        Float?
  ip               String?

  // Dispositivo
  device           String?
  browser          String?
  os               String?
  screenW          Int?
  screenH          Int?
  language         String?
  timezone         String?

  // Métricas agregadas de la sesión
  pageviews        Int      @default(0)
  clicks           Int      @default(0)
  maxScroll        Int      @default(0)
  durationMs       Int      @default(0)
  isBounce         Boolean  @default(true)

  startedAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  events           AnalyticsEvent[]

  @@index([startedAt])
  @@index([clinicId, startedAt])
  @@index([surface, startedAt])
  @@index([visitorId])
  @@index([lastSeenAt])
  @@index([identityType, startedAt])
  @@index([referrerType, startedAt])
  @@index([country, startedAt])
  @@map("analytics_sessions")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  sessionId  String
  visitorId  String
  clinicId   String?
  surface    String?
  type       String // pageview|click|scroll|custom|rage_click
  path       String
  title      String?
  referrer   String?
  name       String?
  x          Float?
  y          Float?
  // y se capturó sobre un elemento fixed/sticky (sidebar, header pegajoso): guarda
  // clientY —relativo al viewport, donde de verdad se ve— en vez de pageY.
  // Requiere sql/analytics_events_yfixed.sql aplicado en Supabase.
  yFixed     Boolean  @default(false)
  vw         Int?
  vh         Int?
  docH       Int?
  scrollPct  Int?
  selector   String?
  text       String?
  durationMs Int?
  meta       Json?
  createdAt  DateTime @default(now())

  session    AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([clinicId, createdAt])
  @@index([type, path, createdAt])
  @@index([path, createdAt])
  @@index([createdAt])
  @@map("analytics_events")
}

// MULTI-CLÍNICA · FASE 2 — vínculo de PACIENTES COMPARTIDOS entre dos sedes
// del mismo dueño.
//
// Reglas del modelo (deliberadas, no accidentales):
//  - SIMÉTRICO y NORMALIZADO: el par se guarda siempre menor→mayor por id
//    (clinicAId < clinicBId). Así "A comparte con B" y "B comparte con A" son
//    LA MISMA fila y el @@unique impide duplicados invertidos.
//  - SIN TRANSITIVIDAD: si A↔B y B↔C, A NO ve los pacientes de C. Solo cuentan
//    los pares explícitos — el dueño ve exactamente lo que marcó.
//  - Solo habilita LECTURA de pacientes (lista/búsqueda/ficha/expediente). Las
//    citas, facturas, pagos, caja y finanzas siguen 100% aisladas por sede.
//
// La visibilidad se deriva SIEMPRE en el server desde estas filas + la sesión
// (getVisiblePatientClinicIds en @/lib/branches), nunca de un id del cliente.
// Requiere sql/clinic-patient-links.sql aplicado en Supabase.
model ClinicPatientLink {
  id          String   @id @default(cuid())
  clinicAId   String
  clinicBId   String
  createdAt   DateTime @default(now())
  createdById String?

  clinicA   Clinic @relation("ClinicPatientLinkA", fields: [clinicAId], references: [id], onDelete: Cascade)
  clinicB   Clinic @relation("ClinicPatientLinkB", fields: [clinicBId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("ClinicPatientLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([clinicAId, clinicBId])
  @@index([clinicAId])
  @@index([clinicBId])
  @@map("clinic_patient_links")
}

// ─────────────────────────────────────────────────────────────────────────────
// BLOG SEO PÚBLICO — contenido GLOBAL de marca (dalecontrol.com/blog).
//
// Sin `clinicId` A PROPÓSITO: no es multi-tenant. Los artículos los publica
// DaleControl y los ve todo internet; no hay aislamiento por clínica que
// respetar. El admin de plataforma (/admin/blog) es el único que escribe.
//
// Los artículos llegan YA REDACTADOS por el importador JSON (no se generan
// aquí: cero llamadas a IA en este módulo) y se publican en goteo con el cron
// /api/cron/blog-publish, que promueve `scheduled` → `published`.
//
// Timestamps con timezone (@db.Timestamptz) — a diferencia del resto del
// schema, que usa timestamp(3) sin tz: la programación del drip razona en
// horario absoluto (13:00 UTC) y una columna naive dejaría la hora ambigua.
//
// Requiere sql/blog.sql aplicado a mano en Supabase (no usamos prisma migrate).
model BlogPost {
  id              String    @id @default(cuid())
  // slug: ^[a-z0-9]+(-[a-z0-9]+)*$, máx 90 — validado en la app y con CHECK en BD.
  slug            String    @unique
  title           String
  metaTitle       String
  metaDescription String
  excerpt         String
  // Markdown PURO. Se renderiza con react-markdown + remark-gfm; el HTML crudo
  // NO se interpreta (sin rehype-raw, sin dangerouslySetInnerHTML).
  contentMd       String
  // Slug de la lista fija de src/lib/blog/categories.ts (sin enum a propósito).
  category        String
  // Cluster temático para el interlinking. Nullable: un artículo suelto creado
  // a mano no pertenece a ningún cluster, y '' arruinaría el fallback de
  // "artículos relacionados" (agruparía a todos los huérfanos entre sí).
  cluster         String?
  tags            String[]  @default([])
  // Array de { q, a } — se renderiza como acordeón + JSON-LD FAQPage.
  faq             Json?
  relatedSlugs    String[]  @default([])
  // draft | scheduled | published | archived (ver BLOG_STATUSES).
  status          String    @default("draft")
  scheduledAt     DateTime? @db.Timestamptz(3)
  publishedAt     DateTime? @db.Timestamptz(3)
  author          String    @default("Equipo DaleControl")
  readingMinutes  Int       @default(0)
  // Vistas de la página pública. Se incrementa vía /api/blog/view (los bots se
  // excluyen por User-Agent); nunca desde el render del server, que es ISR.
  views           Int       @default(0)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  // (status, scheduledAt) → barrido del cron. (status, publishedAt DESC) → índice
  // público y RSS. category/cluster → filtrado y relacionados.
  @@index([status, scheduledAt])
  @@index([status, publishedAt(sort: Desc)])
  @@index([category])
  @@index([cluster])
  @@map("blog_posts")
}

// ═══════════════════════════════════════════════════════════════════════
// DESGLOSE DEL CUPO MENSUAL DE IA — "¿en qué se fue tu IA este mes?"
//
// Una fila por cobro de tokens contra el cupo del plan
// (clinics."aiTokensUsed"/"aiTokensLimit"). La escribe addAiTokens() en
// @/lib/ai-tokens, que es el ÚNICO punto de cobro: el contador y este
// desglose se mueven siempre juntos, así que sumar tokens de un mes debe dar
// ~= aiTokensUsed de ese mes.
//
// ⚠️ NO es el monedero prepago del bot de WhatsApp (AiWallet/AiUsageEvent,
// MXN en centavos): son dos bolsas distintas y no se mezclan.
//
// El insert es FAIL-OPEN: si falla, se loguea y la operación de IA del cliente
// sigue. Nunca debe poder bloquear una respuesta de IA.
//
// Requiere sql/ai-quota-usage.sql aplicado en Supabase.
// ═══════════════════════════════════════════════════════════════════════
model AiQuotaUsage {
  id        String   @id @default(cuid())
  clinicId  String
  feature   String // slug estable: chat | xray_analysis | dictation | ... | other
  tokens    Int
  userId    String? // quién lo consumió; se guarda pero NO se expone en la API v1
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, createdAt])
  @@map("ai_quota_usage")
}

// ═══════════════════════════════════════════════════════════════════════════
// AFILIADOS — MOTOR DE COMISIONES CONFIGURABLE (ago 2026)
//
// El programa deja de pagar SOLO un % sobre la factura: ahora paga MONTOS
// FIJOS por plan (recurrentes por mes cubierto) o un PAGO ÚNICO por clínica,
// todo editable desde /admin/affiliates sin tocar código. El modo "pct"
// (niveles bronce/plata/oro) sigue disponible, ya no es el default.
//
// Requiere sql/afiliados-comisiones.sql aplicado en Supabase. Sin él, el motor
// cae al modo % por nivel (comportamiento anterior, cero regresión) — patrón
// lesson_ortho_schema_drift. Al FINAL del schema para no chocar con ramas
// paralelas de la ola.
// ═══════════════════════════════════════════════════════════════════════════

/// Config GLOBAL del motor de comisiones (fila única id=1), editable en
/// /admin/affiliates. Los 6 montos + las reglas de disparo. Si la tabla no
/// existe, el motor cae al modo % por nivel (comportamiento actual).
model AffiliatePayoutConfig {
  id                   Int      @id @default(1)
  // Modo del programa: "fixed" (montos por plan) | "pct" (niveles).
  defaultMode          String   @default("fixed")
  // Modalidad por defecto de un afiliado nuevo: "recurring" | "onetime".
  defaultPayoutMode    String   @default("recurring")
  // ¿El afiliado puede elegir su modalidad desde su panel?
  allowAffiliateChoice Boolean  @default(true)
  // Fijo recurrente por plan (MXN por mes cubierto).
  recurringBasicMxn    Float    @default(40)
  recurringProMxn      Float    @default(90)
  recurringClinicMxn   Float    @default(250)
  // Pago único por plan (MXN, una sola vez por clínica).
  oneTimeBasicMxn      Float    @default(350)
  oneTimeProMxn        Float    @default(650)
  oneTimeClinicMxn     Float    @default(1400)
  // Desde qué número de cobro empieza a pagarse (1 = desde el primero).
  startAtInvoiceNo     Int      @default(2)
  // En qué número de cobro se dispara el pago único.
  oneTimeAtInvoiceNo   Int      @default(2)
  // ── Bonos por hitos (sql/afiliados-hitos.sql) ────────────────────────────
  // Sólo se ANUNCIAN y se configuran: el sistema NO los calcula ni los paga
  // (no hay contador de hitos ni registro de bonos entregados). Apagar el
  // switch retira la promoción de /afiliados y /terminos-afiliados sin deploy.
  milestonesEnabled    Boolean  @default(true)
  milestone1Clinics    Int      @default(5)
  milestone1Mxn        Float    @default(2500)
  milestone2Clinics    Int      @default(25)
  milestone2Mxn        Float    @default(10000)
  milestone3Clinics    Int      @default(50)
  milestone3Mxn        Float    @default(100000)
  // ── Bonos por RED (sql/afiliados-bonos-red.sql) ──────────────────────────
  // Premian las clínicas activas que trajeron los AFILIADOS INVITADOS por este
  // afiliado (Affiliate.invitedByAffiliateId). Cinco escalones, PAGO ÚNICO.
  // A diferencia de los hitos propios, estos SÍ se calculan y se pagan solos
  // (@/lib/affiliates/network-bonus + el cron /api/cron/affiliate-network-bonus).
  //
  // ⚠️ networkTier<N>MonthlyMxn quedan en la BD en 0 y SIN USO: la modalidad
  // mensual del bono por red se retiró (ago 2026). Ninguna lectura las pide
  // (getNetworkBonusConfig lleva `select` explícito) ni la UI del admin las
  // edita. Deuda: dropearlas cuando toque una limpieza de columnas.
  //
  // ⚠️ Se leen con `select` explícito (getNetworkBonusConfig) para que un
  // deploy sin el SQL aplicado NO tumbe la lectura del motor de comisiones:
  // ver el comentario de getPayoutConfig() en @/lib/affiliates/payout.
  networkBonusEnabled    Boolean @default(true)
  networkTier1Clinics    Int     @default(5)
  networkTier1OnceMxn    Float   @default(3000)
  networkTier1MonthlyMxn Float   @default(0)
  networkTier2Clinics    Int     @default(20)
  networkTier2OnceMxn    Float   @default(15000)
  networkTier2MonthlyMxn Float   @default(0)
  networkTier3Clinics    Int     @default(50)
  networkTier3OnceMxn    Float   @default(40000)
  networkTier3MonthlyMxn Float   @default(0)
  networkTier4Clinics    Int     @default(150)
  networkTier4OnceMxn    Float   @default(120000)
  networkTier4MonthlyMxn Float   @default(0)
  networkTier5Clinics    Int     @default(500)
  networkTier5OnceMxn    Float   @default(400000)
  networkTier5MonthlyMxn Float   @default(0)
  updatedAt            DateTime @updatedAt

  @@map("affiliate_payout_config")
}

/// Un escalón del BONO POR RED otorgado (o en curso) a un afiliado.
/// sql/afiliados-bonos-red.sql. SIN relación Prisma a Affiliate (la FK vive en
/// el SQL, mismo patrón que AffiliateCommission).
///
/// Ciclo de vida — ver @/lib/affiliates/network-bonus-core:
///   tracking → awarded
///
/// `clinics`/`onceMxn` se refrescan mientras la fila está en `tracking` y
/// quedan CONGELADOS al otorgarse: editar la config después no puede cambiar
/// lo que ya se prometió. Al otorgar se genera la comisión de PAGO ÚNICO en la
/// misma transacción; no hay elección de modalidad ni mensualidades.
model AffiliateNetworkBonusAward {
  id          String @id @default(cuid())
  affiliateId String
  /// 1..5 — el escalón EN LA CONFIG, no en pantalla.
  tier        Int
  /// Umbral congelado al otorgarse.
  clinics     Int
  /// Monto de pago único, congelado al otorgarse.
  onceMxn     Float
  /// ⚠️ SIN USO desde ago 2026 (se retiró la modalidad mensual). Queda en 0.
  monthlyMxn  Float
  /// tracking | awarded
  status      String @default("tracking")
  /// Inicio de la racha de 3 meses. null = hoy no está en el umbral.
  qualifiedSince DateTime?
  awardedAt      DateTime?
  /// ⚠️ SIN USO desde ago 2026 (columnas de la elección de modalidad retirada).
  chosenAt       DateTime?
  choice         String?
  /// Cuándo se generó la comisión del pago único.
  paidAt         DateTime?
  /// ⚠️ SIN USO desde ago 2026 (rastro de la modalidad mensual retirada).
  lastMonthlyAt  DateTime?
  lastMonthlyKey String?
  monthlyPaidCount Int     @default(0)
  pausedAt       DateTime?
  /// Último conteo de red que vio el cron: es lo que explica una pausa.
  lastCount      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([affiliateId, tier])
  @@index([status])
  @@index([affiliateId])
  @@map("affiliate_network_bonus_awards")
}

/// Términos CONGELADOS de una clínica referida: con qué modalidad se le paga
/// al afiliado por esta clínica. Se crea al atribuirse el alta. Sin relación
/// Prisma a Clinic/Affiliate (FKs en el SQL, mismo patrón que
/// AffiliateSellerAttribution).
model AffiliateClinicTerms {
  id            String    @id @default(cuid())
  clinicId      String    @unique
  affiliateId   String
  payoutMode    String    @default("recurring") // congelado al alta
  oneTimePaidAt DateTime? // candado: el pago único ya se generó
  createdAt     DateTime  @default(now())

  @@index([affiliateId])
  @@map("affiliate_clinic_terms")
}

// ═══════════════════════════════════════════════════════════════════════════
// SOPORTE DE AFILIADOS (ago 2026) — sql/afiliados-atribucion-soporte.sql
//
// TABLAS PROPIAS, NO se reusa support_tickets: el soporte de clínicas está
// acoplado a clinicId de punta a punta (incluidos los adjuntos, con prefijo
// support/{clinicId}/). Meterle afiliados arriesgaría soporte en producción.
// Por eso esto es un ESPEJO 1:1 de SupportTicket/SupportMessage con
// affiliateId donde el otro lleva clinicId.
//
// Estados/categorías/prioridades son String, igual que en el de clínicas; los
// valores válidos los define src/lib/affiliate-support/types.ts (evita enums
// de Postgres en el SQL manual). Al final del schema para no chocar con ramas
// paralelas.
// ═══════════════════════════════════════════════════════════════════════════

model AffiliateSupportTicket {
  id            String  @id @default(cuid())
  folio         Int     @unique @default(autoincrement()) // se muestra como #AF-0001
  affiliateId   String
  createdById   String? // AffiliateUser.id (sin FK: el ticket sobrevive al usuario)
  createdByName String?
  subject       String
  category      String  @default("DUDA") // COMISIONES | PAGOS | MATERIAL | CUENTA | DUDA
  priority      String  @default("NORMAL") // BAJA | NORMAL | ALTA | URGENTE
  status        String  @default("ABIERTO") // ABIERTO | EN_PROGRESO | ESPERANDO_RESPUESTA | RESUELTO | CERRADO
  rating        Int? // 1-5, opcional al cerrar

  // Campos de métricas/badges, mantenidos por el service en cada transición.
  firstResponseAt        DateTime? // primera respuesta pública de soporte
  lastAffiliateMessageAt DateTime?
  lastSupportMessageAt   DateTime?
  affiliateUnread        Boolean   @default(false) // novedades que el afiliado no ha visto

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages  AffiliateSupportMessage[]
  affiliate Affiliate                @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, status])
  @@index([status, updatedAt])
  @@map("affiliate_support_tickets")
}

model AffiliateSupportMessage {
  id           String   @id @default(cuid())
  ticketId     String
  authorType   String // affiliate | support | system
  authorId     String?
  authorName   String?
  body         String
  attachments  Json? // AffiliateSupportAttachment[]: [{ path, name, size, type }]
  internalNote Boolean  @default(false) // nota interna de soporte; el afiliado NUNCA la ve
  createdAt    DateTime @default(now())

  ticket AffiliateSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("affiliate_support_messages")
}

// ═══════════════════════════════════════════════════════════════════════
// DaleControl BARBER — producto NUEVO y SEPARADO (SaaS para barberías).
//
// NO es una especialidad del panel dental: tiene sus propias tablas (prefijo
// barber_), su propio panel (/barber), sus propios planes (barber_plan_configs)
// y su propia terminología (cliente / barbero / barbería — nunca paciente /
// doctor / clínica). Comparte con el dental SOLO: Supabase Auth (login),
// la infraestructura (Vercel, Stripe, Meta WhatsApp) y el design system.
//
// Aislamiento multi-tenant: TODA consulta de negocio filtra por barbershopId,
// que sale SIEMPRE de la sesión (getBarberContext en src/lib/barber-auth.ts),
// JAMÁS del body/query. Ojo Prisma: barbershopId undefined BORRA el filtro.
//
// WhatsApp: el modelo de envío NO está decidido (número propio de cada
// barbería vs. número de DaleControl con cupo por plan). El schema soporta
// AMBOS: whatsappSenderMode + campos de WABA propia + contador de mensajes
// del periodo + messageQuota en barber_plan_configs. El envío NO se
// implementa en la Ola 0.
//
// Contrato completo del vertical: src/lib/barber/types.ts
// SQL idempotente para Supabase:  sql/barber.sql
// ═══════════════════════════════════════════════════════════════════════

enum BarberPlan {
  BASICO
  AVANZADO
  PROFESIONAL
}

// PLATFORM  = los mensajes salen del número de DaleControl (cupo por plan).
// OWN_WABA  = la barbería conecta su propia WABA (como las clínicas dentales).
enum BarberWhatsappSender {
  PLATFORM
  OWN_WABA
}

enum BarberRole {
  OWNER
  MANAGER
  BARBER
  RECEPTION
}

enum BarberCommissionType {
  COMMISSION
  CHAIR_RENT
  SALARY
}

enum BarberAppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  DONE
  NO_SHOW
  CANCELLED
}

enum BarberAppointmentSource {
  PANEL
  PUBLIC
  WALKIN
  WHATSAPP
}

enum BarberDepositStatus {
  PENDING
  PAID
  REFUNDED
  FORFEITED
}

enum BarberWalkInStatus {
  WAITING
  CALLED
  SERVED
  LEFT
}

enum BarberClientMembershipStatus {
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

enum BarberPaymentMethod {
  CASH
  CARD
  SPEI
  STRIPE
}

enum BarberMessageDirection {
  INBOUND
  OUTBOUND
}

enum BarberMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

/// El inquilino (tenant) del vertical barber. parentId permite cadenas:
/// la matriz tiene parentId null y las sucursales apuntan a ella (feature
/// multiBranch del plan PROFESIONAL; la lógica llega en olas posteriores).
model Barbershop {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  phone    String?
  email    String?
  address  String?
  city     String?
  state    String?
  timezone String  @default("America/Mexico_City")
  locale   String  @default("es")
  logoUrl  String?
  /// Tamaño declarado en el registro: "1" | "2-3" | "4-5" | "6+" (espejo de
  /// Clinic.clinicSize; solo informativo).
  teamSize String?

  // Plan y suscripción. Registro sin trial → nace "pending_payment", igual
  // que el dental (ver sql/barber.sql + /api/barber/auth/register). Estados
  // activos: active | trialing | paid (BARBER_ACTIVE_SUBSCRIPTION_STATUSES).
  plan                 BarberPlan @default(BASICO)
  subscriptionStatus   String     @default("pending_payment")
  stripeCustomerId     String?
  stripeSubscriptionId String?

  parentId String?
  isActive Boolean @default(true)

  // Multisucursal (complemento B): branchName = nombre corto de la sede
  // ("Centro", "Norte"); isMainBranch = denormalizado de parentId (matriz
  // true, sucursal false — lo escribe quien crea la sede). El ACCESO de un
  // usuario a varias sedes vive en BarberUserBranchAccess y se resuelve
  // SOLO con getAccessibleBranchIds() (src/lib/barber-auth.ts).
  branchName   String?
  isMainBranch Boolean @default(true)

  // WhatsApp — soporta los DOS modelos de envío (ver cabecera del bloque).
  // whatsappToken se guardará CIFRADO cuando la ola de WhatsApp lo implemente.
  whatsappSenderMode  BarberWhatsappSender @default(PLATFORM)
  wabaId              String?
  phoneNumberId       String?
  whatsappToken       String?
  whatsappVerifiedAt  DateTime?
  messagesUsedPeriod  Int                  @default(0)
  messagesPeriodStart DateTime?

  // ── Configuración por barbería que nació FUERA del schema ─────────────
  // Estas siete columnas las crearon a mano sql/barber_clientes.sql,
  // sql/barber_campanas.sql y sql/barber_settings.sql mientras el schema
  // estaba congelado. Tipos y defaults copiados de esos archivos, no
  // deducidos. Sus CHECK (rangos, 'manual'|'auto') viven solo en la base:
  // Prisma no los modela y la capa de negocio los repite en código.
  //
  // Fidelidad e inactividad → src/lib/barber/clients.ts
  loyaltyEnabled   Boolean @default(true)
  loyaltyThreshold Int     @default(10)
  loyaltyReward    String?
  inactiveDays     Int     @default(60)
  // Campañas de retención → src/lib/barber/campaigns.ts
  campaignCooldownDays Int   @default(21)
  campaignTemplates    Json?
  // Reserva pública: 'manual' | 'auto' → settings.ts y resolveBookingPolicy
  bookingPolicy String @default("manual")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Barbershop?  @relation("BarbershopBranches", fields: [parentId], references: [id], onDelete: SetNull)
  branches Barbershop[] @relation("BarbershopBranches")

  users             BarberUser[]
  barbers           Barber[]
  clients           BarberClient[]
  services          BarberService[]
  appointments      BarberAppointment[]
  walkIns           BarberWalkIn[]
  memberships       BarberMembership[]
  clientMemberships BarberClientMembership[]
  sales             BarberSale[]
  products          BarberProduct[]
  cashSessions      BarberCashSession[]
  commissionEntries BarberCommissionEntry[]
  messages          BarberMessage[]
  schedules         BarberSchedule[]
  timeOff           BarberTimeOff[]
  visitPhotos       BarberVisitPhoto[]
  clientAuthTokens  BarberClientAuthToken[]
  supportTickets    BarberSupportTicket[]
  supportMessages   BarberSupportMessage[]
  landingConfig     BarberLandingConfig?
  stockMovements    BarberStockMovement[]
  branchAccess      BarberUserBranchAccess[]
  paymentSettings   BarberPaymentSettings?
  adminActions      BarberAdminAction[]
  botSettings       BarberBotSettings?
  botUsage          BarberBotUsage[]
  botPauses         BarberBotPause[]

  @@index([parentId])
  @@map("barber_shops")
}

/// Quien entra al panel /barber. Espejo de DentalLabUser. permissionsOverride:
/// si tiene keys, esas REEMPLAZAN el default del rol (no se suman) — misma
/// semántica que User.permissionsOverride del dental.
model BarberUser {
  id                  String     @id @default(cuid())
  barbershopId        String
  supabaseId          String
  email               String
  firstName           String
  lastName            String
  role                BarberRole @default(OWNER)
  /// Si este usuario ES un barbero operativo, apunta a su fila Barber.
  barberId            String?
  isActive            Boolean    @default(true)
  permissionsOverride String[]   @default([])
  lastLogin           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber     Barber?    @relation(fields: [barberId], references: [id], onDelete: SetNull)

  salesSold          BarberSale[]        @relation("BarberSaleSoldBy")
  cashSessionsOpened BarberCashSession[] @relation("BarberCashOpenedBy")
  cashSessionsClosed BarberCashSession[] @relation("BarberCashClosedBy")

  timeOffCreated        BarberTimeOff[]          @relation("BarberTimeOffCreatedBy")
  visitPhotosUploaded   BarberVisitPhoto[]       @relation("BarberVisitPhotoUploadedBy")
  supportTicketsCreated BarberSupportTicket[]    @relation("BarberSupportTicketCreatedBy")
  landingConfigsUpdated BarberLandingConfig[]    @relation("BarberLandingConfigUpdatedBy")
  stockMovements        BarberStockMovement[]    @relation("BarberStockMovementUser")
  branchAccess          BarberUserBranchAccess[]

  @@unique([supabaseId, barbershopId])
  @@index([supabaseId])
  @@index([barbershopId])
  @@map("barber_users")
}

/// El profesional (puede existir SIN login; si tiene, BarberUser.barberId
/// apunta aquí). Esquema de pago: comisión (%), renta de silla o sueldo.
model Barber {
  id             String               @id @default(cuid())
  barbershopId   String
  name           String
  nickname       String?
  photoUrl       String?
  bio            String?              @db.Text
  commissionType BarberCommissionType @default(COMMISSION)
  commissionPct  Decimal?             @db.Decimal(5, 2)
  chairRent      Decimal?             @db.Decimal(10, 2)
  isActive       Boolean              @default(true)
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  barbershop        Barbershop              @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  users             BarberUser[]
  appointments      BarberAppointment[]
  walkIns           BarberWalkIn[]
  sales             BarberSale[]
  commissionEntries BarberCommissionEntry[]
  schedules         BarberSchedule[]
  timeOff           BarberTimeOff[]

  @@index([barbershopId, isActive])
  @@map("barber_barbers")
}

/// El CLIENTE (nunca "paciente"). preferences (Json): máquina/número, raya,
/// largo, alergias a productos, etc. — forma libre, la define la ola de
/// clientes. loyaltyCount = sellos de lealtad acumulados.
model BarberClient {
  id           String    @id @default(cuid())
  barbershopId String
  name         String
  phone        String
  email        String?
  birthday     DateTime?
  notes        String?   @db.Text
  preferences  Json?
  photoUrl     String?
  loyaltyCount Int       @default(0)
  totalVisits  Int       @default(0)
  lastVisitAt  DateTime?
  blockedAt    DateTime?

  // Portal del cliente (complemento B): entra con su teléfono + código de un
  // solo uso (BarberClientAuthToken) — SIN contraseña. supabaseId es opcional
  // y solo se llena si algún flujo liga la sesión a Supabase.
  portalEnabled     Boolean   @default(false)
  lastPortalLoginAt DateTime?
  supabaseId        String?   @unique

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  barbershop   Barbershop               @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments BarberAppointment[]
  memberships  BarberClientMembership[]
  sales        BarberSale[]
  messages     BarberMessage[]
  visitPhotos  BarberVisitPhoto[]
  authTokens   BarberClientAuthToken[]

  // ÚNICO (antes solo índice): dos reservas simultáneas del mismo teléfono
  // ya NO crean clientes duplicados (phone es NOT NULL). El alta hace
  // upsert / atrapa P2002 sobre (barbershopId, phone).
  @@unique([barbershopId, phone])
  @@index([barbershopId, name])
  // Los dos de abajo los creó sql/barber_clientes.sql (lista de inactivos y
  // búsqueda por teléfono). Se declaran para que Prisma no los tire en un
  // db push. El de cumpleaños por mes de ese mismo archivo es un índice de
  // expresión (EXTRACT(MONTH …)) y Prisma no puede modelarlo: sigue solo en SQL.
  @@index([barbershopId, lastVisitAt], map: "barber_clients_shop_lastVisit_idx")
  @@index([barbershopId, phone], map: "barber_clients_shop_phone_idx")
  @@map("barber_clients")
}

/// Catálogo de servicios de la barbería. El precio aquí es el precio VIVO;
/// al reservar se congela en BarberAppointmentService.priceAtBooking.
model BarberService {
  id           String   @id @default(cuid())
  barbershopId String
  name         String
  description  String?  @db.Text
  durationMin  Int
  price        Decimal  @db.Decimal(10, 2)
  category     String   @default("general")
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop          Barbershop                 @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointmentServices BarberAppointmentService[]
  saleItems           BarberSaleItem[]

  @@index([barbershopId, isActive])
  @@map("barber_services")
}

/// La cita. Un walk-in convertido a cita puede NO tener BarberClient:
/// clientName/clientPhone capturan al cliente suelto. barberId null =
/// "cualquier barbero" (se asigna después).
model BarberAppointment {
  id            String                  @id @default(cuid())
  barbershopId  String
  clientId      String?
  clientName    String?
  clientPhone   String?
  barberId      String?
  startAt       DateTime
  endAt         DateTime
  status        BarberAppointmentStatus @default(PENDING)
  source        BarberAppointmentSource @default(PANEL)
  depositAmount Decimal?                @db.Decimal(10, 2)
  depositStatus BarberDepositStatus?
  notes         String?                 @db.Text
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  barbershop        Barbershop                 @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  client            BarberClient?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  barber            Barber?                    @relation(fields: [barberId], references: [id], onDelete: SetNull)
  services          BarberAppointmentService[]
  sales             BarberSale[]
  commissionEntries BarberCommissionEntry[]
  messages          BarberMessage[]
  visitPhotos       BarberVisitPhoto[]

  @@index([barbershopId, startAt])
  @@index([barberId, startAt])
  @@index([barbershopId, status])
  @@map("barber_appointments")
}

/// Join cita ↔ servicio. priceAtBooking congela el precio al reservar.
/// serviceId es NoAction (no Restrict) a propósito: NO ACTION se verifica al
/// FINAL del statement, así el borrado en cascada de una barbería completa
/// no truena; borrar un servicio individual con citas sigue bloqueado
/// (usar isActive para retirarlo del catálogo).
model BarberAppointmentService {
  id             String   @id @default(cuid())
  appointmentId  String
  serviceId      String
  priceAtBooking Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  appointment BarberAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     BarberService     @relation(fields: [serviceId], references: [id], onDelete: NoAction)

  @@index([appointmentId])
  @@index([serviceId])
  @@map("barber_appointment_services")
}

/// Fila virtual (walk-ins). position = orden visible en la fila; la ola de
/// fila define cómo se recompacta. barberId = preferencia, no asignación.
model BarberWalkIn {
  id           String             @id @default(cuid())
  barbershopId String
  clientName   String
  phone        String?
  barberId     String?
  joinedAt     DateTime           @default(now())
  calledAt     DateTime?
  servedAt     DateTime?
  status       BarberWalkInStatus @default(WAITING)
  position     Int
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber     Barber?    @relation(fields: [barberId], references: [id], onDelete: SetNull)

  @@index([barbershopId, status, position])
  @@index([barbershopId, joinedAt])
  @@map("barber_walkins")
}

/// Plan que la barbería le vende a SU cliente (p.ej. "corte ilimitado").
/// includedCuts null = ilimitado. periodDays = duración del ciclo.
model BarberMembership {
  id           String   @id @default(cuid())
  barbershopId String
  name         String
  description  String?  @db.Text
  price        Decimal  @db.Decimal(10, 2)
  includedCuts Int?
  periodDays   Int      @default(30)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop        Barbershop               @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  clientMemberships BarberClientMembership[]

  @@index([barbershopId, isActive])
  @@map("barber_memberships")
}

/// Suscripción de un cliente a una membresía de la barbería.
/// membershipId es NoAction por la misma razón que BarberAppointmentService.
model BarberClientMembership {
  id                   String                       @id @default(cuid())
  barbershopId         String
  clientId             String
  membershipId         String
  status               BarberClientMembershipStatus @default(ACTIVE)
  startAt              DateTime                     @default(now())
  endAt                DateTime
  cutsUsed             Int                          @default(0)
  paymentMethod        BarberPaymentMethod          @default(CASH)
  stripeSubscriptionId String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  barbershop Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  client     BarberClient     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  membership BarberMembership @relation(fields: [membershipId], references: [id], onDelete: NoAction)

  @@index([barbershopId, status])
  @@index([clientId])
  @@index([membershipId])
  // "Por vencer / vencidas" ordena por endAt dentro de la barbería
  // (sql/barber_membresias.sql). Declarado para que un db push no lo tire.
  @@index([barbershopId, endAt], map: "barber_client_memberships_shop_end_idx")
  @@map("barber_client_memberships")
}

/// Ticket de venta (servicios + productos + propina). soldByUserId es
/// NoAction: los BarberUser se desactivan (isActive=false), no se borran.
model BarberSale {
  id            String              @id @default(cuid())
  barbershopId  String
  appointmentId String?
  clientId      String?
  barberId      String?
  subtotal      Decimal             @default(0) @db.Decimal(10, 2)
  tip           Decimal             @default(0) @db.Decimal(10, 2)
  total         Decimal             @default(0) @db.Decimal(10, 2)
  paymentMethod BarberPaymentMethod @default(CASH)
  cashSessionId String?
  soldByUserId  String
  notes         String?             @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  barbershop        Barbershop              @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointment       BarberAppointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  client            BarberClient?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  barber            Barber?                 @relation(fields: [barberId], references: [id], onDelete: SetNull)
  cashSession       BarberCashSession?      @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  soldBy            BarberUser              @relation("BarberSaleSoldBy", fields: [soldByUserId], references: [id], onDelete: NoAction)
  items             BarberSaleItem[]
  commissionEntries BarberCommissionEntry[]
  stockMovements    BarberStockMovement[]

  @@index([barbershopId, createdAt])
  @@index([barberId, createdAt])
  @@index([cashSessionId])
  @@map("barber_sales")
}

/// Línea del ticket. serviceId XOR productId (o ninguno para línea libre);
/// description siempre presente para que el ticket sobreviva borrados.
model BarberSaleItem {
  id        String  @id @default(cuid())
  saleId    String
  serviceId String?
  productId String?
  description String
  qty       Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)

  sale    BarberSale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  service BarberService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  product BarberProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@map("barber_sale_items")
}

/// Inventario simple (ceras, shampoos, aceites…).
model BarberProduct {
  id           String   @id @default(cuid())
  barbershopId String
  name         String
  sku          String?
  price        Decimal  @db.Decimal(10, 2)
  cost         Decimal? @db.Decimal(10, 2)
  stock        Int      @default(0)
  /// Umbral de alerta de stock bajo (null = sin alerta).
  minStock     Int?
  /// Unidad de venta/medida: "pieza", "ml", "g"… (texto libre).
  unit         String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop     Barbershop            @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  saleItems      BarberSaleItem[]
  stockMovements BarberStockMovement[]

  @@index([barbershopId, isActive])
  @@map("barber_products")
}

/// Corte de caja (por turno, no por día). openedByUserId NoAction (usuarios
/// se desactivan, no se borran).
model BarberCashSession {
  id             String    @id @default(cuid())
  barbershopId   String
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  openingAmount  Decimal   @default(0) @db.Decimal(10, 2)
  countedAmount  Decimal?  @db.Decimal(10, 2)
  expectedAmount Decimal?  @db.Decimal(10, 2)
  notes          String?   @db.Text
  openedByUserId String
  closedByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  barbershop Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  openedBy   BarberUser  @relation("BarberCashOpenedBy", fields: [openedByUserId], references: [id], onDelete: NoAction)
  closedBy   BarberUser? @relation("BarberCashClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  sales      BarberSale[]

  @@index([barbershopId, openedAt])
  @@map("barber_cash_sessions")
}

/// Comisión devengada de un barbero. periodKey = "YYYY-MM" (o quincena
/// "YYYY-MM-Q1/Q2", lo decide la ola de comisiones). paidAt null = pendiente.
/// barberId NoAction: no se puede borrar un barbero con comisiones (dinero).
model BarberCommissionEntry {
  id            String    @id @default(cuid())
  barbershopId  String
  barberId      String
  saleId        String?
  appointmentId String?
  base          Decimal   @db.Decimal(10, 2)
  pct           Decimal?  @db.Decimal(5, 2)
  amount        Decimal   @db.Decimal(10, 2)
  periodKey     String
  paidAt        DateTime?
  createdAt     DateTime  @default(now())

  barbershop  Barbershop         @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber      Barber             @relation(fields: [barberId], references: [id], onDelete: NoAction)
  sale        BarberSale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  appointment BarberAppointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([barbershopId, periodKey])
  @@index([barberId, periodKey])
  @@map("barber_commission_entries")
}

/// Mensajería WhatsApp del vertical barber (recordatorios, inbox, bot).
/// La ola de WhatsApp la completa; el modelo queda listo desde la Ola 0.
model BarberMessage {
  id            String                 @id @default(cuid())
  barbershopId  String
  direction     BarberMessageDirection
  waMessageId   String?
  phone         String
  body          String?                @db.Text
  templateName  String?
  status        BarberMessageStatus    @default(PENDING)
  errorMessage  String?
  clientId      String?
  appointmentId String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  barbershop  Barbershop         @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  client      BarberClient?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  appointment BarberAppointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([barbershopId, createdAt])
  @@index([barbershopId, phone])
  @@index([waMessageId])
  @@map("barber_messages")
}

/// Los 3 planes del vertical barber, EDITABLES sin redeploy (espejo de
/// plan_configs del dental). FUENTE ÚNICA de precios/límites — prohibido
/// hardcodear precios en la UI. planId: BASICO | AVANZADO | PROFESIONAL.
/// -1 = ilimitado en maxBarbers/maxBranches/messageQuota.
/// messageQuota es PROVISIONAL (depende del costo de Meta; Rafael confirma).
model BarberPlanConfig {
  planId               String   @id
  name                 String
  priceMonthly         Decimal  @db.Decimal(10, 2)
  priceYearly          Decimal? @db.Decimal(10, 2)
  firstMonthPrice      Decimal? @db.Decimal(10, 2)
  maxBarbers           Int      @default(1)
  maxBranches          Int      @default(1)
  messageQuota         Int      @default(200)
  features             Json
  stripePriceIdMonthly String?
  stripePriceIdYearly  String?
  sortOrder            Int      @default(0)
  isActive             Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  @@map("barber_plan_configs")
}

// ═══════════════════════════════════════════════════════════════════════
// BARBER — COMPLEMENTO B: horarios y bloqueos, fotos del historial de
// cortes, portal del cliente (login por teléfono + código), tickets de
// soporte, configuración de la mini-web, bitácora de inventario y
// multisucursal. SQL idempotente espejo: sql/barber_complemento.sql
// ═══════════════════════════════════════════════════════════════════════

enum BarberTimeOffType {
  BREAK
  VACATION
  HOLIDAY
  OTHER
}

enum BarberPhotoKind {
  BEFORE
  AFTER
  REFERENCE
}

enum BarberTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_REPLY
  CLOSED
}

enum BarberTicketPriority {
  LOW
  NORMAL
  HIGH
}

// SHOP = alguien de la barbería; ADMIN = soporte DaleControl.
enum BarberTicketAuthor {
  SHOP
  ADMIN
}

enum BarberStockMovementType {
  IN
  OUT
  ADJUST
  SALE
  RETURN
}

/// Horario recurrente de un barbero. dayOfWeek 0-6 con 0 = domingo (criterio
/// JS getDay()). startMinute/endMinute = minutos desde medianoche en la zona
/// de la barbería (Barbershop.timezone). Varias filas por día = turno partido
/// (mañana y tarde son DOS filas). endMinute > startMinute — un turno que
/// cruza medianoche se parte en dos filas.
model BarberSchedule {
  id           String   @id @default(cuid())
  barbershopId String
  barberId     String
  dayOfWeek    Int
  startMinute  Int
  endMinute    Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber     Barber     @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barbershopId, barberId, dayOfWeek])
  @@map("barber_schedules")
}

/// Bloqueo puntual de agenda. barberId null = TODA la barbería cerrada (p.ej.
/// día festivo). Ojo onDelete de barberId: Cascade A PROPÓSITO — un SetNull
/// convertiría el bloqueo personal de un barbero borrado en "barbería
/// cerrada" (cambio de semántica silencioso).
model BarberTimeOff {
  id              String            @id @default(cuid())
  barbershopId    String
  barberId        String?
  startAt         DateTime
  endAt           DateTime
  reason          String?
  type            BarberTimeOffType @default(OTHER)
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber     Barber?    @relation(fields: [barberId], references: [id], onDelete: Cascade)
  createdBy  BarberUser @relation("BarberTimeOffCreatedBy", fields: [createdByUserId], references: [id], onDelete: NoAction)

  @@index([barbershopId, startAt, endAt])
  @@map("barber_time_off")
}

/// Foto del historial de cortes (varias por visita; BarberClient.photoUrl es
/// solo LA foto de perfil). visibleToClient: el portal del cliente muestra
/// ÚNICAMENTE las marcadas true (default false — nada se publica solo).
model BarberVisitPhoto {
  id               String          @id @default(cuid())
  barbershopId     String
  clientId         String
  appointmentId    String?
  url              String
  kind             BarberPhotoKind
  visibleToClient  Boolean         @default(false)
  uploadedByUserId String
  createdAt        DateTime        @default(now())

  barbershop  Barbershop         @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  client      BarberClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment BarberAppointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  uploadedBy  BarberUser         @relation("BarberVisitPhotoUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: NoAction)

  @@index([barbershopId, clientId, createdAt])
  @@index([appointmentId])
  @@map("barber_visit_photos")
}

/// Código de un solo uso del portal del cliente (login por teléfono, SIN
/// contraseña). codeHash = SOLO el hash — el código en claro JAMÁS se guarda
/// ni se loguea. attempts = intentos fallidos contra ESTE código (el tope lo
/// define la ola del portal). usedAt != null = quemado.
model BarberClientAuthToken {
  id           String    @id @default(cuid())
  clientId     String
  barbershopId String
  codeHash     String
  expiresAt    DateTime
  usedAt       DateTime?
  attempts     Int       @default(0)
  createdAt    DateTime  @default(now())

  client     BarberClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  barbershop Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt])
  @@index([barbershopId])
  @@map("barber_client_auth_tokens")
}

/// Ticket de soporte barbería → DaleControl (espejo del SupportTicket dental).
/// category: BUG | DUDA | FACTURACION | SUGERENCIA (String como el dental;
/// catálogo en BARBER_TICKET_CATEGORIES de types.ts). lastMessageAt lo
/// mantiene el service en cada mensaje.
model BarberSupportTicket {
  id              String               @id @default(cuid())
  barbershopId    String
  createdByUserId String
  subject         String
  category        String               @default("DUDA")
  status          BarberTicketStatus   @default(OPEN)
  priority        BarberTicketPriority @default(NORMAL)
  lastMessageAt   DateTime             @default(now())
  closedAt        DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  barbershop Barbershop             @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  createdBy  BarberUser             @relation("BarberSupportTicketCreatedBy", fields: [createdByUserId], references: [id], onDelete: NoAction)
  messages   BarberSupportMessage[]

  @@index([barbershopId, status])
  @@index([status, updatedAt])
  @@map("barber_support_tickets")
}

/// Mensaje de un ticket. authorType SHOP → authorUserId = barber_users.id;
/// ADMIN → authorUserId = id del admin DaleControl (sistema dental). Por eso
/// authorUserId NO lleva FK (mismo criterio que SupportMessage.authorId del
/// dental). attachments: BarberSupportAttachment[] = [{ path, name, size,
/// type }] en el bucket BARBER_FILES_BUCKET.
model BarberSupportMessage {
  id           String             @id @default(cuid())
  ticketId     String
  barbershopId String
  authorType   BarberTicketAuthor
  authorUserId String?
  body         String             @db.Text
  attachments  Json               @default("[]")
  createdAt    DateTime           @default(now())

  ticket     BarberSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  barbershop Barbershop          @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("barber_support_messages")
}

/// Configuración de la mini-web pública (/b/[slug]). version = BLOQUEO
/// OPTIMISTA: el guardado manda la version que leyó y el server rechaza con
/// 409 si ya no coincide — exactamente lo que evita el "guardar pisado" que
/// sufrió el editor dental. template la define la ola de mi-web.
model BarberLandingConfig {
  id              String    @id @default(cuid())
  barbershopId    String    @unique
  template        String
  config          Json      @default("{}")
  version         Int       @default(0)
  publishedAt     DateTime?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  barbershop Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  updatedBy  BarberUser? @relation("BarberLandingConfigUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("barber_landing_configs")
}

/// Bitácora de inventario — TODO cambio de BarberProduct.stock deja fila aquí.
/// CONVENCIÓN DE SIGNO: qty es SIGNADO — positivo suma stock (IN, RETURN,
/// ADJUST hacia arriba), negativo resta (OUT, SALE, ADJUST hacia abajo).
/// Invariante: stock actual = stock inicial + Σ qty de sus movimientos.
/// productId es NoAction: un producto con bitácora NO se borra (retirarlo =
/// isActive false), mismo criterio que barberId en comisiones.
model BarberStockMovement {
  id           String                  @id @default(cuid())
  productId    String
  barbershopId String
  type         BarberStockMovementType
  qty          Int
  reason       String?
  saleId       String?
  userId       String
  createdAt    DateTime                @default(now())

  product    BarberProduct @relation(fields: [productId], references: [id], onDelete: NoAction)
  barbershop Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  sale       BarberSale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)
  user       BarberUser    @relation("BarberStockMovementUser", fields: [userId], references: [id], onDelete: NoAction)

  @@index([barbershopId, productId, createdAt])
  @@map("barber_stock_movements")
}

/// Acceso de un BarberUser a OTRA sede de su cadena (la propia la da su fila
/// BarberUser). Se consume EXCLUSIVAMENTE vía getAccessibleBranchIds()
/// (src/lib/barber-auth.ts) — ninguna terminal inventa su filtro de sucursal.
model BarberUserBranchAccess {
  id           String   @id @default(cuid())
  userId       String
  barbershopId String
  createdAt    DateTime @default(now())

  user       BarberUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([userId, barbershopId])
  @@index([barbershopId])
  @@map("barber_user_branch_access")
}

// ═══════════════════════════════════════════════════════════════════════
// BARBER — PROGRAMA DE SOCIOS (afiliados del vertical). Una barbería
// recomienda DaleControl Barber a otra y cobra comisión cuando la referida
// PAGA (no cuando se registra). SQL idempotente espejo:
// sql/barber_afiliados.sql
//
// AISLADO DEL DENTAL A PROPÓSITO. El motor de afiliados dental (Affiliate,
// AffiliateCommission, AffiliateClick, /r/<code>, cookie dc_aff) NO se toca
// ni se importa: allá el afiliado es una PERSONA externa con panel propio;
// aquí el socio ES una barbería cliente y todo vive dentro de su panel.
// Cookies propias (dcb_aff / dcb_vid) para que las dos atribuciones jamás
// se pisen en el mismo navegador. Lo único que se copió a propósito es el
// criterio: PRIMER TOQUE y 90 días, para no tener dos reglas en la casa.
//
// SIN relación Prisma a Barbershop a PROPÓSITO (mismo patrón que
// AffiliateCommission / AiUsageEvent): las FKs viven en el SQL. Así no se
// añade ni un campo a un modelo existente y esta ola no colisiona con
// ninguna otra rama.
//
// DINERO: Decimal(10,2) SIEMPRE, jamás Float. Los montos y porcentajes NO
// están en el código ni en la UI: salen de BarberAffiliateConfig.
// ═══════════════════════════════════════════════════════════════════════

/// SIGNED_UP = se registró por la liga. PAYING = su suscripción está al día
/// (es lo que dispara la comisión). CHURNED = pagó y dejó de pagar; la
/// comisión ya generada NO se borra, solo deja de generarse la siguiente.
enum BarberAffiliateReferralStatus {
  SIGNED_UP
  PAYING
  CHURNED
}

/// PENDING = generada, aún en periodo de retención (holdDays). AVAILABLE =
/// se puede pagar. PAID = Rafael ya la pagó a mano y dejó el comprobante.
enum BarberAffiliateCommissionStatus {
  PENDING
  AVAILABLE
  PAID
}

/// La barbería vista como SOCIO: su código de referido y sus datos de pago.
/// 1:1 con la barbería (barbershopId único). Se crea sola la primera vez
/// que entra a /barber/afiliados con un plan que incluye la feature.
model BarberAffiliateAccount {
  id           String  @id @default(cuid())
  barbershopId String  @unique
  /// Código público de la liga corta. [A-Z0-9]{8} sin caracteres ambiguos
  /// (ver BARBER_AFF_CODE_ALPHABET en @/lib/barber/affiliates).
  referralCode String  @unique
  isActive     Boolean @default(true)

  /// Cómo quiere cobrar: lo captura la barbería, lo lee Rafael al pagar.
  /// Texto libre a propósito (CLABE, banco, "efectivo en sucursal"): no hay
  /// dispersión automática que exija un formato.
  payoutMethod  String?
  payoutDetails String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrals   BarberAffiliateReferral[]
  commissions BarberAffiliateCommission[]

  @@index([barbershopId])
  @@map("barber_affiliate_accounts")
}

/// Un clic en la liga de un socio. barbershopId = la barbería DUEÑA de la
/// liga (quien cobra), nunca la que visita. El dedupe es por `vid` (cookie
/// dcb_vid del navegador) y NO por IP: en México el CGNAT móvil pone miles
/// de teléfonos detrás de una sola IP y la liga se comparte por WhatsApp.
model BarberAffiliateClick {
  id           String @id @default(cuid())
  barbershopId String
  code         String
  /// Cookie dcb_vid — id opaco aleatorio del navegador. Nada derivado de la
  /// IP ni del user-agent: derivarlo de la red sería el mismo bug con otro
  /// nombre. Nullable porque un visitante sin cookies igual se redirige.
  vid       String?
  /// sha256 truncado con sal — JAMÁS la IP cruda.
  ipHash    String?
  userAgent String?
  /// true = suma al contador; false = bot o repetido dentro de la ventana.
  /// La fila se guarda igual para poder auditar por qué no contó.
  counted   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([barbershopId, createdAt])
  @@index([code, vid, createdAt])
  @@map("barber_affiliate_clicks")
}

/// La atribución: quién refirió a quién. UNA por barbería referida
/// (referredBarbershopId único) y PERMANENTE — se escribe una sola vez, al
/// darse de alta la referida, y ninguna superficie la cambia ni la borra.
/// Si se pudiera reasignar, cualquiera se robaría la comisión de otro justo
/// antes del primer cobro.
model BarberAffiliateReferral {
  id           String @id @default(cuid())
  /// Barbería que REFIERE (la que cobra). Redundante con account.barbershopId
  /// a propósito: todo filtro del panel es `where barbershopId` directo.
  barbershopId String
  accountId    String
  /// Barbería REFERIDA. Única: primer toque gana, no hay segunda atribución.
  referredBarbershopId String @unique
  code                 String

  status BarberAffiliateReferralStatus @default(SIGNED_UP)
  /// Epoch del clic que sembró la cookie (no del alta): es la fecha que
  /// prueba que el socio hizo el trabajo antes del registro.
  firstTouchAt DateTime
  signedUpAt   DateTime  @default(now())
  /// Primera vez que la referida quedó al día. null = nunca ha pagado.
  firstPaidAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account     BarberAffiliateAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  commissions BarberAffiliateCommission[]

  @@index([barbershopId, createdAt])
  @@index([accountId, status])
  @@map("barber_affiliate_referrals")
}

/// Comisión devengada por un socio. Se genera cuando la referida está al
/// día, NUNCA al registrarse. Idempotente por (referredBarbershopId,
/// periodKey): correr la sincronización mil veces no duplica un peso.
model BarberAffiliateCommission {
  id           String @id @default(cuid())
  /// Barbería que COBRA. El índice con status es la consulta del panel.
  barbershopId String
  accountId    String
  referralId   String
  /// Denormalizado para no unir con la referida al listar.
  referredBarbershopId String
  /// Periodo que cubre: "signup" (pago único) o "YYYY-MM" (recurrente).
  /// Junto con referredBarbershopId es la llave de idempotencia.
  periodKey            String

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("MXN")
  /// Foto de CÓMO se calculó, congelada al generarse: cambiar la config
  /// nunca reescribe una comisión ya devengada.
  basis    Json?

  status      BarberAffiliateCommissionStatus @default(PENDING)
  /// Cuándo deja de estar retenida (createdAt + holdDays de la config).
  availableAt DateTime

  // ── Pago MANUAL (Rafael). No hay dispersión automática: esto es el
  //    registro y el comprobante, nada más.
  paidAt         DateTime?
  /// Referencia del pago: folio SPEI, id de la transferencia, "efectivo".
  payoutRef      String?
  /// URL del comprobante que Rafael adjunta al pagar.
  payoutProofUrl String?
  payoutNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account  BarberAffiliateAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  referral BarberAffiliateReferral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@unique([referredBarbershopId, periodKey])
  @@index([barbershopId, status])
  @@index([accountId, createdAt])
  @@map("barber_affiliate_commissions")
}

/// Config GLOBAL del programa — una sola fila id="default", igual que
/// AiPricingConfig del dental y que barber_plan_configs.
///
/// ÚNICO modelo de este bloque SIN barbershopId, y a propósito: si la
/// comisión fuera por barbería, la barbería podría fijarse su propia
/// comisión. La edita Rafael por SQL (no hay admin en esta ola).
///
/// Si la fila no existe, el código cae a FALLBACK_BARBER_AFFILIATE_CONFIG
/// (@/lib/barber/affiliates) — los MISMOS números que el INSERT de
/// sql/barber_afiliados.sql. La UI jamás escribe un monto: siempre lee.
model BarberAffiliateConfig {
  id        String  @id @default("default")
  isEnabled Boolean @default(true)

  /// "fixed" = monto fijo por referida que paga. "pct" = porcentaje del
  /// precio del plan que contrató la referida.
  mode        String  @default("fixed")
  /// Monto fijo en MXN (mode = "fixed").
  fixedAmount Decimal @default(0) @db.Decimal(10, 2)
  /// Porcentaje 0..100 (mode = "pct").
  percent     Decimal @default(0) @db.Decimal(5, 2)
  currency    String  @default("MXN")

  /// true = una comisión por cada mes que la referida siga pagando;
  /// false = una sola vez (periodKey "signup").
  recurring Boolean @default(false)
  /// Tope de meses del recurrente. 0 = sin tope.
  maxMonths Int     @default(0)
  /// Días de retención antes de que la comisión pase a AVAILABLE (cubre
  /// reembolsos y contracargos de la referida).
  holdDays  Int     @default(30)
  /// Mínimo acumulado en AVAILABLE para poder pedir el pago.
  minPayout Decimal @default(0) @db.Decimal(10, 2)
  /// Liga a los términos del programa que ve el socio. null = no se pinta.
  termsUrl  String?

  updatedAt DateTime @updatedAt

  @@map("barber_affiliate_config")
}

// ═══════════════════════════════════════════════════════════════════════
// BARBER — TABLAS QUE NACIERON FUERA DEL SCHEMA
//
// Durante las olas en paralelo el schema estuvo congelado y cinco tablas se
// crearon solo desde sql/barber_{membresias,admin,bot}.sql. Aquí se modelan
// tal cual EXISTEN en la base (nombres, tipos, defaults e índices copiados
// de esos archivos, no deducidos) para que un `prisma db push` deje de
// borrarlas. Migración espejo, idempotente:
// prisma/migrations/20260825120000_barber_deuda_tecnica_tablas_sql
//
// Ojo con barber_admin_actions: usa snake_case y timestamptz porque así se
// creó en producción. Se respeta con @map / @db.Timestamptz, no se
// "normaliza".
// ═══════════════════════════════════════════════════════════════════════

/// Política de anticipos por barbería (sql/barber_membresias.sql).
/// `settings` = { deposit: BarberDepositPolicy }; lo valida y normaliza
/// normalizeDepositPolicy() (payments-core.ts). La lee/escribe payments.ts.
model BarberPaymentSettings {
  barbershopId String   @id
  settings     Json     @default("{}")
  updatedAt    DateTime @default(now()) @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@map("barber_payment_settings")
}

/// Bitácora de acciones MANUALES del panel de DaleControl sobre una
/// barbería (suspender, reactivar, cambiar plan) con nota obligatoria
/// (sql/barber_admin.sql). actorAdminId es admin_users.id SIN FK a
/// propósito: borrar un admin no rompe la bitácora. La escribe admin.ts.
model BarberAdminAction {
  id           String   @id @default(uuid())
  barbershopId String   @map("barbershop_id")
  /// SUSPEND | REACTIVATE | PLAN_CHANGE
  action       String
  note         String
  beforeValue  String?  @map("before_value")
  afterValue   String?  @map("after_value")
  actorAdminId String?  @map("actor_admin_id")
  actorEmail   String?  @map("actor_email")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // La FK se creó inline (REFERENCES … ON DELETE CASCADE): ON UPDATE queda en
  // NO ACTION, que NO es el default de Prisma. Se declara para que coincida.
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([barbershopId, createdAt(sort: Desc)], map: "barber_admin_actions_shop_idx")
  @@index([createdAt(sort: Desc)], map: "barber_admin_actions_created_idx")
  @@map("barber_admin_actions")
}

/// Configuración del bot de WhatsApp por barbería (sql/barber_bot.sql).
/// `settings` tiene la forma de BarberBotSettings (bot-core.ts); la BD solo
/// guarda el blob. La lee/escribe bot.ts.
model BarberBotSettings {
  barbershopId String   @id
  settings     Json     @default("{}")
  updatedAt    DateTime @default(now()) @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@map("barber_bot_settings")
}

/// Gasto de IA del bot por barbería y por DÍA de la barbería
/// (sql/barber_bot.sql). `day` es YYYY-MM-DD en la zona de la barbería;
/// spentMicros son millonésimas de peso (1 MXN = 1e6).
model BarberBotUsage {
  barbershopId String
  day          String
  spentMicros  BigInt   @default(0)
  turns        Int      @default(0)
  updatedAt    DateTime @default(now()) @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@id([barbershopId, day])
  @@index([day], map: "barber_bot_usage_day_idx")
  @@map("barber_bot_usage")
}

/// Conversaciones con el bot PAUSADO: en este hilo contesta una persona
/// (sql/barber_bot.sql). `phone` = 10 dígitos normalizados, igual que
/// BarberMessage.phone.
model BarberBotPause {
  barbershopId String
  phone        String
  reason       String?
  pausedAt     DateTime @default(now())

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@id([barbershopId, phone])
  @@index([barbershopId, pausedAt(sort: Desc)], map: "barber_bot_pauses_shop_idx")
  @@map("barber_bot_pauses")
}

// ═══════════════════════════════════════════════════════════════════════
// DaleControl INMUEBLES — producto NUEVO y SEPARADO (SaaS inmobiliario).
//
// NO es una especialidad del dental ni una variante de barber: tiene sus
// propias tablas (prefijo realty_), su propio panel (/inmobiliaria), su web
// pública (/i/[slug]), sus propios planes (realty_plan_configs) y su propia
// terminología (prospecto / inquilino / propietario / asesor / inmueble —
// nunca paciente / doctor / clínica / barbero). Comparte con los otros dos
// SOLO: Supabase Auth (login), la infraestructura (Vercel, Stripe, Meta
// WhatsApp) y el design system.
//
// Aislamiento multi-tenant: TODA consulta de negocio filtra por accountId,
// que sale SIEMPRE de la sesión (getRealtyContext en src/lib/realty-auth.ts),
// JAMÁS del body/query. Ojo Prisma: un accountId undefined BORRA el filtro.
//
// 🔴 accountId ESTÁ EN TODAS LAS TABLAS DEL VERTICAL, incluidas las hijas
// (fotos, líneas de inventario, splits de comisión). Es denormalización a
// propósito: `include` NO es un JOIN, así que sin la columna no se puede
// filtrar un hijo por el tenant de su padre en un solo where. Las dos ÚNICAS
// excepciones son de plataforma, no de negocio, y están marcadas:
// realty_plan_configs y realty_calc_params.
//
// ⚠️ QUÉ GARANTIZA Y QUÉ NO. Las llaves foráneas son de UNA sola columna, así
// que la BASE no impide una fila con accountId = A y propertyId = <inmueble
// de B>. La columna hace el filtro por tenant POSIBLE en un solo where; NO lo
// hace automático. La regla para TODAS las olas:
//
//   · LEER  → filtra SIEMPRE por accountId, también en la hija:
//       where: { accountId: ctx.accountId, propertyId }
//     Un propertyId de otra cuenta devuelve vacío, no la fila ajena.
//   · ESCRIBIR → el id del padre viene del body y NO es de fiar. Antes de
//     insertar, comprueba que el padre es de la cuenta:
//       const p = await tx.realtyProperty.findFirst({
//         where: { id: body.propertyId, accountId: ctx.accountId },
//         select: { id: true },
//       });
//       if (!p) return 404;
//     Sin esa comprobación, un include posterior devuelve el inmueble ajeno
//     COMPLETO (dirección, precio, internalNotes) dentro de la respuesta.
//
// Endurecerlo en la base pide @@unique([id, accountId]) en cada padre y FKs
// compuestas en las ~30 hijas. Evaluado y NO hecho en la Ola 0: es un cambio
// grande y, sin las escrituras reales escritas todavía, no se puede probar.
// Queda anotado en el reporte de la ola como decisión de Rafael.
//
// 🔴 LOS TRES MODOS (RealtyAccount.mode) son el eje del producto:
//   AGENCY = inmobiliaria con agentes   → comercializa inmuebles ajenos
//   AGENT  = asesor independiente solo  → comercializa inmuebles ajenos
//   OWNER  = propietario / rentista     → administra LOS SUYOS
// El modo arma el sidebar (campo `modes` de REALTY_NAV_ITEMS) y decide qué
// pantallas existen. Va en el contrato DESDE la Ola 0 a propósito.
//
// 🔴 NO EXISTE FACTURACIÓN EN ESTE VERTICAL. Ni CFDI, ni timbrado, ni
// complemento de pago. Lo que se entrega es un RECIBO: RealtyPayment.
//
// 🔴 FECHAS: DateTime pelado = TIMESTAMP(3) SIN zona, en TODO el bloque y sin
// una sola excepción. (Ojo: partes del dental sí usan @db.Timestamptz; este
// vertical no, y mezclarlos dentro del bloque rompería las comparaciones.)
// En un constraint de exclusión sobre rangos de fecha hay que usar
// `tsrange`, NUNCA `tstzrange`: con timestamptz Postgres rechaza el índice
// con "functions in index expression must be marked IMMUTABLE".
//
// Contrato completo del vertical: src/lib/realty/types.ts
// SQL idempotente para Supabase:  sql/realty.sql
// ═══════════════════════════════════════════════════════════════════════

