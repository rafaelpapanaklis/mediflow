  signedTreatmentConsentFile   PatientFile? @relation("OrthoTreatmentConsentSignedFile", fields: [signedTreatmentConsentFileId], references: [id], onDelete: SetNull)

  diagnosis      OrthodonticDiagnosis            @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  patient        Patient                         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic         Clinic                          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  phases         OrthodonticPhase[]
  paymentPlan    OrthoPaymentPlan?
  controls       OrthodonticControlAppointment[]
  photoSets      OrthoPhotoSet[]
  digitalRecords OrthodonticDigitalRecord[]
  consents       OrthodonticConsent[]

  // Fase 1 rediseño relations.
  wireSteps        OrthoWireStep[]
  treatmentCards   OrthoTreatmentCard[]
  tads             OrthoTAD[]
  auxMechanics     OrthoAuxMechanics?
  phaseTransitions OrthoPhaseTransition[]

  // Fase 1.5 rediseño completo relations (Sección F/G/H).
  quoteScenarios     OrthoQuoteScenario[]
  retentionRegimen   OrthoRetentionRegimen?
  npsSchedules       OrthoNpsSchedule[]
  signAtHomePackages OrthoSignAtHomePackage[]
  referralCode       OrthoReferralCode?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([patientId])
  @@index([clinicId, status])
  @@index([clinicId, installedAt(sort: Desc)])
  @@map("orthodontic_treatment_plans")
}

model OrthodonticPhase {
  id              String @id @default(uuid())
  treatmentPlanId String
  clinicId        String

  phaseKey      OrthoPhaseKey
  status        OrthoPhaseStatus @default(NOT_STARTED)
  startedAt     DateTime?
  expectedEndAt DateTime?
  completedAt   DateTime?
  notes         String?
  orderIndex    Int

  treatmentPlan OrthodonticTreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  clinic        Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([treatmentPlanId, phaseKey])
  // SPEC §4.5: índice idx_ortho_kanban_lookup para query del kanban <100ms con
  // 500 pacientes activos. La migración SQL le da nombre explícito.
  @@index([clinicId, status, phaseKey], map: "idx_ortho_kanban_lookup")
  @@index([treatmentPlanId, orderIndex])
  @@map("orthodontic_phases")
}

model OrthoPaymentPlan {
