// ─── Modelos Fase 1 rediseño patient-detail (mayo 2026) ─────────────────────
//
// Estos 8 modelos extienden la pantalla de Ortodoncia patient-detail con
// G1 Treatment Card visual, G3 wire sequencing, G10 TADs, G16 patient flow.
// Coexisten con OrthodonticControlAppointment (legacy snapshot) y los planes
// existentes — son aditivos.

model OrthoWireStep {
  id              String @id @default(uuid())
  treatmentPlanId String
  clinicId        String

  orderIndex    Int
  phaseKey      OrthoPhaseKey
  material      OrthoWireMaterial
  shape         OrthoWireShape
  /// Calibre como string libre: "0.014", "0.018", "16x22", "19x25" — combina
  /// round (0.014/0.016/0.018) y rect (16x22, 19x25) bajo un formato único.
  gauge         String
  /// "Alineación inicial", "Trabajo sagital", etc. Texto libre acotado.
  purpose       String?
  archUpper     Boolean           @default(true)
  archLower     Boolean           @default(true)
  durationWeeks Int
  /// Auxiliares aplicados al instalar este wire: stops, open coil, lazo cinch.
  auxiliaries   String[]
  notes         String?

  status        OrthoWireStepStatus @default(PLANNED)
  plannedDate   DateTime?
  appliedDate   DateTime?
  completedDate DateTime?

  treatmentPlan OrthodonticTreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  clinic        Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  cardsFromHere OrthoTreatmentCard[] @relation("OrthoCardWireFrom")
  cardsToHere   OrthoTreatmentCard[] @relation("OrthoCardWireTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Patient   Patient? @relation(fields: [patientId], references: [id])
  patientId String?

  @@unique([treatmentPlanId, orderIndex])
  @@index([treatmentPlanId, status])
  @@index([clinicId, status])
  @@map("ortho_wire_steps")
}

model OrthoTreatmentCard {
  id              String @id @default(uuid())
  treatmentPlanId String
  patientId       String
  clinicId        String

  /// FK opcional al ControlAppointment legacy. Si está poblado, ambos
  /// representan el mismo evento — la card es la versión rica con SOAP.
  controlAppointmentId String?                        @unique
  controlAppointment   OrthodonticControlAppointment? @relation("OrthoCardControl", fields: [controlAppointmentId], references: [id], onDelete: SetNull)

  cardNumber  Int
  visitDate   DateTime
  durationMin Int           @default(30)
  phaseKey    OrthoPhaseKey
  monthAt     Decimal       @db.Decimal(4, 1)

  /// Wire del que viene y al que pasa. Nullables para citas sin cambio de wire.
  wireFromId String?
  wireFrom   OrthoWireStep? @relation("OrthoCardWireFrom", fields: [wireFromId], references: [id], onDelete: SetNull)
  wireToId   String?
  wireTo     OrthoWireStep? @relation("OrthoCardWireTo", fields: [wireToId], references: [id], onDelete: SetNull)

  /// SOAP estructurado. Todos required (no vacíos) al firmar (status SIGNED).
  soapS String @default("")
  soapO String @default("")
  soapA String @default("")
  soapP String @default("")

  /// Higiene snapshot al inicio de la cita.
  hygienePlaquePct  Int?
  hygieneGingivitis OrthoGingivitisLevel?
  hygieneWhiteSpots Boolean               @default(false)

  hasProgressPhoto Boolean @default(false)
  /// FK opcional al photo set capturado durante esta cita (no enforced FK
  /// para no acoplar — un set puede preceder o seguir a la card).
  photoSetId       String?

  /// Próxima cita programada al cerrar la card.
  nextDate        DateTime?
  nextDurationMin Int?

  status     OrthoCardStatus @default(DRAFT)
  signedAt   DateTime?
  signedById String?
  signedBy   User?           @relation("OrthoCardSignedBy", fields: [signedById], references: [id], onDelete: SetNull)

  treatmentPlan OrthodonticTreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  patient       Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic        Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  elastics       OrthoCardElastic[]
  iprPoints      OrthoCardIprPoint[]
  brokenBrackets OrthoCardBrokenBracket[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([treatmentPlanId, cardNumber])
  @@index([clinicId, visitDate(sort: Desc)])
  @@index([patientId, visitDate(sort: Desc)])
  @@map("ortho_treatment_cards")
}

model OrthoCardElastic {
  id       String @id @default(uuid())
  cardId   String
  clinicId String

  elasticClass OrthoElasticClass
  /// Configuración legible: '1/4" 6oz', '3/16" 4.5oz', '5/16" 3.5oz'.
  config       String
  zone         OrthoElasticZone

  card   OrthoTreatmentCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  clinic Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  Patient   Patient? @relation(fields: [patientId], references: [id])
  patientId String?

  @@index([cardId])
  @@map("ortho_card_elastics")
}

model OrthoCardIprPoint {
  id       String @id @default(uuid())
  cardId   String
  clinicId String

  toothA   Int
  toothB   Int
  amountMm Decimal @db.Decimal(3, 1)
  done     Boolean @default(true)

  card   OrthoTreatmentCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  clinic Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  Patient   Patient? @relation(fields: [patientId], references: [id])
  patientId String?

  @@index([cardId])
  @@map("ortho_card_ipr_points")
}

model OrthoCardBrokenBracket {
  id       String @id @default(uuid())
  cardId   String
  clinicId String

  toothFdi     Int
  brokenDate   DateTime
  reBondedDate DateTime?
  notes        String?

  card   OrthoTreatmentCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  clinic Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  Patient   Patient? @relation(fields: [patientId], references: [id])
  patientId String?

  @@index([cardId])
  @@map("ortho_card_broken_brackets")
}

model OrthoTAD {
  id              String @id @default(uuid())
  treatmentPlanId String
  patientId       String
  clinicId        String

  brand      OrthoTadBrand
  /// Tamaño legible: "1.4×6mm", "1.4×8mm", "2×10mm".
  size       String
  /// Texto libre: "vestibular sup. der entre 14 y 15".
  location   String
  torqueNcm  Int?
  placedDate DateTime
  placedById String?
  placedBy   User?         @relation("OrthoTadPlacedBy", fields: [placedById], references: [id], onDelete: SetNull)

  failed        Boolean   @default(false)
  failedDate    DateTime?
  failureReason String?

  treatmentPlan OrthodonticTreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  patient       Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic        Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([treatmentPlanId, failed])
  @@index([clinicId, placedDate(sort: Desc)])
  @@map("ortho_tads")
}

model OrthoAuxMechanics {
  id              String @id @default(uuid())
  treatmentPlanId String @unique
  clinicId        String

  expanderType        OrthoExpanderType?
  expanderActivations Int?
  expanderInstalledAt DateTime?
  expanderRemovedAt   DateTime?

  distalizerType        OrthoDistalizerType?
  distalizerInstalledAt DateTime?
  distalizerRemovedAt   DateTime?

  notes String?

  treatmentPlan OrthodonticTreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  clinic        Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Patient   Patient? @relation(fields: [patientId], references: [id])
  patientId String?

  @@map("ortho_aux_mechanics")
}

model OrthoPhaseTransition {
  id              String @id @default(uuid())
  treatmentPlanId String
  clinicId        String

  fromPhase       OrthoPhaseKey
  toPhase         OrthoPhaseKey
  /// Lista de claves de criterios clínicos confirmados al avanzar.
  criteriaChecked String[]
  doctorNotes     String?
  signedById      String
  signedBy        User          @relation("OrthoPhaseTransitionSignedBy", fields: [signedById], references: [id])
  signedAt        DateTime      @default(now())
  /// True si el usuario admin/titular forzó override del checklist.
  isOverride      Boolean       @default(false)
  overrideReason  String?

  treatmentPlan OrthodonticTreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  clinic        Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  Patient   Patient? @relation(fields: [patientId], references: [id])
  patientId String?

  @@index([treatmentPlanId, signedAt(sort: Desc)])
  @@index([clinicId, signedAt(sort: Desc)])
  @@map("ortho_phase_transitions")
}

// ─── Modelos Fase 1.5 rediseño completo (mayo 2026) ─────────────────────────
//
// Cubre las secciones F (G5 Open Choice + G6 Sign@Home), G (retención G9),
// H (NPS G11) y referidos G12 placeholder.

enum OrthoQuoteScenarioStatus {
  DRAFT
  PRESENTED
  ACCEPTED
  REJECTED
}

enum OrthoQuoteScenarioPaymentMode {
  CONTADO
  ENGANCHE_MENSUALIDADES
  ENGANCHE_MSI
}

enum OrthoSignAtHomeStatus {
  PENDING
  SENT
  SIGNED
  PAID
  EXPIRED
  REVOKED
}

enum OrthoRetainerType {
  HAWLEY_SUP
  HAWLEY_INF
  ESSIX_SUP
  ESSIX_INF
  FIXED_LINGUAL_3_3
  NONE
}

enum OrthoRetainerArchwireGauge {
  G_0175
  G_0195
  G_021
}

enum OrthoRetainerCheckupStatus {
  PROGRAMMED
  COMPLETED
  MISSED
  CANCELLED
}

enum OrthoNpsType {
  POST_DEBOND_3D
  POST_DEBOND_6M
  POST_DEBOND_12M
}

enum OrthoNpsStatus {
  SCHEDULED
  SENT
  RESPONDED
  EXPIRED
  CANCELLED
}

model OrthoQuoteScenario {
  id              String @id @default(uuid())
  treatmentPlanId String
  clinicId        String

  label         String
  paymentMode   OrthoQuoteScenarioPaymentMode
  downPayment   Decimal                       @db.Decimal(10, 2)
  monthlyAmount Decimal                       @default(0) @db.Decimal(10, 2)
  monthsCount   Int                           @default(0)
  totalAmount   Decimal                       @db.Decimal(10, 2)
  discountPct   Int?
  /// Etiqueta visual: "Recomendado", "MSI 6 meses", "10% descuento", etc.
  badge         String?
  /// Lista de líneas que se imprimen como features del escenario.
  includes      String[]                      @default([])
  notes         String?
  status        OrthoQuoteScenarioStatus      @default(DRAFT)
  presentedAt   DateTime?
  acceptedAt    DateTime?
  rejectedAt    DateTime?

  createdById String?
  createdBy   User?   @relation("OrthoQuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  treatmentPlan OrthodonticTreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  clinic        Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([treatmentPlanId, status])
  @@index([clinicId, status])
  @@map("ortho_quote_scenarios")
}

model OrthoSignAtHomePackage {
  id              String @id @default(uuid())
  treatmentPlanId String
  patientId       String
  clinicId        String

  /// Token base64url 256 bits para el portal /share/p/sgnh_<id>.
  token     String                @unique
  expiresAt DateTime
  status    OrthoSignAtHomeStatus @default(PENDING)

  /// IDs del escenario seleccionado y monto de enganche pre-cobrado.
  selectedQuoteScenarioId String?
  downPaymentAmount       Decimal? @db.Decimal(10, 2)

  /// IDs de los 3 documentos asociados (consents existentes).
  contractDocId String?
  consentDocIds String[]            @default([])
  paymentMethod OrthoPaymentMethod?

  sentAt   DateTime?
  signedAt DateTime?
  paidAt   DateTime?
  cfdiUuid String?

  createdById String
  createdBy   User   @relation("OrthoSignAtHomeCreatedBy", fields: [createdById], references: [id])

  treatmentPlan OrthodonticTreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  patient       Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic        Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId, status, expiresAt])
  @@index([patientId, createdAt(sort: Desc)])
  @@map("ortho_sign_at_home_packages")
}

model OrthoRetentionRegimen {
  id              String @id @default(uuid())
  treatmentPlanId String @unique
  clinicId        String

  upperRetainer       OrthoRetainerType?
  upperDescription    String?
  lowerRetainer       OrthoRetainerType?
  lowerDescription    String?
  fixedLingualPresent Boolean                     @default(false)
  fixedLingualGauge   OrthoRetainerArchwireGauge?

  /// Régimen de uso (texto editable). Default: "24/7 año 1 · nocturno años 2-5".
  regimenDescription String  @default("24/7 año 1 · nocturno años 2-5")
  preSurveyEnabled   Boolean @default(true)

  /// Fecha de debonding (aplica al avanzar fase a Retención).
  debondedAt DateTime?

  treatmentPlan OrthodonticTreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  clinic        Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  checkups      OrthoRetainerCheckup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ortho_retention_regimens")
}

model OrthoRetainerCheckup {
  id        String @id @default(uuid())
  regimenId String
  clinicId  String

  /// Mes desde el debonding: 3, 6, 12, 24, 36.
  monthsFromDebond Int
  scheduledDate    DateTime
  performedAt      DateTime?
  status           OrthoRetainerCheckupStatus @default(PROGRAMMED)
  notes            String?

  regimen OrthoRetentionRegimen @relation(fields: [regimenId], references: [id], onDelete: Cascade)
  clinic  Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([regimenId, monthsFromDebond])
  @@index([clinicId, scheduledDate, status])
  @@map("ortho_retainer_checkups")
}

model OrthoNpsSchedule {
  id              String @id @default(uuid())
  treatmentPlanId String
  patientId       String
  clinicId        String

  npsType               OrthoNpsType
  scheduledAt           DateTime
  status                OrthoNpsStatus @default(SCHEDULED)
  sentAt                DateTime?
  respondedAt           DateTime?
  /// Score 0-10. Cuando >=9 dispara trigger Google review.
  npsScore              Int?
  patientComment        String?
  /// True cuando se disparó automáticamente la solicitud de Google review.
  googleReviewTriggered Boolean        @default(false)

  treatmentPlan OrthodonticTreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  patient       Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic        Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([treatmentPlanId, npsType])
  @@index([clinicId, status, scheduledAt])
  @@map("ortho_nps_schedules")
}

model OrthoReferralCode {
  id              String @id @default(uuid())
  treatmentPlanId String @unique
  patientId       String
  clinicId        String

  /// Código personalizado del paciente (ej. "GABY26"). Único por clínica.
  code          String
  referralCount Int     @default(0)
  /// Premio o descuento configurado (texto libre).
  rewardLabel   String?

  treatmentPlan OrthodonticTreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  patient       Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic        Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, code])
  @@index([clinicId, referralCount(sort: Desc)])
  @@map("ortho_referral_codes")
}

// ─── PatientFlow (cross-cutting clinical-shared) — G16 ──────────────────────
//
// Estado del paciente cuando está hoy en clínica: WAITING → IN_CHAIR →
// CHECKOUT → COMPLETED. Vive en clinical-shared porque todas las especialidades
// muestran el badge "En clínica" en su sidebar derecha.

model PatientFlow {
  id        String @id @default(uuid())
  clinicId  String
  patientId String

  status        PatientFlowStatus
  /// Sillón asignado, libre: "Sillón 2".
  chair         String?
  /// Cita relacionada (opcional — el flow puede activarse sin cita formal).
  appointmentId String?

  enteredAt     DateTime  @default(now())
  exitedAt      DateTime?
  triggeredById String?
  triggeredBy   User?     @relation("PatientFlowTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  notes String?

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId, status, exitedAt])
  @@index([patientId, enteredAt(sort: Desc)])
  @@map("patient_flow_entries")
}

// ─── Modelos v1.1 (6, documentados sin lógica) ───────────────────────────────
//
// SPEC §4.3 + §14: estos 6 modelos se planean para v1.1 y NO se implementan
// en MVP. Quedan documentados aquí como TODO para que el bot de v1.1 los
// agregue sin redefinir el contrato.
//
// TODO v1.1: OrthodonticCephalometryAnalysis — captura numérica de valores
//   Steiner/Ricketts/Jarabak (~30 campos: SNA, SNB, ANB, FMA, IMPA, planos,
//   dimensiones faciales). Vinculado 1:1 con un PatientFile category=
