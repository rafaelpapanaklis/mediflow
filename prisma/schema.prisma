// ════════════════════════════════════════════════════════════════════════
// Laboratorios Dentales — marketplace B2B de laboratorios (espejo de Supplier).
// Prefijo DentalLab* para no chocar con el módulo de laboratorio clínico
// existente (LabOrder/LabOrderStatus = estudios de paciente).
// Contrato compartido: src/lib/laboratorios/types.ts
// ════════════════════════════════════════════════════════════════════════

enum DentalLabStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DentalLabUserRole {
  OWNER
  MANAGER
  STAFF
}

enum DentalLabOrderStatus {
  SOLICITADA
  RECIBIDA
  ATENDIENDO
  ENVIADA
  ENTREGADA
  CANCELADA
}

enum DentalLabTrafficLevel {
  LOW
  MEDIUM
  HIGH
}

enum DentalLabTrafficSource {
  MANUAL
  AUTO
}

enum DentalLabOrderActor {
  CLINIC
  LAB
  SYSTEM
}

enum DentalLabPaymentStatus {
  UNPAID
  PAID
}

enum DentalLabInvoiceStatus {
  PAID
  PENDING
  OVERDUE
}

enum DentalLabChatSender {
  CLINIC
  LAB
}

model DentalLab {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  rfc            String?         @db.VarChar(13)
  email          String
  phone          String?
  whatsapp       String?
  website        String?
  address        String?
  mapsUrl        String?
  city           String?
  state          String?
  logoUrl        String?
  coverImageUrl  String?
  description    String?         @db.Text
  founded        Int?
  services       String[]        @default([])
  hours          Json?
  coverageZones  String[]        @default([])
  rating         Float?          @default(0)
  ratingCount    Int             @default(0)
  onTimePct      Int?
  totalOrders    Int             @default(0)
  status         DentalLabStatus @default(PENDING)
  approvedAt     DateTime?
  rejectedReason String?

  trafficLevel     DentalLabTrafficLevel @default(LOW)
  trafficManualMin Int?
  trafficManualMax Int?
  trafficNote      String?
  trafficUpdatedAt DateTime              @default(now())

  paySpeiEnabled         Boolean @default(false)
  payCardEnabled         Boolean @default(false)
  payCardStripeConnected Boolean @default(false)
  payCashEnabled         Boolean @default(false)
  payInvoiceEnabled      Boolean @default(false)
  payMercadoPagoEnabled  Boolean @default(false)
  mpAccessToken          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          DentalLabUser[]
  labServices    DentalLabService[]
  orders         DentalLabOrder[]
  chats          DentalLabChatThread[]
  trafficHistory DentalLabTrafficHistory[]
  bankAccounts   DentalLabBankAccount[]
  fiscalData     DentalLabFiscalData?
  invoices       DentalLabInvoice[]

  @@index([status])
  @@map("dental_labs")
}

model DentalLabUser {
  id         String            @id @default(cuid())
  labId      String
  supabaseId String
  email      String
  firstName  String
  lastName   String
  role       DentalLabUserRole @default(OWNER)
  isActive   Boolean           @default(true)
  lastLogin  DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

